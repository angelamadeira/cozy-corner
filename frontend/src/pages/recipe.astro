  <script>
    // Dark toggle (recipe.astro tem o seu próprio dentro do overlay)
    document.getElementById('cs-dark-toggle')?.addEventListener('click', () => {
      document.body.classList.toggle('dark-mode');
      try {
        localStorage.setItem('cozy-dark-mode',
          document.body.classList.contains('dark-mode') ? 'true' : 'false');
      } catch (e) {}
    });

    // Close button — volta pra home com fade transition se disponível
    document.getElementById('cs-close-btn')?.addEventListener('click', () => {
      if (window.cozyNavigate) window.cozyNavigate('/');
      else window.location.href = '/';
    });

    // Lang toggle dentro do overlay — proxy pro BaseLayout (que mantém o estado real)
    (function initCsLangToggle() {
      const csBtn = document.getElementById('cs-lang-toggle');
      if (!csBtn) return;

      function syncVisual() {
        const lang = window.__COZY_LANG === 'en' ? 'en' : 'pt';
        csBtn.classList.toggle('is-en', lang === 'en');
      }

      csBtn.addEventListener('click', () => {
        const baseBtn = document.getElementById('lang-toggle');
        if (baseBtn) baseBtn.click();
        // Sync imediato (caso o evento custom demore)
        setTimeout(syncVisual, 0);
      });

      // Mantém visual sincronizado quando lang muda em qualquer lugar
      document.addEventListener('cozy-lang-changed', syncVisual);

      // Estado inicial (depois do BaseLayout init)
      setTimeout(syncVisual, 0);
    })();

    // Detecta screenshots que ainda não foram adicionadas e esconde o <img>
    // pra deixar só o placeholder visível.
    document.querySelectorAll('.cs-screenshot-frame img').forEach(function (img) {
      function markFailed() { img.classList.add('failed'); }
      if (img.complete && img.naturalWidth === 0) markFailed();
      img.addEventListener('error', markFailed);
    });

    // Overlay sempre aberto — a tela do overlay é o /recipe inteiro.
    // Não tem botão close; conteúdo "atrás" foi migrado pra dentro dos passos.
    (function showOverlay() {
      const overlay = document.getElementById('cs-overlay');
      if (!overlay) return;
      overlay.removeAttribute('hidden');
      document.body.style.overflow = 'hidden';
      document.body.classList.add('cs-overlay-open');
    })();

    // Sequential tabs — 6 passos (Ingredientes + 4 deep dives + Fim) com prev/próximo no rodapé
    (function initSeqTabs() {
      const TAB_IDS = ['inicio', 'design-system', 'ilustracao', 'traducoes', 'admin', 'fim'];
      const tabs = document.querySelectorAll('.seqtab');
      const panels = document.querySelectorAll('.seqtab-panel');
      const prevBtn = document.getElementById('seqtabs-prev');
      const nextBtn = document.getElementById('seqtabs-next');
      const prevTargetEl = document.getElementById('seqtabs-prev-target');
      const nextTargetEl = document.getElementById('seqtabs-next-target');
      const navEl = document.querySelector('.seqtabs-nav');
      const selectEl = document.getElementById('seqtabs-select');
      if (!tabs.length || !panels.length) return;

      // Popula o dropdown mobile com 9 options bilíngues
      function buildSelectOptions() {
        if (!selectEl) return;
        const lang = window.__COZY_LANG === 'en' ? 'en' : 'pt';
        const currentValue = selectEl.value;
        selectEl.innerHTML = '';
        TAB_IDS.forEach(function (id, idx) {
          const tab = document.querySelector('.seqtab[data-tab="' + id + '"]');
          const lbl = tab ? tab.querySelector('.seqtab-label') : null;
          const ptEl = lbl ? lbl.querySelector('[data-lang="pt"]') : null;
          const enEl = lbl ? lbl.querySelector('[data-lang="en"]') : null;
          const text = lang === 'en' ? (enEl ? enEl.textContent : '') : (ptEl ? ptEl.textContent : '');
          const opt = document.createElement('option');
          opt.value = id;
          opt.textContent = (idx + 1) + ' · ' + text.trim();
          selectEl.appendChild(opt);
        });
        // Restaura valor (ou primeiro)
        const active = document.querySelector('.seqtab.is-active');
        selectEl.value = (active && active.dataset.tab) || currentValue || TAB_IDS[0];
      }

      buildSelectOptions();
      document.addEventListener('cozy-lang-changed', buildSelectOptions);

      if (selectEl) {
        selectEl.addEventListener('change', function (e) {
          activateTab(e.target.value, true);
        });
      }

      function getTabLabels(id) {
        const tab = document.querySelector('.seqtab[data-tab="' + id + '"]');
        if (!tab) return { pt: '', en: '' };
        const lbl = tab.querySelector('.seqtab-label');
        if (!lbl) return { pt: '', en: '' };
        const ptEl = lbl.querySelector('[data-lang="pt"]');
        const enEl = lbl.querySelector('[data-lang="en"]');
        return {
          pt: (ptEl ? ptEl.textContent : '').trim(),
          en: (enEl ? enEl.textContent : '').trim(),
        };
      }
      function setTargetLabel(el, labels) {
        if (!el) return;
        const ptEl = el.querySelector('[data-lang="pt"]');
        const enEl = el.querySelector('[data-lang="en"]');
        if (ptEl) ptEl.textContent = labels.pt;
        if (enEl) enEl.textContent = labels.en;
      }
      const LABEL_EXIT = { pt: 'voltar pra cozinha', en: 'back to the kitchen' };

      function activateTab(id, scrollToTop) {
        tabs.forEach(function (t) { t.classList.toggle('is-active', t.dataset.tab === id); });
        panels.forEach(function (p) { p.classList.toggle('is-active', p.dataset.panel === id); });

        // Sincroniza o dropdown mobile
        if (selectEl && selectEl.value !== id) selectEl.value = id;

        const activeTab = document.querySelector('.seqtab[data-tab="' + id + '"]');
        if (activeTab && activeTab.scrollIntoView) {
          activeTab.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
        }

        const idx = TAB_IDS.indexOf(id);

        // Atualiza estados e labels prev/próximo. Nos extremos vira "voltar pra cozinha".
        if (prevBtn) {
          prevBtn.disabled = false;
          prevBtn.dataset.exit = idx <= 0 ? 'true' : 'false';
          setTargetLabel(prevTargetEl, idx <= 0 ? LABEL_EXIT : getTabLabels(TAB_IDS[idx - 1]));
        }
        if (nextBtn) {
          nextBtn.disabled = false;
          nextBtn.dataset.exit = idx >= TAB_IDS.length - 1 ? 'true' : 'false';
          setTargetLabel(nextTargetEl, idx >= TAB_IDS.length - 1 ? LABEL_EXIT : getTabLabels(TAB_IDS[idx + 1]));
        }

        try { history.replaceState(null, '', '#' + id); } catch (e) {}

        // Scrolla o container de panels (não a janela) pro topo
        if (scrollToTop) {
          const panelsEl = document.querySelector('.seqtabs-panels');
          if (panelsEl) panelsEl.scrollTo({ top: 0, behavior: 'smooth' });
        }
      }

      tabs.forEach(function (t) {
        t.addEventListener('click', function () { activateTab(t.dataset.tab, true); });
      });

      function goHome() {
        // Usa cozyNavigate (fade transition) se disponível, senão fallback direto
        if (window.cozyNavigate) window.cozyNavigate('/');
        else window.location.href = '/';
      }

      if (prevBtn) prevBtn.addEventListener('click', function () {
        const current = document.querySelector('.seqtab.is-active');
        if (!current) return;
        const idx = TAB_IDS.indexOf(current.dataset.tab);
        if (idx <= 0) goHome();
        else activateTab(TAB_IDS[idx - 1], true);
      });

      if (nextBtn) nextBtn.addEventListener('click', function () {
        const current = document.querySelector('.seqtab.is-active');
        if (!current) return;
        const idx = TAB_IDS.indexOf(current.dataset.tab);
        if (idx >= TAB_IDS.length - 1) goHome();
        else activateTab(TAB_IDS[idx + 1], true);
      });

      // Keyboard nav (← →) — só responde quando o foco não está num input.
      // Nos extremos (Step 1 ← / Step 9 →), navega pra home.
      document.addEventListener('keydown', function (e) {
        if (document.activeElement && /input|textarea|select/i.test(document.activeElement.tagName)) return;
        const current = document.querySelector('.seqtab.is-active');
        if (!current) return;
        const idx = TAB_IDS.indexOf(current.dataset.tab);
        if (e.key === 'ArrowRight') {
          if (idx < TAB_IDS.length - 1) activateTab(TAB_IDS[idx + 1], false);
          else goHome();
        } else if (e.key === 'ArrowLeft') {
          if (idx > 0) activateTab(TAB_IDS[idx - 1], false);
          else goHome();
        }
      });

      // Estado inicial: deep-link via hash, ou default = primeira tab
      const initialId = window.location.hash.slice(1);
      if (TAB_IDS.indexOf(initialId) >= 0) {
        activateTab(initialId, false);
      } else {
        activateTab(TAB_IDS[0], false);
      }
    })();
  </script>
</BaseLayout>
