---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';

// Hotspots: bounding box (em % do SVG 998×801) + ação
// Coordenadas extraídas direto do Group 8.svg da Gigi
const hotspots = [
  { id: 'vegetarianas', label: 'vegetarianas',         action: 'cat',    key: 'vegetarianas', x: 80.3, y: 0,    w: 16.2, h: 29.3 },
  { id: 'rapidas',      label: 'receitas rápidas',     action: 'cat',    key: 'rapidas',      x: 47.0, y: 10.4, w: 11.8, h: 14.7 },
  { id: 'sobre',        label: 'sobre mim',            action: 'sobre',  key: '',             x: 20.9, y: 41.1, w: 10.2, h: 14.2 },
  { id: 'dark',         label: 'dark mode',            action: 'dark',   key: '',             x: 0.2,  y: 51.6, w: 5.3,  h: 8.4 },
  { id: 'todas',        label: 'todas as receitas',    action: 'cat',    key: 'todas',        x: 37.5, y: 50.9, w: 10.9, h: 4.5 },
  { id: 'congelar',     label: 'para congelar',        action: 'cat',    key: 'congelar',     x: 65.3, y: 29.3, w: 29.5, h: 18.0 },
  { id: 'datas',        label: 'datas comemorativas',  action: 'cat',    key: 'datas',        x: 70.5, y: 54.5, w: 9.3,  h: 11.2 },
  { id: 'recado',       label: 'deixe seu recado',     action: 'recado', key: '',             x: 84.0, y: 50.5, w: 10.0, h: 12.5 },
  { id: 'akim',         label: 'akim',                 action: 'akim',   key: '',             x: 2.3,  y: 70.0, w: 15.8, h: 12.5 },
  { id: 'principais',   label: 'pratos principais',    action: 'cat',    key: 'principais',   x: 26.4, y: 73.5, w: 15.5, h: 8.4 },
  { id: 'sobremesas',   label: 'sobremesas',           action: 'cat',    key: 'sobremesas',   x: 48.5, y: 73.5, w: 9.6,  h: 8.4 },
];
---

<BaseLayout title="Cozinha (teste)" description="Teste da cena de cozinha em line-art.">
  <header class="site-header">
    <a href="/" class="logo-link" aria-label="Cozy Corner">
      <span class="logo-name">Cozy Corner</span>
      <span class="logo-by">— by Gigi</span>
    </a>
  </header>

  <main class="page">
    <p class="meta">/cozinha-teste · SVG composto + hotspots</p>
    <h1 class="title">Cozinha — teste</h1>

    <label class="mock-toggle">
      <input type="checkbox" id="hotspot-toggle" checked />
      destacar áreas clicáveis
    </label>

    <section class="kitchen" aria-label="Cena da cozinha com hotspots">
      <img class="scene" src="/kitchen/cozinha.svg" alt="" />

      {hotspots.map((h) => (
        <button
          class={`hs hs-${h.id}`}
          data-action={h.action}
          data-key={h.key}
          type="button"
          style={`left:${h.x}%; top:${h.y}%; width:${h.w}%; height:${h.h}%`}
          aria-label={h.label}
        >
          <span class="hs-label">{h.label}</span>
        </button>
      ))}
    </section>

    <p class="hint">
      <Icon name="ph:info-thin" /> passa o mouse pra ver o nome de cada área.
    </p>
  </main>

  <style>
    .site-header {
      position: fixed; top: 0; left: 0; right: 0;
      height: var(--header-h);
      padding: 0 var(--s-6);
      display: flex; align-items: center;
      z-index: 100;
      background: rgba(250, 246, 238, 0.85);
      backdrop-filter: blur(8px);
      border-bottom: 1px solid var(--line-soft);
    }
    body.dark-mode .site-header { background: rgba(15, 26, 42, 0.85); }
    .logo-link { text-decoration: none; display: flex; flex-direction: column; align-items: flex-end; line-height: 1.1; }
    .logo-name { font-family: var(--font-brand); font-weight: 600; font-size: 22px; line-height: 1; }
    .logo-by { font-family: var(--font-mono); font-size: 10px; color: var(--ink-soft); margin-top: 1px; }

    .page {
      max-width: 1400px;
      margin: 0 auto;
      padding: calc(var(--header-h) + var(--s-7)) var(--s-6) var(--s-9);
    }
    .meta { font-family: var(--font-mono); font-size: 12px; color: var(--ink-mute); }
    .title {
      font-family: var(--font-display);
      font-weight: 500;
      font-size: var(--fs-h1);
      letter-spacing: -0.02em;
      margin: 8px 0 var(--s-5);
    }
    .mock-toggle {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-family: var(--font-mono);
      font-size: var(--fs-meta);
      color: var(--ink-soft);
      margin-bottom: var(--s-4);
      cursor: pointer;
    }
    .mock-toggle input { accent-color: var(--terracota); }
    .hint {
      margin-top: var(--s-5);
      font-family: var(--font-mono);
      font-size: var(--fs-meta);
      color: var(--ink-mute);
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }
    .hint :global(svg) { fill: none; stroke: currentColor; }

    /* ============ CENA ============ */
    .kitchen {
      position: relative;
      width: 100%;
      aspect-ratio: 998 / 801;
      background: var(--bg);
      color: var(--ink);
    }
    .scene {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
    }
    body.dark-mode .scene { filter: invert(1); }

    /* ============ HOTSPOTS ============ */
    .hs {
      position: absolute;
      background: transparent;
      border: 1.5px dashed rgba(197, 107, 74, 0.45);
      border-radius: 6px;
      cursor: pointer;
      transition: background var(--dur-fast), border-color var(--dur-fast), transform var(--dur-fast);
      z-index: 2;
      padding: 0;
    }
    body.hotspots-hidden .hs {
      border-color: transparent;
    }
    .hs:hover {
      background: rgba(197, 107, 74, 0.12);
      border-color: var(--terracota);
      border-style: solid;
      transform: scale(1.02);
    }
    .hs-label {
      position: absolute;
      left: 50%;
      bottom: calc(100% + 6px);
      transform: translate(-50%, 4px);
      font-family: var(--font-mono);
      font-size: 11px;
      color: var(--bg);
      background: var(--ink);
      padding: 3px 8px;
      border-radius: 4px;
      white-space: nowrap;
      opacity: 0;
      transition: opacity var(--dur-fast), transform var(--dur-fast);
      pointer-events: none;
    }
    .hs:hover .hs-label {
      opacity: 1;
      transform: translate(-50%, 0);
    }
  </style>

  <script>
    // Dark toggle pelo interruptor (hotspot 'dark')
    document.querySelector('.hs-dark')?.addEventListener('click', (e) => {
      e.preventDefault();
      document.body.classList.toggle('dark-mode');
      try {
        localStorage.setItem('cozy-dark-mode',
          document.body.classList.contains('dark-mode') ? 'true' : 'false');
      } catch (err) {}
    });

    // Toggle visibilidade das bordas dos hotspots
    document.getElementById('hotspot-toggle')?.addEventListener('change', (e) => {
      const target = e.target as HTMLInputElement;
      document.body.classList.toggle('hotspots-hidden', !target.checked);
    });
  </script>
</BaseLayout>
