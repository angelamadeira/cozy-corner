---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';
---

<BaseLayout title="Cozinha (teste)" description="Teste da cena de cozinha em line-art.">
  <header class="site-header">
    <a href="/" class="logo-link" aria-label="Cozy Corner">
      <span class="logo-name">Cozy Corner</span>
      <span class="logo-by">— by Gigi</span>
    </a>
  </header>

  <main class="page">
    <p class="meta">/cozinha-teste · SVG inline com hotspots no formato real</p>
    <h1 class="title">Cozinha — teste</h1>

    <label class="mock-toggle">
      <input type="checkbox" id="hotspot-toggle" />
      destacar áreas clicáveis (debug)
    </label>

    <section class="kitchen" aria-label="Cena da cozinha">
      <svg class="scene" viewBox="0 0 998 801" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Cozinha com elementos clicáveis">
        <!-- Bancada (não-clicável) -->
        <rect x="63.5" y="656.868" width="932" height="240" stroke="currentColor" stroke-width="5"/>
        <!-- Divisor da geladeira (não-clicável) -->
        <path d="M650 382.368L949 382.368" stroke="currentColor" stroke-width="5"/>
        <!-- Linha da bancada do meio (não-clicável) -->
        <path d="M161 444.368H542" stroke="currentColor" stroke-width="5"/>

        <!-- ============ HOTSPOTS ============ -->

        <!-- Para congelar (fridge top) -->
        <g class="hs" data-action="cat" data-key="congelar" role="button" aria-label="Para congelar" data-label="para congelar" tabindex="0">
          <rect x="652.5" y="235.868" width="294" height="144" stroke="currentColor" stroke-width="5"/>
        </g>

        <!-- Geladeira (parte inferior) — só visual, não-clicável -->
        <rect x="652.5" y="379.868" width="294" height="277" stroke="currentColor" stroke-width="5"/>

        <!-- Pratos principais -->
        <g class="hs" data-action="cat" data-key="principais" role="button" aria-label="Pratos principais" data-label="pratos principais" tabindex="0">
          <rect x="263.5" y="589.868" width="155" height="67" stroke="currentColor" stroke-width="5"/>
        </g>

        <!-- Sobremesas -->
        <g class="hs" data-action="cat" data-key="sobremesas" role="button" aria-label="Sobremesas" data-label="sobremesas" tabindex="0">
          <rect x="484.5" y="589.868" width="96" height="67" stroke="currentColor" stroke-width="5"/>
        </g>

        <!-- Receitas rápidas (relógio) -->
        <g class="hs" data-action="cat" data-key="rapidas" role="button" aria-label="Receitas rápidas" data-label="receitas rápidas" tabindex="0">
          <circle cx="528" cy="142.368" r="58.5" stroke="currentColor" stroke-width="5"/>
          <path d="M528 103.368V143.893L550 165.368" stroke="currentColor" stroke-width="5"/>
        </g>

        <!-- Vegetarianas (vaso com planta) -->
        <g class="hs" data-action="cat" data-key="vegetarianas" role="button" aria-label="Vegetarianas" data-label="vegetarianas" tabindex="0">
          <rect x="816.5" y="168.868" width="95" height="67" stroke="currentColor" stroke-width="5"/>
          <path d="M801.5 88.8679L840.5 167.868H874V155.868H963L884 120.868L909 65.8679L856.5 107.868L840.5 0.36792V107.868L801.5 88.8679Z" stroke="currentColor" stroke-width="5"/>
        </g>

        <!-- Datas comemorativas (calendário) -->
        <g class="hs" data-action="cat" data-key="datas" role="button" aria-label="Datas comemorativas" data-label="datas comemorativas" tabindex="0">
          <rect x="704.5" y="437.868" width="93" height="90" stroke="currentColor" stroke-width="5"/>
          <rect x="717.5" y="467.868" width="15" height="13" stroke="currentColor" stroke-width="5"/>
          <rect x="717.5" y="492.868" width="15" height="13" stroke="currentColor" stroke-width="5"/>
          <rect x="743.5" y="467.868" width="15" height="13" stroke="currentColor" stroke-width="5"/>
          <rect x="743.5" y="492.868" width="15" height="13" stroke="currentColor" stroke-width="5"/>
          <rect x="769.5" y="467.868" width="15" height="13" stroke="currentColor" stroke-width="5"/>
          <rect x="769.5" y="492.868" width="15" height="13" stroke="currentColor" stroke-width="5"/>
        </g>

        <!-- Deixe seu recado (post-it rotacionado) -->
        <g class="hs" data-action="recado" role="button" aria-label="Deixe seu recado" data-label="deixe seu recado" tabindex="0">
          <rect x="869.943" y="423.873" width="54.5792" height="52.7554" transform="rotate(37.465 869.943 423.873)" stroke="currentColor" stroke-width="5"/>
        </g>

        <!-- Sobre mim (quadro) -->
        <g class="hs" data-action="sobre" role="button" aria-label="Sobre mim" data-label="sobre mim" tabindex="0">
          <rect x="209.5" y="329.868" width="102" height="114" stroke="currentColor" stroke-width="5"/>
          <rect x="218.5" y="339.868" width="84" height="94" stroke="currentColor" stroke-width="5"/>
        </g>

        <!-- Todas as receitas (livros) -->
        <g class="hs" data-action="cat" data-key="todas" role="button" aria-label="Todas as receitas" data-label="todas as receitas" tabindex="0">
          <rect x="375.5" y="426.868" width="109" height="17" stroke="currentColor" stroke-width="5"/>
          <rect x="375.5" y="408.868" width="109" height="18" stroke="currentColor" stroke-width="5"/>
        </g>

        <!-- Dark mode (interruptor) -->
        <g class="hs" data-action="dark" role="button" aria-label="Dark mode (liga/desliga)" data-label="dark mode" tabindex="0">
          <rect x="2.5" y="413.868" width="53" height="67" stroke="currentColor" stroke-width="5"/>
          <rect x="18.5" y="433.868" width="20" height="26" stroke="currentColor" stroke-width="5"/>
        </g>

        <!-- Akim (gato) -->
        <g class="hs" data-action="akim" role="button" aria-label="Akim" tabindex="0">
          <path d="M77.9648 582.471C84.1218 587.599 88 595.06 88 603.368C88 604.737 87.892 606.083 87.6885 607.4C96.97 604.841 107.857 603.368 119.5 603.368C153.466 603.368 181 615.904 181 631.368C181 646.832 153.466 659.368 119.5 659.368C85.5345 659.368 58 646.832 58 631.368C41.4315 631.368 28 618.832 28 603.368C28 600.619 28.4257 597.963 29.2168 595.453L28.6846 595.961L23.0684 572.739L43.6201 578.789C47.8898 576.608 52.7897 575.368 58 575.368C58.3399 575.368 58.6785 575.374 59.0156 575.385L72.4629 561.938L77.9648 582.471ZM119.5 608.368C106.969 608.368 95.483 610.139 86.1494 613.066C82.4813 622.337 73.7073 629.298 63.0107 630.976C63.0038 631.108 63 631.238 63 631.368C63 635.938 67.295 641.703 78.085 646.616C88.4264 651.324 103.064 654.368 119.5 654.368C135.936 654.368 150.574 651.324 160.915 646.616C171.705 641.703 176 635.938 176 631.368C176 626.798 171.705 621.032 160.915 616.12C150.574 611.412 135.936 608.368 119.5 608.368ZM58 580.368C43.8624 580.368 33 590.985 33 603.368C33 615.751 43.8624 626.368 58 626.368C58.3306 626.368 58.6594 626.36 58.9863 626.348C61.7696 619.348 70.2692 613.254 82.2051 609.103C82.7236 607.26 83 605.336 83 603.368C83 590.985 72.1376 580.368 58 580.368ZM79.1152 615.662C78.7672 615.813 78.4239 615.966 78.085 616.12C71.6432 619.053 67.5173 622.29 65.2373 625.395C71.0915 623.776 75.9634 620.244 79.1152 615.662ZM31.5088 586.368L36.2676 581.837L29.9639 579.982L31.5088 586.368ZM65.2725 576.198C66.3213 576.442 67.3487 576.735 68.3506 577.079L71.5762 577.944L69.875 571.597L65.2725 576.198Z" fill="currentColor"/>
        </g>
      </svg>
    </section>

    <p class="hint">
      <Icon name="ph:info-thin" /> hover destaca o elemento; clique segue pra categoria, dark mode, ou abre um drawer.
    </p>
  </main>

  <!-- ============ DRAWERS ============ -->
  <div class="drawer-backdrop" id="drawer-backdrop"></div>

  <!-- Sobre mim -->
  <aside class="drawer" id="drawer-sobre" aria-hidden="true" aria-labelledby="sobre-title">
    <button class="drawer-close" data-close-drawer type="button" aria-label="fechar">
      <Icon name="ph:x-thin" width={20} height={20} />
    </button>
    <h2 id="sobre-title" class="drawer-title">Oi, sou a Gigi</h2>
    <p class="drawer-body">
      Cozinhar é meu jeito de juntar gente. Esse cantinho é onde eu vou guardando
      o que aprendi — receitas autorais, herdadas, adaptadas — pra ter sempre à
      mão e pra dividir com quem aparece.
    </p>
    <p class="drawer-body">
      Mais sobre mim, sobre o blog e sobre as cozinhas que me inspiram em breve
      por aqui. Por enquanto: fica à vontade pra bisbilhotar as gavetas. 💛
    </p>
  </aside>

  <!-- Deixe seu recado -->
  <aside class="drawer" id="drawer-recado" aria-hidden="true" aria-labelledby="recado-title">
    <button class="drawer-close" data-close-drawer type="button" aria-label="fechar">
      <Icon name="ph:x-thin" width={20} height={20} />
    </button>
    <h2 id="recado-title" class="drawer-title">Deixe um recado</h2>
    <p class="drawer-body">
      Pergunta sobre receita, sugestão, ou só pra falar oi — manda pelo canal
      que preferir.
    </p>

    <div class="recado-channels">
      <a class="channel-btn" href="https://wa.me/?text=Oi%20Gigi!" target="_blank" rel="noopener">
        <Icon name="ph:whatsapp-logo-thin" width={20} height={20} /> WhatsApp
      </a>
      <a class="channel-btn" href="mailto:angelmadeira@gmail.com">
        <Icon name="ph:envelope-thin" width={20} height={20} /> Email
      </a>
    </div>
  </aside>

  <div class="kitchen-tooltip" id="kitchen-tooltip" role="tooltip"></div>
  <div class="test-toast" id="test-toast" role="status" aria-live="polite"></div>

  <style>
    .site-header {
      position: fixed; top: 0; left: 0; right: 0;
      height: var(--header-h);
      padding: 0 var(--s-6);
      display: flex; align-items: center;
      z-index: 100;
      background: rgba(250, 246, 238, 0.85);
      backdrop-filter: blur(8px);
      border-bottom: 1px solid var(--line-soft);
    }
    body.dark-mode .site-header { background: rgba(15, 26, 42, 0.85); }
    .logo-link { text-decoration: none; display: flex; flex-direction: column; align-items: flex-end; line-height: 1.1; }
    .logo-name { font-family: var(--font-brand); font-weight: 600; font-size: 22px; line-height: 1; }
    .logo-by { font-family: var(--font-mono); font-size: 10px; color: var(--ink-soft); margin-top: 1px; }

    .page {
      max-width: 1400px;
      margin: 0 auto;
      padding: calc(var(--header-h) + var(--s-7)) var(--s-6) var(--s-9);
    }
    .meta { font-family: var(--font-mono); font-size: 12px; color: var(--ink-mute); }
    .title {
      font-family: var(--font-display);
      font-weight: 500;
      font-size: var(--fs-h1);
      letter-spacing: -0.02em;
      margin: 8px 0 var(--s-5);
    }
    .mock-toggle {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-family: var(--font-mono);
      font-size: var(--fs-meta);
      color: var(--ink-soft);
      margin-bottom: var(--s-4);
      cursor: pointer;
    }
    .mock-toggle input { accent-color: var(--terracota); }
    .hint {
      margin-top: var(--s-5);
      font-family: var(--font-mono);
      font-size: var(--fs-meta);
      color: var(--ink-mute);
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }
    .hint :global(svg) { fill: none; stroke: currentColor; }

    /* ============ CENA ============ */
    .kitchen {
      position: relative;
      width: 100%;
      aspect-ratio: 998 / 801;
      color: var(--ink);
    }
    .scene {
      width: 100%;
      height: 100%;
      display: block;
    }

    /* ============ HOTSPOTS ============ */
    /* bounding-box: hit-test pelo bbox do grupo (não só pelo stroke) */
    .scene :global(.hs) {
      cursor: pointer;
      pointer-events: bounding-box;
      transition: transform 200ms ease;
      transform-box: fill-box;
      transform-origin: center;
    }
    /* Debug: ressalta as áreas clicáveis com fill semi-transparente */
    body.hotspots-debug .scene :global(.hs > rect),
    body.hotspots-debug .scene :global(.hs > circle),
    body.hotspots-debug .scene :global(.hs > path) {
      fill: rgba(197, 107, 74, 0.15);
    }
    /* Hover: stroke terracota nas linhas + leve scale */
    .scene :global(.hs:hover) {
      transform: scale(1.04);
    }
    .scene :global(.hs:hover > rect),
    .scene :global(.hs:hover > circle),
    .scene :global(.hs:hover > path) {
      stroke: var(--terracota);
    }
    /* Pra path com fill (cat), muda o fill no hover */
    .scene :global(.hs:hover > path[fill="currentColor"]) {
      fill: var(--terracota);
    }
    /* Remove o focus ring padrão do browser ao clicar */
    .scene :global(.hs:focus) { outline: none; }
    /* Mas mantém indicador acessível pra navegação por teclado */
    .scene :global(.hs:focus-visible) {
      outline: 2px solid var(--terracota);
      outline-offset: 4px;
    }

    /* ============ DRAWERS ============ */
    .drawer-backdrop {
      position: fixed; inset: 0;
      background: rgba(26, 26, 26, 0.3);
      opacity: 0; visibility: hidden;
      transition: opacity var(--dur-base), visibility var(--dur-base);
      z-index: 150;
    }
    .drawer-backdrop.open { opacity: 1; visibility: visible; }

    .drawer {
      position: fixed;
      top: 0; right: 0; bottom: 0;
      width: 480px;
      max-width: 100vw;
      background: var(--bg);
      border-left: 1px solid var(--line);
      box-shadow: var(--shadow-3);
      transform: translateX(100%);
      transition: transform 0.45s var(--ease-out);
      z-index: 200;
      overflow-y: auto;
      padding: var(--s-7) var(--s-6);
    }
    .drawer.open { transform: translateX(0); }

    .drawer-close {
      position: absolute;
      top: var(--s-4); right: var(--s-4);
      width: 36px; height: 36px;
      background: transparent;
      border: 1px solid var(--line);
      border-radius: var(--r-pill);
      cursor: pointer;
      display: inline-flex; align-items: center; justify-content: center;
      color: var(--ink);
    }
    .drawer-close :global(svg) { fill: none; stroke: currentColor; }
    .drawer-close:hover { background: var(--surface); }

    .drawer-title {
      font-family: var(--font-display);
      font-weight: 500;
      font-size: var(--fs-h2);
      letter-spacing: -0.02em;
      margin-bottom: var(--s-4);
    }
    .drawer-body {
      font-family: var(--font-mono);
      font-size: var(--fs-body);
      line-height: var(--lh-loose);
      color: var(--ink-soft);
      margin-bottom: var(--s-4);
    }

    .recado-channels {
      display: flex;
      flex-direction: column;
      gap: var(--s-3);
      margin-top: var(--s-5);
    }
    .channel-btn {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 14px 18px;
      border: 1px solid var(--line);
      border-radius: var(--r-sm);
      font-family: var(--font-mono);
      font-size: var(--fs-small);
      color: var(--ink);
      text-decoration: none;
      transition: all var(--dur-fast);
    }
    .channel-btn :global(svg) { fill: none; stroke: currentColor; }
    .channel-btn:hover {
      border-color: var(--terracota);
      color: var(--terracota);
      background: var(--surface);
    }

    /* Tooltip flutuante — alinhado ao DS */
    .kitchen-tooltip {
      position: fixed;
      transform: translate(-50%, -100%) translateY(-18px);
      background: var(--ink);
      color: var(--bg);
      font-family: var(--font-mono);
      font-size: var(--fs-meta);
      letter-spacing: 0.02em;
      padding: 8px 14px;
      border-radius: var(--r-sm);
      box-shadow: var(--shadow-1);
      pointer-events: none;
      white-space: nowrap;
      opacity: 0;
      transition: opacity var(--dur-fast);
      z-index: 100;
    }
    .kitchen-tooltip::after {
      content: '';
      position: absolute;
      top: 100%; left: 50%;
      transform: translateX(-50%);
      border: 5px solid transparent;
      border-top-color: var(--ink);
    }
    .kitchen-tooltip.show { opacity: 1; }

    /* Toast de teste */
    .test-toast {
      position: fixed;
      bottom: 32px; left: 50%;
      transform: translate(-50%, 8px);
      background: var(--ink);
      color: var(--bg);
      font-family: var(--font-mono);
      font-size: 13px;
      padding: 10px 16px;
      border-radius: 999px;
      opacity: 0;
      pointer-events: none;
      transition: opacity 200ms, transform 200ms;
      z-index: 200;
    }
    .test-toast.show {
      opacity: 1;
      transform: translate(-50%, 0);
    }
  </style>

  <script>
    // Toast util
    const toastEl = document.getElementById('test-toast') as HTMLDivElement | null;
    let toastTimer: number | undefined;
    function toast(msg: string) {
      if (!toastEl) return;
      toastEl.textContent = msg;
      toastEl.classList.add('show');
      window.clearTimeout(toastTimer);
      toastTimer = window.setTimeout(() => toastEl.classList.remove('show'), 1600);
    }

    // Drawers
    const backdrop = document.getElementById('drawer-backdrop')!;
    function openDrawer(id: string) {
      const drawer = document.getElementById(id);
      if (!drawer) return;
      drawer.classList.add('open');
      drawer.setAttribute('aria-hidden', 'false');
      backdrop.classList.add('open');
      document.body.style.overflow = 'hidden';
    }
    function closeAllDrawers() {
      document.querySelectorAll('.drawer.open').forEach((d) => {
        d.classList.remove('open');
        d.setAttribute('aria-hidden', 'true');
      });
      backdrop.classList.remove('open');
      document.body.style.overflow = '';
    }
    backdrop.addEventListener('click', closeAllDrawers);
    document.querySelectorAll('[data-close-drawer]').forEach((btn) => {
      btn.addEventListener('click', closeAllDrawers);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeAllDrawers();
    });

    // Handler centralizado pros hotspots
    document.querySelectorAll<SVGGElement>('.hs').forEach((g) => {
      const fire = () => {
        const action = g.dataset.action;
        const key = g.dataset.key;
        if (action === 'dark') {
          document.body.classList.toggle('dark-mode');
          try {
            localStorage.setItem('cozy-dark-mode',
              document.body.classList.contains('dark-mode') ? 'true' : 'false');
          } catch (err) {}
          toast('☀️/🌙 dark mode');
        } else if (action === 'cat' && key) {
          window.location.href = `/categorias/${key}/`;
        } else if (action === 'sobre') {
          openDrawer('drawer-sobre');
        } else if (action === 'recado') {
          openDrawer('drawer-recado');
        } else if (action === 'akim') {
          showTooltipAt(g, 'miau 🐱', 1400);
        }
      };
      g.addEventListener('click', fire);
      g.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); fire(); }
      });
    });

    // Toggle debug das áreas clicáveis
    document.getElementById('hotspot-toggle')?.addEventListener('change', (e) => {
      const target = e.target as HTMLInputElement;
      document.body.classList.toggle('hotspots-debug', target.checked);
    });

    // Tooltip de hover
    const tooltip = document.getElementById('kitchen-tooltip')!;
    let tooltipPinTimer: number | undefined;

    function showTooltipAt(g: SVGGElement, text: string, pinMs = 0) {
      const rect = g.getBoundingClientRect();
      tooltip.textContent = text;
      tooltip.style.left = `${rect.left + rect.width / 2}px`;
      tooltip.style.top = `${rect.top}px`;
      tooltip.classList.add('show');
      window.clearTimeout(tooltipPinTimer);
      if (pinMs > 0) {
        // Trava o texto por pinMs e depois deixa o hover natural assumir
        tooltip.dataset.pinned = '1';
        tooltipPinTimer = window.setTimeout(() => {
          delete tooltip.dataset.pinned;
          // Se o mouse não está mais em cima, esconde
          if (!g.matches(':hover')) tooltip.classList.remove('show');
          else tooltip.textContent = g.dataset.label ?? '';
        }, pinMs);
      }
    }

    document.querySelectorAll<SVGGElement>('.hs').forEach((g) => {
      const label = g.dataset.label;
      if (!label) return;
      const show = () => {
        if (tooltip.dataset.pinned) return; // não sobrescreve enquanto pinado
        showTooltipAt(g, label);
      };
      const hide = () => {
        if (tooltip.dataset.pinned) return; // mantém pinado até timeout
        tooltip.classList.remove('show');
      };
      g.addEventListener('mouseenter', show);
      g.addEventListener('mouseleave', hide);
      g.addEventListener('focus', show);
      g.addEventListener('blur', hide);
    });
  </script>
</BaseLayout>
