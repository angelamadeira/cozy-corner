---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';
---

<BaseLayout title="Cozinha (teste)" description="Teste da cena de cozinha em line-art.">
  <header class="site-header">
    <a href="/" class="logo-link" aria-label="Cozy Corner">
      <span class="logo-name">Cozy Corner</span>
      <span class="logo-by">— by Gigi</span>
    </a>
  </header>

  <main class="page">
    <p class="meta">/cozinha-teste · SVG inline com hotspots no formato real</p>
    <h1 class="title">Cozinha — teste</h1>

    <label class="mock-toggle">
      <input type="checkbox" id="hotspot-toggle" />
      destacar áreas clicáveis (debug)
    </label>

    <section class="kitchen" aria-label="Cena da cozinha">
      <svg class="scene" viewBox="0 0 998 801" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Cozinha com elementos clicáveis">
        <!-- Bancada (não-clicável) -->
        <rect x="63.5" y="656.868" width="932" height="240" stroke="currentColor" stroke-width="5"/>
        <!-- Divisor da geladeira (não-clicável) -->
        <path d="M650 382.368L949 382.368" stroke="currentColor" stroke-width="5"/>
        <!-- Linha da bancada do meio (não-clicável) -->
        <path d="M161 444.368H542" stroke="currentColor" stroke-width="5"/>

        <!-- ============ HOTSPOTS ============ -->

        <!-- Para congelar (fridge top) -->
        <g class="hs" data-action="cat" data-key="congelar" role="button" aria-label="Para congelar" tabindex="0">
          <rect x="652.5" y="235.868" width="294" height="144" stroke="currentColor" stroke-width="5"/>
        </g>

        <!-- Geladeira (fridge lower) — interior, datas/recado vivem sobreposto -->
        <g class="hs hs-fridge-lower" data-action="cat" data-key="todas" role="button" aria-label="Geladeira (todas as receitas)" tabindex="0">
          <rect x="652.5" y="379.868" width="294" height="277" stroke="currentColor" stroke-width="5"/>
        </g>

        <!-- Pratos principais -->
        <g class="hs" data-action="cat" data-key="principais" role="button" aria-label="Pratos principais" tabindex="0">
          <rect x="263.5" y="589.868" width="155" height="67" stroke="currentColor" stroke-width="5"/>
        </g>

        <!-- Sobremesas -->
        <g class="hs" data-action="cat" data-key="sobremesas" role="button" aria-label="Sobremesas" tabindex="0">
          <rect x="484.5" y="589.868" width="96" height="67" stroke="currentColor" stroke-width="5"/>
        </g>

        <!-- Receitas rápidas (relógio) -->
        <g class="hs" data-action="cat" data-key="rapidas" role="button" aria-label="Receitas rápidas" tabindex="0">
          <circle cx="528" cy="142.368" r="58.5" stroke="currentColor" stroke-width="5"/>
          <path d="M528 103.368V143.893L550 165.368" stroke="currentColor" stroke-width="5"/>
        </g>

        <!-- Vegetarianas (vaso com planta) -->
        <g class="hs" data-action="cat" data-key="vegetarianas" role="button" aria-label="Vegetarianas" tabindex="0">
          <rect x="816.5" y="168.868" width="95" height="67" stroke="currentColor" stroke-width="5"/>
          <path d="M801.5 88.8679L840.5 167.868H874V155.868H963L884 120.868L909 65.8679L856.5 107.868L840.5 0.36792V107.868L801.5 88.8679Z" stroke="currentColor" stroke-width="5"/>
        </g>

        <!-- Datas comemorativas (calendário) -->
        <g class="hs" data-action="cat" data-key="datas" role="button" aria-label="Datas comemorativas" tabindex="0">
          <rect x="704.5" y="437.868" width="93" height="90" stroke="currentColor" stroke-width="5"/>
          <rect x="717.5" y="467.868" width="15" height="13" stroke="currentColor" stroke-width="5"/>
          <rect x="717.5" y="492.868" width="15" height="13" stroke="currentColor" stroke-width="5"/>
          <rect x="743.5" y="467.868" width="15" height="13" stroke="currentColor" stroke-width="5"/>
          <rect x="743.5" y="492.868" width="15" height="13" stroke="currentColor" stroke-width="5"/>
          <rect x="769.5" y="467.868" width="15" height="13" stroke="currentColor" stroke-width="5"/>
          <rect x="769.5" y="492.868" width="15" height="13" stroke="currentColor" stroke-width="5"/>
        </g>

        <!-- Deixe seu recado (post-it rotacionado) -->
        <g class="hs" data-action="recado" role="button" aria-label="Deixe seu recado" tabindex="0">
          <rect x="869.943" y="423.873" width="54.5792" height="52.7554" transform="rotate(37.465 869.943 423.873)" stroke="currentColor" stroke-width="5"/>
        </g>

        <!-- Sobre mim (quadro) -->
        <g class="hs" data-action="sobre" role="button" aria-label="Sobre mim" tabindex="0">
          <rect x="209.5" y="329.868" width="102" height="114" stroke="currentColor" stroke-width="5"/>
          <rect x="218.5" y="339.868" width="84" height="94" stroke="currentColor" stroke-width="5"/>
        </g>

        <!-- Todas as receitas (livros) -->
        <g class="hs" data-action="cat" data-key="todas" role="button" aria-label="Todas as receitas" tabindex="0">
          <rect x="375.5" y="426.868" width="109" height="17" stroke="currentColor" stroke-width="5"/>
          <rect x="375.5" y="408.868" width="109" height="18" stroke="currentColor" stroke-width="5"/>
        </g>

        <!-- Dark mode (interruptor) -->
        <g class="hs" data-action="dark" role="button" aria-label="Dark mode (liga/desliga)" tabindex="0">
          <rect x="2.5" y="413.868" width="53" height="67" stroke="currentColor" stroke-width="5"/>
          <rect x="18.5" y="433.868" width="20" height="26" stroke="currentColor" stroke-width="5"/>
        </g>

        <!-- Akim (gato) -->
        <g class="hs" data-action="akim" role="button" aria-label="Akim" tabindex="0">
          <path d="M77.9648 582.471C84.1218 587.599 88 595.06 88 603.368C88 604.737 87.892 606.083 87.6885 607.4C96.97 604.841 107.857 603.368 119.5 603.368C153.466 603.368 181 615.904 181 631.368C181 646.832 153.466 659.368 119.5 659.368C85.5345 659.368 58 646.832 58 631.368C41.4315 631.368 28 618.832 28 603.368C28 600.619 28.4257 597.963 29.2168 595.453L28.6846 595.961L23.0684 572.739L43.6201 578.789C47.8898 576.608 52.7897 575.368 58 575.368C58.3399 575.368 58.6785 575.374 59.0156 575.385L72.4629 561.938L77.9648 582.471ZM119.5 608.368C106.969 608.368 95.483 610.139 86.1494 613.066C82.4813 622.337 73.7073 629.298 63.0107 630.976C63.0038 631.108 63 631.238 63 631.368C63 635.938 67.295 641.703 78.085 646.616C88.4264 651.324 103.064 654.368 119.5 654.368C135.936 654.368 150.574 651.324 160.915 646.616C171.705 641.703 176 635.938 176 631.368C176 626.798 171.705 621.032 160.915 616.12C150.574 611.412 135.936 608.368 119.5 608.368ZM58 580.368C43.8624 580.368 33 590.985 33 603.368C33 615.751 43.8624 626.368 58 626.368C58.3306 626.368 58.6594 626.36 58.9863 626.348C61.7696 619.348 70.2692 613.254 82.2051 609.103C82.7236 607.26 83 605.336 83 603.368C83 590.985 72.1376 580.368 58 580.368ZM79.1152 615.662C78.7672 615.813 78.4239 615.966 78.085 616.12C71.6432 619.053 67.5173 622.29 65.2373 625.395C71.0915 623.776 75.9634 620.244 79.1152 615.662ZM31.5088 586.368L36.2676 581.837L29.9639 579.982L31.5088 586.368ZM65.2725 576.198C66.3213 576.442 67.3487 576.735 68.3506 577.079L71.5762 577.944L69.875 571.597L65.2725 576.198Z" fill="currentColor"/>
        </g>
      </svg>
    </section>

    <p class="hint">
      <Icon name="ph:info-thin" /> hover destaca o elemento; clique segue pra categoria ou abre o modal.
    </p>
  </main>

  <div class="test-toast" id="test-toast" role="status" aria-live="polite"></div>

  <style>
    .site-header {
      position: fixed; top: 0; left: 0; right: 0;
      height: var(--header-h);
      padding: 0 var(--s-6);
      display: flex; align-items: center;
      z-index: 100;
      background: rgba(250, 246, 238, 0.85);
      backdrop-filter: blur(8px);
      border-bottom: 1px solid var(--line-soft);
    }
    body.dark-mode .site-header { background: rgba(15, 26, 42, 0.85); }
    .logo-link { text-decoration: none; display: flex; flex-direction: column; align-items: flex-end; line-height: 1.1; }
    .logo-name { font-family: var(--font-brand); font-weight: 600; font-size: 22px; line-height: 1; }
    .logo-by { font-family: var(--font-mono); font-size: 10px; color: var(--ink-soft); margin-top: 1px; }

    .page {
      max-width: 1400px;
      margin: 0 auto;
      padding: calc(var(--header-h) + var(--s-7)) var(--s-6) var(--s-9);
    }
    .meta { font-family: var(--font-mono); font-size: 12px; color: var(--ink-mute); }
    .title {
      font-family: var(--font-display);
      font-weight: 500;
      font-size: var(--fs-h1);
      letter-spacing: -0.02em;
      margin: 8px 0 var(--s-5);
    }
    .mock-toggle {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-family: var(--font-mono);
      font-size: var(--fs-meta);
      color: var(--ink-soft);
      margin-bottom: var(--s-4);
      cursor: pointer;
    }
    .mock-toggle input { accent-color: var(--terracota); }
    .hint {
      margin-top: var(--s-5);
      font-family: var(--font-mono);
      font-size: var(--fs-meta);
      color: var(--ink-mute);
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }
    .hint :global(svg) { fill: none; stroke: currentColor; }

    /* ============ CENA ============ */
    .kitchen {
      position: relative;
      width: 100%;
      aspect-ratio: 998 / 801;
      color: var(--ink);
    }
    .scene {
      width: 100%;
      height: 100%;
      display: block;
    }

    /* ============ HOTSPOTS ============ */
    /* bounding-box: hit-test pelo bbox do grupo (não só pelo stroke) */
    .scene :global(.hs) {
      cursor: pointer;
      pointer-events: bounding-box;
      transition: transform 200ms ease;
      transform-box: fill-box;
      transform-origin: center;
    }
    /* Debug: ressalta as áreas clicáveis com fill semi-transparente */
    body.hotspots-debug .scene :global(.hs > rect),
    body.hotspots-debug .scene :global(.hs > circle),
    body.hotspots-debug .scene :global(.hs > path) {
      fill: rgba(197, 107, 74, 0.15);
    }
    /* Hover: stroke terracota nas linhas + leve scale */
    .scene :global(.hs:hover) {
      transform: scale(1.04);
    }
    .scene :global(.hs:hover > rect),
    .scene :global(.hs:hover > circle),
    .scene :global(.hs:hover > path) {
      stroke: var(--terracota);
    }
    /* Pra path com fill (cat), muda o fill no hover */
    .scene :global(.hs:hover > path[fill="currentColor"]) {
      fill: var(--terracota);
    }
    .scene :global(.hs:focus-visible) {
      outline: 2px solid var(--terracota);
      outline-offset: 4px;
    }

    /* Toast de teste */
    .test-toast {
      position: fixed;
      bottom: 32px; left: 50%;
      transform: translate(-50%, 8px);
      background: var(--ink);
      color: var(--bg);
      font-family: var(--font-mono);
      font-size: 13px;
      padding: 10px 16px;
      border-radius: 999px;
      opacity: 0;
      pointer-events: none;
      transition: opacity 200ms, transform 200ms;
      z-index: 200;
    }
    .test-toast.show {
      opacity: 1;
      transform: translate(-50%, 0);
    }
  </style>

  <script>
    // Toast util
    const toastEl = document.getElementById('test-toast') as HTMLDivElement | null;
    let toastTimer: number | undefined;
    function toast(msg: string) {
      if (!toastEl) return;
      toastEl.textContent = msg;
      toastEl.classList.add('show');
      window.clearTimeout(toastTimer);
      toastTimer = window.setTimeout(() => toastEl.classList.remove('show'), 1600);
    }

    // Handler centralizado pros hotspots
    document.querySelectorAll<SVGGElement>('.hs').forEach((g) => {
      const fire = () => {
        const action = g.dataset.action;
        const key = g.dataset.key;
        if (action === 'dark') {
          document.body.classList.toggle('dark-mode');
          try {
            localStorage.setItem('cozy-dark-mode',
              document.body.classList.contains('dark-mode') ? 'true' : 'false');
          } catch (err) {}
          toast('☀️/🌙 dark mode');
        } else if (action === 'cat' && key) {
          window.location.href = `/categorias/${key}/`;
        } else if (action === 'sobre') {
          toast('→ sobre mim (modal pendente)');
        } else if (action === 'recado') {
          toast('→ deixe seu recado (modal pendente)');
        } else if (action === 'akim') {
          toast('miau 🐱');
        }
      };
      g.addEventListener('click', fire);
      g.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); fire(); }
      });
    });

    // Toggle debug das áreas clicáveis
    document.getElementById('hotspot-toggle')?.addEventListener('change', (e) => {
      const target = e.target as HTMLInputElement;
      document.body.classList.toggle('hotspots-debug', target.checked);
    });
  </script>
</BaseLayout>
