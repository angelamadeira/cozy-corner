---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';
---

<BaseLayout title="Cozinha (teste)" description="Teste da cena de cozinha em line-art.">
  <header class="site-header">
    <a href="/" class="logo-link" aria-label="Cozy Corner">
      <span class="logo-name">Cozy Corner</span>
      <span class="logo-by">— by Gigi</span>
    </a>
  </header>

  <main class="page">
    <p class="meta">/cozinha-teste · line-art posicionado a partir do mock da Gigi</p>
    <h1 class="title">Cozinha — teste de posicionamento</h1>

    <label class="mock-toggle">
      <input type="checkbox" id="mock-toggle" checked />
      mostrar mock como referência
    </label>

    <section class="kitchen" aria-label="Cena da cozinha com hotspots">
      <!-- Mock de referência (overlay translúcido) -->
      <img class="mock-overlay" src="/kitchen/mock.png" alt="" />
      <!-- Geladeira (corpo) -->
      <div class="el geladeira" aria-hidden="true">
        <img src="/kitchen/geladeira.svg" alt="" />
      </div>
      <!-- Divisor da geladeira pra criar 'para congelar' em cima -->
      <div class="freezer-divider" aria-hidden="true"></div>

      <!-- Vaso (vegetarianas) — em cima da geladeira -->
      <button class="el vaso" data-action="cat" data-key="vegetarianas" type="button" aria-label="Vegetarianas">
        <img src="/kitchen/vaso.svg" alt="" />
        <span class="label">vegetarianas</span>
      </button>

      <!-- Relógio (rápidas) — meio-alto -->
      <button class="el relogio" data-action="cat" data-key="rapidas" type="button" aria-label="Receitas rápidas">
        <img src="/kitchen/relogio.svg" alt="" />
        <span class="label">receitas rápidas</span>
      </button>

      <!-- Para congelar — seção superior da geladeira -->
      <button class="el congelar" data-action="cat" data-key="congelar" type="button" aria-label="Para congelar">
        <span class="label label-on-fridge">para congelar</span>
      </button>

      <!-- Calendário (datas) — na geladeira -->
      <button class="el calendario" data-action="cat" data-key="datas" type="button" aria-label="Datas comemorativas">
        <img src="/kitchen/calendario.svg" alt="" />
        <span class="label">datas comemorativas</span>
      </button>

      <!-- Post-it (recado) — losango na geladeira -->
      <button class="el postit" data-action="recado" type="button" aria-label="Deixe seu recado">
        <img src="/kitchen/postit.svg" alt="" />
        <span class="label">deixe seu recado</span>
      </button>

      <!-- Quadro (sobre mim) — meio-esquerda -->
      <button class="el quadro" data-action="sobre" type="button" aria-label="Sobre mim">
        <img src="/kitchen/quadro.svg" alt="" />
        <span class="label">sobre mim</span>
      </button>

      <!-- Livros (todas) — meio -->
      <button class="el livros" data-action="cat" data-key="todas" type="button" aria-label="Todas as receitas">
        <img src="/kitchen/livros.svg" alt="" />
        <span class="label">todas as receitas</span>
      </button>

      <!-- Interruptor (dark mode) -->
      <button class="el interruptor" data-action="dark-mode" type="button" aria-label="Liga/desliga dark mode">
        <img src="/kitchen/interruptor.svg" alt="" />
        <span class="label">dark mode</span>
      </button>

      <!-- Counter (bancada) -->
      <div class="counter" aria-hidden="true"></div>

      <!-- Gato (akim) — bancada -->
      <button class="el akim" data-action="akim" type="button" aria-label="Akim, o gato">
        <img src="/kitchen/akim.svg" alt="" />
        <span class="label">akim</span>
      </button>

      <!-- Prato (principais) — bancada -->
      <button class="el prato" data-action="cat" data-key="principais" type="button" aria-label="Pratos principais">
        <img src="/kitchen/prato.svg" alt="" />
        <span class="label">pratos principais</span>
      </button>

      <!-- Sobremesa — bancada -->
      <button class="el sobremesa" data-action="cat" data-key="sobremesas" type="button" aria-label="Sobremesas">
        <img src="/kitchen/sobremesa.svg" alt="" />
        <span class="label">sobremesas</span>
      </button>
    </section>

    <p class="hint">
      <Icon name="ph:info-thin" /> passa o mouse em cima dos elementos pra ver o nome.
      Clique pra testar a navegação (ainda não conectado neste teste).
    </p>
  </main>

  <style>
    .site-header {
      position: fixed; top: 0; left: 0; right: 0;
      height: var(--header-h);
      padding: 0 var(--s-6);
      display: flex; align-items: center;
      z-index: 100;
      background: rgba(250, 246, 238, 0.85);
      backdrop-filter: blur(8px);
      border-bottom: 1px solid var(--line-soft);
    }
    body.dark-mode .site-header { background: rgba(15, 26, 42, 0.85); }
    .logo-link { text-decoration: none; display: flex; flex-direction: column; align-items: flex-end; line-height: 1.1; }
    .logo-name { font-family: var(--font-brand); font-weight: 600; font-size: 22px; line-height: 1; }
    .logo-by { font-family: var(--font-mono); font-size: 10px; color: var(--ink-soft); margin-top: 1px; }

    .page {
      max-width: 1400px;
      margin: 0 auto;
      padding: calc(var(--header-h) + var(--s-7)) var(--s-6) var(--s-9);
    }
    .meta { font-family: var(--font-mono); font-size: 12px; color: var(--ink-mute); }
    .title {
      font-family: var(--font-display);
      font-weight: 500;
      font-size: var(--fs-h1);
      letter-spacing: -0.02em;
      margin: 8px 0 var(--s-6);
    }
    .hint {
      margin-top: var(--s-5);
      font-family: var(--font-mono);
      font-size: var(--fs-meta);
      color: var(--ink-mute);
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }
    .hint :global(svg) { fill: none; stroke: currentColor; }

    .mock-toggle {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-family: var(--font-mono);
      font-size: var(--fs-meta);
      color: var(--ink-soft);
      margin-bottom: var(--s-3);
      cursor: pointer;
    }
    .mock-toggle input { accent-color: var(--terracota); }

    /* ============ CENA DA COZINHA ============ */
    .kitchen {
      position: relative;
      width: 100%;
      aspect-ratio: 1512 / 982;
      background: var(--bg);
      color: var(--ink);
      border: 1px dashed var(--line);
    }
    .mock-overlay {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: contain;
      pointer-events: none;
      opacity: 0.25;
      z-index: 1;
      filter: contrast(1.2);
    }
    body.mock-hidden .mock-overlay { display: none; }
    /* Eleva os elementos pra ficarem visíveis acima do mock */
    .el { z-index: 2; }
    .counter, .freezer-divider { z-index: 2; }
    /* Linha do chão / bancada — caixa aberta embaixo da cozinha */
    .kitchen .counter {
      position: absolute;
      left: 19.5%; top: 88.1%;
      width: 76.8%; height: 11.7%;
      border-top: 3px solid currentColor;
      border-left: 3px solid currentColor;
      border-right: 3px solid currentColor;
      border-bottom: 3px solid currentColor;
    }
    /* Geladeira: SVG stretch via preserveAspectRatio none */
    .geladeira img { width: 100%; height: 100%; object-fit: fill; }

    /* Elementos do cenário/hotspots */
    .el {
      position: absolute;
      background: transparent;
      border: none;
      padding: 0;
      cursor: default;
      color: var(--ink);
    }
    .el img {
      width: 100%;
      height: 100%;
      display: block;
    }
    body.dark-mode .el img {
      filter: invert(1);
    }
    /* Hotspots (botões) ganham hover/cursor */
    button.el {
      cursor: pointer;
      transition: transform var(--dur-fast);
    }
    button.el:hover {
      transform: scale(1.06);
    }
    button.el:hover .label {
      opacity: 1;
      transform: translate(-50%, 0);
    }
    .label {
      position: absolute;
      left: 50%;
      top: -22px;
      transform: translate(-50%, 4px);
      font-family: var(--font-mono);
      font-size: 11px;
      color: var(--ink);
      background: var(--bg);
      padding: 2px 8px;
      border: 1px solid var(--line);
      border-radius: var(--r-sm);
      white-space: nowrap;
      opacity: 0;
      transition: opacity var(--dur-fast), transform var(--dur-fast);
      pointer-events: none;
    }
    .label-on-fridge {
      position: absolute;
      left: 50%; top: 50%;
      transform: translate(-50%, -50%);
      opacity: 1;
      background: transparent;
      border: none;
      font-family: var(--font-mono);
      font-size: 13px;
      color: var(--ink-soft);
      text-transform: lowercase;
    }

    /* ============ POSIÇÕES (% do mock 1512x982) ============
       Centros estimados visualmente — ajustar com o overlay ligado. */

    /* Parede */
    .relogio    { left: 47.6%; top: 26.5%; width: 7.9%;  height: 12.2%; }
    .quadro     { left: 28.6%; top: 46.1%; width: 7.6%;  height: 17.8%; }
    .livros     { left: 40.7%; top: 56.3%; width: 13.2%; height: 7.6%;  }
    .interruptor{ left: 15.5%; top: 58.5%; width: 4%;    height: 10.2%; }

    /* Geladeira (corpo grande) */
    .geladeira { left: 57.5%; top: 37.7%; width: 21.2%; height: 49.9%; }
    .freezer-divider {
      position: absolute;
      left: 57.5%; top: 58.2%;
      width: 21.2%;
      height: 3px;
      background: currentColor;
    }
    /* Vaso em cima da geladeira */
    .vaso       { left: 64.8%; top: 17.8%; width: 13.2%; height: 21.4%; }

    /* Hotspot 'para congelar' = metade superior da geladeira */
    .congelar { left: 57.5%; top: 37.7%; width: 21.2%; height: 20.5%; }
    .congelar img { display: none; }

    /* Coisas grudadas na geladeira (metade inferior) */
    .calendario { left: 62.3%; top: 61.4%; width: 7.6%;  height: 11.7%; }
    .postit     { left: 72.4%; top: 60.5%; width: 7.9%;  height: 12.2%; }

    /* Bancada (counter) e itens sobre ela */
    .akim       { left: 16.4%; top: 75.4%; width: 10.9%; height: 12.2%; }
    .prato      { left: 31.7%; top: 73.3%; width: 11.9%; height: 14.3%; }
    .sobremesa  { left: 46.6%; top: 73.3%; width: 7.3%;  height: 14.3%; }

    @media (max-width: 640px) {
      .title { font-size: 28px; }
      .kitchen { aspect-ratio: 1500 / 1200; }
    }
  </style>

  <script>
    // Dark toggle pelo interruptor
    document.querySelector('.interruptor')?.addEventListener('click', () => {
      document.body.classList.toggle('dark-mode');
      try {
        localStorage.setItem('cozy-dark-mode',
          document.body.classList.contains('dark-mode') ? 'true' : 'false');
      } catch (e) {}
    });

    // Toggle do mock como overlay de referência
    document.getElementById('mock-toggle')?.addEventListener('change', (e) => {
      const target = e.target as HTMLInputElement;
      document.body.classList.toggle('mock-hidden', !target.checked);
    });
  </script>
</BaseLayout>
