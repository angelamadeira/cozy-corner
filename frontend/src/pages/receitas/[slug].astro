---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';
import { getCollection, render } from 'astro:content';
import { CATEGORY_META } from '../../lib/categories';
import { iconForMaterial } from '../../lib/materials';
import CookingMode from '../../components/CookingMode.astro';

export async function getStaticPaths() {
  const recipes = await getCollection('recipes', ({ data }) => data.published);
  return recipes.map((recipe) => ({
    params: { slug: recipe.id },
    props: { recipe },
  }));
}

const { recipe } = Astro.props;
const data = recipe.data;
const category = CATEGORY_META[data.category];

// Reordena pra cover vir primeiro
const coverIdx = data.media.findIndex((m) => m.cover);
const orderedMedia = coverIdx > 0
  ? [data.media[coverIdx], ...data.media.filter((_, i) => i !== coverIdx)]
  : data.media;

// Data de publicação em PT-BR ("13 de maio de 2026")
const publishedLabel = new Intl.DateTimeFormat('pt-BR', {
  day: 'numeric', month: 'long', year: 'numeric',
}).format(data.publishedAt);
---

<BaseLayout title={data.title} description={data.description}>
  <header class="site-header">
    <a href="/" class="logo-link" aria-label="Cozy Corner">
      <span class="logo-name">Cozy Corner</span>
      <span class="logo-by">— by Gigi</span>
    </a>
    <button class="dark-toggle" id="dark-toggle" type="button" aria-label="alternar dark mode">
      <Icon name="ph:lightbulb-thin" class="icon-light" width={20} height={20} />
      <Icon name="ph:moon-thin" class="icon-dark" width={20} height={20} />
    </button>
  </header>

  <main class="recipe">
    <a href={`/categorias/${data.category}`} class="back-link">
      <Icon name="ph:arrow-left-thin" /> {category.label}
    </a>

    <!-- ============ CAROUSEL ============ -->
    {orderedMedia.length > 0 && (
    <section class="hero" aria-label="Galeria da receita">
      <div class="carousel" data-count={orderedMedia.length}>
        {orderedMedia.length > 1 && (
          <button class="carousel-arrow prev" type="button" aria-label="anterior">
            <Icon name="ph:caret-left-thin" width={22} height={22} />
          </button>
        )}
        <div class="carousel-viewport">
          <div class="carousel-track" id="carousel-track">
            {orderedMedia.map((m) => (
              <div class="media-slot" data-type={m.type}>
                {m.type === 'video' ? (
                  <span class="placeholder">
                    <Icon name="ph:play-circle-thin" width={32} height={32} />
                    vídeo · {m.alt ?? 'sem descrição'}
                  </span>
                ) : (
                  <span class="placeholder">
                    <Icon name="ph:image-thin" width={32} height={32} />
                    foto · {m.alt ?? 'sem descrição'}
                  </span>
                )}
              </div>
            ))}
          </div>
        </div>
        {orderedMedia.length > 1 && (
          <button class="carousel-arrow next" type="button" aria-label="próximo">
            <Icon name="ph:caret-right-thin" width={22} height={22} />
          </button>
        )}
      </div>
      {orderedMedia.length > 1 && (
        <div class="carousel-dots" role="tablist" aria-label="navegação da galeria">
          {orderedMedia.map((m, i) => (
            <button
              type="button"
              class={`dot ${i === 0 ? 'active' : ''} ${m.type === 'video' ? 'video' : ''}`}
              data-index={i}
              role="tab"
              aria-label={`${m.type === 'video' ? 'vídeo' : 'foto'} ${i + 1}`}
              aria-selected={i === 0 ? 'true' : 'false'}
            ></button>
          ))}
        </div>
      )}
    </section>
    )}

    <!-- ============ TÍTULO + META ============ -->
    <section class="titlebar">
      <h1 class="recipe-title">{data.title}</h1>
      <div class="meta-row">
        <p class="recipe-meta">
          <Icon name="ph:clock-thin" /> {data.time} min
          <span class="sep">·</span>
          <Icon name="ph:fork-knife-thin" /> <span id="meta-servings">{data.servings}</span> porções
          <span class="sep">·</span>
          <Icon name="ph:gauge-thin" /> {data.difficulty}
          {data.tags.includes('vegetariana') && (
            <>
              <span class="sep">·</span>
              <Icon name="ph:plant-thin" /> vegetariana
            </>
          )}
        </p>
        <p class="recipe-added">
          <Icon name="ph:calendar-thin" /> adicionada em <time datetime={data.publishedAt.toISOString().slice(0, 10)}>{publishedLabel}</time>
        </p>
      </div>
      {data.description && <p class="recipe-description">{data.description}</p>}
    </section>

    <!-- ============ BODY ============ -->
    <section class="body">
      <aside class="ingredients-col">
        <h2 class="section-title">Ingredientes</h2>
        <div class="unit-toggle" role="tablist" aria-label="Sistema de unidades">
          <button class="unit-btn active" type="button" data-unit="metric" aria-selected="true">métrico</button>
          <button class="unit-btn" type="button" data-unit="imperial" aria-selected="false">imperial</button>
        </div>

        <ul class="ingredient-list" id="ingredient-list" data-original-servings={data.servings}>
          {data.ingredients.map((ing) => <li data-source={ing}>{ing}</li>)}
        </ul>

        <div class="portion-slider">
          <label>
            <span class="portion-label">ajustar porções: <strong id="portion-value">{data.servings}</strong></span>
            <input type="range" min="1" max="12" value={data.servings} id="portion-range" />
          </label>
        </div>

        {data.materials.length > 0 && (
          <>
            <h2 class="section-title materials-title">Materiais</h2>
            <ul class="material-list">
              {data.materials.map((m) => (
                <li>
                  <Icon name={iconForMaterial(m)} width={14} height={14} />
                  {m}
                </li>
              ))}
            </ul>
          </>
        )}
      </aside>

      <div class="steps-col">
        <div class="steps-header">
          <h2 class="section-title">Modo de preparo</h2>
          <button class="btn btn-primary cooking-mode" type="button" id="open-cooking-mode">
            <Icon name="ph:cooking-pot-thin" /> Modo cozinha
          </button>
        </div>

        <ol class="step-list">
          {data.steps.map((step, i) => (
            <li class="step">
              <span class="step-num">{i + 1}</span>
              <p>{step}</p>
            </li>
          ))}
        </ol>

        {data.notes && (
          <aside class="recipe-notes">
            <h3 class="notes-title">Notas</h3>
            <p>{data.notes}</p>
          </aside>
        )}

        <div class="share">
          <button class="btn btn-ghost" type="button" id="share-whatsapp">
            <Icon name="ph:whatsapp-logo-thin" /> Mandar pro WhatsApp
          </button>
          <button class="btn btn-ghost" type="button" id="share-copy">
            <Icon name="ph:link-thin" /> <span class="copy-label">Copiar link</span>
          </button>
          <button class="btn btn-ghost" type="button" id="share-print">
            <Icon name="ph:printer-thin" /> Imprimir
          </button>
        </div>
      </div>
    </section>
  </main>

  <footer class="print-footer" aria-hidden="true">
    <span class="pf-credit">Cozy Corner · recipes by Angela Madeira</span>
    <span class="pf-sep">·</span>
    <span class="pf-date">impresso em <span id="print-date"></span></span>
  </footer>

  <CookingMode steps={data.steps} ingredients={data.ingredients} recipeTitle={data.title} />

  <div class="toast" id="toast" role="status" aria-live="polite" hidden>
    <Icon name="ph:check-circle-thin" width={18} height={18} />
    <span id="toast-msg">link copiado</span>
  </div>

  <style>
    /* ============ HEADER ============ */
    .site-header {
      position: fixed;
      top: 0; left: 0; right: 0;
      height: var(--header-h);
      padding: 0 var(--s-6);
      display: flex;
      align-items: center;
      justify-content: space-between;
      z-index: 100;
      background: rgba(250, 246, 238, 0.85);
      backdrop-filter: blur(8px);
      border-bottom: 1px solid var(--line-soft);
    }
    body.dark-mode .site-header { background: rgba(15, 26, 42, 0.85); }
    .logo-link {
      text-decoration: none;
      display: flex;
      flex-direction: column;
      align-items: flex-end; /* "— by Gigi" alinhado à direita */
      line-height: 1.1;
    }
    .logo-name {
      font-family: var(--font-brand);
      font-weight: 600;
      font-size: 22px;
      line-height: 1;
      letter-spacing: 0;
    }
    .logo-by {
      font-family: var(--font-mono);
      font-size: 10px;
      color: var(--ink-soft);
      margin-top: 1px;
    }
    .dark-toggle {
      width: 36px; height: 36px;
      background: transparent;
      border: 1px solid var(--line);
      border-radius: var(--r-pill);
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      transition: transform var(--dur-fast);
    }
    .dark-toggle:hover { transform: scale(1.05); }
    .icon-dark { display: none; }
    body.dark-mode .icon-light { display: none; }
    body.dark-mode .icon-dark { display: inline-block; }

    /* ============ MAIN ============ */
    .recipe {
      max-width: 1000px;
      margin: 0 auto;
      padding: calc(var(--header-h) + var(--s-7)) var(--s-6) var(--s-9);
    }

    .back-link {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-family: var(--font-mono);
      font-size: var(--fs-meta);
      color: var(--ink-soft);
      text-decoration: none;
      margin-bottom: var(--s-5);
    }
    .back-link:hover { color: var(--terracota); }

    /* ============ CAROUSEL ============ */
    .hero {
      margin-bottom: var(--s-6);
    }
    .carousel {
      position: relative;
    }
    .carousel-viewport {
      aspect-ratio: 16/9;
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--r-md);
      overflow: hidden;
      touch-action: pan-y; /* permite scroll vertical, captura horizontal */
    }
    .carousel-track {
      display: flex;
      width: 100%; height: 100%;
      transition: transform 360ms cubic-bezier(0.32, 0.72, 0, 1);
    }
    .media-slot {
      flex: 0 0 100%;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .placeholder {
      display: inline-flex;
      flex-direction: column;
      align-items: center;
      gap: var(--s-2);
      font-family: var(--font-mono);
      font-size: var(--fs-small);
      color: var(--ink-mute);
    }
    .placeholder :global(svg) {
      fill: none;
      stroke: currentColor;
      opacity: 0.6;
    }
    .carousel-arrow {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      width: 44px; height: 44px;
      border-radius: var(--r-pill);
      background: var(--bg);
      border: 1px solid var(--line);
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      z-index: 2;
      box-shadow: var(--shadow-1);
      transition: transform var(--dur-fast), background var(--dur-fast);
      color: var(--ink);
    }
    .carousel-arrow:hover { transform: translateY(-50%) scale(1.05); background: var(--surface); }
    .carousel-arrow:disabled {
      opacity: 0.3;
      cursor: default;
    }
    .carousel-arrow:disabled:hover { transform: translateY(-50%) scale(1); background: var(--bg); }
    .carousel-arrow.prev { left: var(--s-3); }
    .carousel-arrow.next { right: var(--s-3); }
    .carousel-arrow :global(svg) { fill: none; stroke: currentColor; }
    .carousel-dots {
      display: flex;
      gap: 8px;
      justify-content: center;
      margin-top: var(--s-3);
    }
    .carousel-dots .dot {
      width: 8px; height: 8px;
      padding: 0;
      border: none;
      border-radius: var(--r-pill);
      background: var(--line);
      cursor: pointer;
      transition: width var(--dur-fast), background var(--dur-fast);
    }
    .carousel-dots .dot:hover { background: var(--ink-soft); }
    .carousel-dots .dot.active {
      background: var(--ink);
      width: 24px;
      border-radius: var(--r-sm);
    }
    .carousel-dots .dot.video {
      background: var(--ink-mute);
      border: 1px solid var(--ink-soft);
    }
    .carousel-dots .dot.active.video { background: var(--terracota); border-color: var(--terracota); }

    /* ============ TITLEBAR ============ */
    .titlebar { margin-bottom: var(--s-7); }
    .recipe-title {
      font-family: var(--font-display);
      font-weight: 500;
      font-size: var(--fs-h1);
      letter-spacing: -0.02em;
      line-height: var(--lh-tight);
      margin-bottom: var(--s-2);
    }
    .recipe-meta {
      display: inline-flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--s-2);
      font-family: var(--font-mono);
      font-size: var(--fs-meta);
      color: var(--ink-soft);
    }
    .recipe-meta svg { vertical-align: -0.15em; margin-right: 2px; }
    .recipe-meta .sep { opacity: 0.4; margin: 0 2px; }
    .recipe-description {
      margin-top: var(--s-4);
      max-width: var(--max-text);
      color: var(--ink-soft);
      line-height: var(--lh-loose);
    }
    .meta-row {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: var(--s-4);
    }
    .meta-row .recipe-meta { margin: 0; }
    .recipe-added {
      font-family: var(--font-mono);
      font-size: var(--fs-caption);
      color: var(--ink-mute);
      display: inline-flex;
      align-items: center;
      gap: 6px;
      white-space: nowrap;
      margin: 0;
    }
    .recipe-added :global(svg) { fill: none; stroke: currentColor; opacity: 0.8; }

    /* Rodapé só pra impressão */
    .print-footer {
      display: none;
    }

    /* ============ BODY ============ */
    .body {
      display: grid;
      grid-template-columns: 280px 1fr;
      gap: var(--s-7);
    }
    .section-title {
      font-family: var(--font-display);
      font-weight: 600;
      font-size: var(--fs-h3);
      letter-spacing: -0.005em;
      margin-bottom: var(--s-3);
    }

    /* ============ INGREDIENTES ============ */
    .ingredients-col {
      position: sticky;
      top: calc(var(--header-h) + var(--s-5));
      align-self: start;
      padding: var(--s-5);
      background: var(--surface);
      border-radius: var(--r-md);
    }
    .unit-toggle {
      display: inline-flex;
      gap: 2px;
      background: var(--bg);
      border: 1px solid var(--line);
      border-radius: var(--r-pill);
      padding: 2px;
      margin-bottom: var(--s-4);
    }
    .unit-btn {
      background: transparent;
      border: none;
      font: inherit;
      font-size: var(--fs-caption);
      color: var(--ink-soft);
      padding: 4px 12px;
      border-radius: var(--r-pill);
      cursor: pointer;
    }
    .unit-btn.active {
      background: var(--ink);
      color: var(--bg);
    }
    .ingredient-list {
      list-style: none;
      margin-bottom: var(--s-4);
    }
    .ingredient-list li {
      padding: var(--s-2) 0;
      border-bottom: 1px solid var(--line-soft);
      font-size: var(--fs-body);
    }
    .ingredient-list li:last-child { border-bottom: none; }

    .portion-slider {
      margin-bottom: var(--s-5);
      font-size: var(--fs-small);
      color: var(--ink-soft);
    }
    .portion-slider input {
      width: 100%;
      margin-top: 6px;
      accent-color: var(--terracota);
    }
    .portion-slider strong { color: var(--ink); font-weight: 500; }

    .materials-title {
      margin-top: var(--s-5);
      padding-top: var(--s-4);
      border-top: 1px solid var(--line-soft);
    }
    .material-list {
      list-style: none;
    }
    .material-list li {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: var(--s-2) 0;
      font-size: var(--fs-small);
      color: var(--ink-soft);
    }

    /* ============ STEPS ============ */
    .steps-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--s-3);
      margin-bottom: var(--s-4);
    }
    .steps-header .section-title { margin-bottom: 0; }

    .step-list {
      list-style: none;
    }
    .step {
      display: grid;
      grid-template-columns: 32px 1fr;
      gap: var(--s-4);
      padding: var(--s-4) 0;
      border-bottom: 1px solid var(--line-soft);
    }
    .step:last-child { border-bottom: none; }
    .step-num {
      font-family: var(--font-mono);
      font-size: var(--fs-h3);
      color: var(--terracota);
    }
    .step p {
      font-family: var(--font-mono);
      line-height: var(--lh-loose);
    }

    /* ============ SHARE ============ */
    .share {
      margin-top: var(--s-7);
      padding-top: var(--s-6);
      display: flex;
      flex-wrap: wrap;
      gap: var(--s-3);
      border-top: 1px solid var(--line-soft);
    }

    /* ============ BUTTONS ============ */
    .btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 10px 14px;
      border-radius: var(--r-sm);
      font: inherit;
      font-size: var(--fs-small);
      cursor: pointer;
      border: 1px solid transparent;
      transition: opacity var(--dur-fast), transform var(--dur-fast), background var(--dur-base);
    }
    .btn:hover { transform: translateY(-1px); }
    .btn-primary {
      background: var(--terracota);
      color: white;
      border-color: var(--terracota);
    }
    .btn-primary:hover { opacity: 0.92; }
    .btn-ghost {
      background: transparent;
      color: var(--ink);
      border-color: var(--line);
    }
    .btn-ghost:hover { background: var(--surface); }
    .cooking-mode { white-space: nowrap; }

    /* ============ NOTAS ============ */
    .recipe-notes {
      margin-top: var(--s-7);
      padding: var(--s-5);
      background: var(--surface);
      border-radius: var(--r-md);
      border-left: 3px solid var(--terracota);
    }
    .notes-title {
      font-family: var(--font-display);
      font-weight: 600;
      font-size: var(--fs-h3);
      margin-bottom: var(--s-2);
    }
    .recipe-notes p {
      font-family: var(--font-mono);
      color: var(--ink-soft);
      line-height: var(--lh-loose);
    }

    /* ============ TOAST ============ */
    .toast {
      position: fixed;
      bottom: var(--s-6);
      left: 50%;
      transform: translateX(-50%) translateY(8px);
      background: var(--ink);
      color: var(--bg);
      padding: 10px 16px;
      border-radius: var(--r-pill);
      font-family: var(--font-mono);
      font-size: var(--fs-small);
      display: inline-flex;
      align-items: center;
      gap: 8px;
      z-index: 200;
      opacity: 0;
      transition: opacity var(--dur-base), transform var(--dur-base);
      pointer-events: none;
    }
    .toast :global(svg) { fill: none; stroke: currentColor; }
    .toast.show {
      opacity: 1;
      transform: translateX(-50%) translateY(0);
    }

    /* ============ MOBILE ============ */
    @media (max-width: 768px) {
      .recipe { padding: calc(var(--header-h) + var(--s-5)) var(--s-4) var(--s-7); }
      .body { grid-template-columns: 1fr; gap: var(--s-5); }
      .ingredients-col { position: static; }
      .steps-header { flex-direction: column; align-items: flex-start; }
      .cooking-mode { width: 100%; justify-content: center; }
    }

    /* ============ PRINT ============ */
    @media print {
      :global(body) {
        background: white !important;
        color: black !important;
      }
      :global(body.dark-mode) {
        background: white !important;
        color: black !important;
      }
      .site-header, .back-link, .hero, .unit-toggle, .portion-slider,
      .steps-header :global(.cooking-mode), .share, .toast, .cm-overlay {
        display: none !important;
      }
      .recipe {
        max-width: 100%;
        padding: 0;
        margin: 0;
      }
      .body {
        grid-template-columns: 1fr;
        display: block;
      }
      .ingredients-col, .steps-col {
        padding: 0;
        margin: 0 0 16pt 0;
      }
      .ingredients-col {
        position: static;
        margin-bottom: 24pt;
        page-break-inside: avoid;
      }
      .steps-header {
        display: block;
        margin-bottom: 0;
      }
      .recipe-title {
        font-size: 24pt;
        margin-bottom: 6pt;
      }
      .recipe-meta {
        font-size: 10pt;
        color: #444 !important;
        margin-bottom: 12pt;
      }
      .recipe-description {
        font-size: 11pt;
        line-height: 1.5;
        font-style: italic;
        color: #333 !important;
        margin-bottom: 16pt;
      }
      .section-title {
        font-size: 13pt;
        font-weight: 700;
        margin-bottom: 8pt;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        border-bottom: 1px solid black;
        padding-bottom: 2pt;
      }
      .ingredient-list, .material-list {
        font-size: 11pt;
        line-height: 1.6;
      }
      .ingredient-list li, .material-list li {
        border-bottom: none !important;
      }
      .materials-title {
        border-top: none !important;
        padding-top: 0 !important;
      }
      .step-list { counter-reset: step; }
      .step {
        page-break-inside: avoid;
        border-bottom: none;
        padding: 6pt 0;
      }
      .step-num {
        background: black !important;
        color: white !important;
      }
      .step p { font-size: 11pt; line-height: 1.5; }
      .recipe-notes {
        page-break-inside: avoid;
        background: #f5f5f5 !important;
        border-left-color: black !important;
      }
      .recipe-added {
        color: #666 !important;
        font-size: 9pt;
        margin-bottom: 16pt;
      }
      .recipe-added :global(svg) { display: none; }
      a { color: black !important; text-decoration: none !important; }
      .print-footer {
        display: flex !important;
        justify-content: space-between;
        align-items: baseline;
        gap: 12pt;
        margin-top: 24pt;
        padding-top: 8pt;
        border-top: 1px solid #ccc;
        font-size: 9pt;
        color: #666 !important;
        font-family: 'Helvetica', sans-serif;
      }
      .pf-credit { font-style: italic; }
      .pf-sep { display: none; }
    }
  </style>

  <script>
    document.getElementById('dark-toggle')?.addEventListener('click', () => {
      document.body.classList.toggle('dark-mode');
      try {
        localStorage.setItem('cozy-dark-mode',
          document.body.classList.contains('dark-mode') ? 'true' : 'false');
      } catch (err) {}
    });

    // ============ CARROSSEL ============
    const track = document.getElementById('carousel-track');
    const dots = document.querySelectorAll<HTMLElement>('.carousel-dots .dot');
    const prevBtn = document.querySelector<HTMLButtonElement>('.carousel-arrow.prev');
    const nextBtn = document.querySelector<HTMLButtonElement>('.carousel-arrow.next');
    const total = dots.length || 1;
    let idx = 0;

    function go(i: number) {
      idx = Math.max(0, Math.min(total - 1, i));
      if (track) track.style.transform = `translateX(${-idx * 100}%)`;
      dots.forEach((d, di) => {
        d.classList.toggle('active', di === idx);
        d.setAttribute('aria-selected', di === idx ? 'true' : 'false');
      });
      if (prevBtn) prevBtn.disabled = idx === 0;
      if (nextBtn) nextBtn.disabled = idx === total - 1;
    }

    prevBtn?.addEventListener('click', () => go(idx - 1));
    nextBtn?.addEventListener('click', () => go(idx + 1));
    dots.forEach((d, di) => d.addEventListener('click', () => go(di)));

    // Swipe em mobile
    if (track && total > 1) {
      let startX = 0;
      let startY = 0;
      let dragging = false;
      const viewport = track.parentElement;
      viewport?.addEventListener('touchstart', (e) => {
        startX = e.touches[0].clientX;
        startY = e.touches[0].clientY;
        dragging = true;
      }, { passive: true });
      viewport?.addEventListener('touchend', (e) => {
        if (!dragging) return;
        dragging = false;
        const dx = e.changedTouches[0].clientX - startX;
        const dy = e.changedTouches[0].clientY - startY;
        // Só considera horizontal se passou de 40px e não foi mais vertical que horizontal
        if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) {
          if (dx < 0) go(idx + 1);
          else go(idx - 1);
        }
      }, { passive: true });
    }

    // Teclado quando o carrossel está em foco visual (mas só se mais de um item)
    if (total > 1) {
      document.addEventListener('keydown', (e) => {
        // Não interfere quando está digitando ou no modo cozinha
        const tag = (document.activeElement?.tagName ?? '').toLowerCase();
        if (tag === 'input' || tag === 'textarea') return;
        if (!document.getElementById('cooking-mode')?.hasAttribute('hidden')) return;
        if (e.key === 'ArrowLeft') go(idx - 1);
        else if (e.key === 'ArrowRight') go(idx + 1);
      });
    }

    go(0);

    // ============ SHARE ============
    const toastEl = document.getElementById('toast');
    const toastMsgEl = document.getElementById('toast-msg');
    let toastTimer: number | undefined;
    function toast(msg: string) {
      if (!toastEl || !toastMsgEl) return;
      toastMsgEl.textContent = msg;
      toastEl.removeAttribute('hidden');
      requestAnimationFrame(() => toastEl.classList.add('show'));
      window.clearTimeout(toastTimer);
      toastTimer = window.setTimeout(() => {
        toastEl.classList.remove('show');
        window.setTimeout(() => toastEl.setAttribute('hidden', ''), 300);
      }, 2200);
    }

    document.getElementById('share-whatsapp')?.addEventListener('click', () => {
      const title = document.querySelector('.recipe-title')?.textContent?.trim() ?? '';
      const text = `Olha essa receita: ${title} — ${window.location.href}`;
      window.open(`https://wa.me/?text=${encodeURIComponent(text)}`, '_blank', 'noopener');
    });

    document.getElementById('share-copy')?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(window.location.href);
        toast('link copiado');
      } catch (e) {
        // Fallback se o clipboard API estiver bloqueado (http, permissões etc)
        const textarea = document.createElement('textarea');
        textarea.value = window.location.href;
        textarea.style.position = 'fixed';
        textarea.style.opacity = '0';
        document.body.appendChild(textarea);
        textarea.select();
        try { document.execCommand('copy'); toast('link copiado'); }
        catch (err) { toast('não consegui copiar'); }
        document.body.removeChild(textarea);
      }
    });

    // Atualiza a data do rodapé de impressão antes de imprimir
    function setPrintDate() {
      const el = document.getElementById('print-date');
      if (!el) return;
      el.textContent = new Intl.DateTimeFormat('pt-BR', {
        day: 'numeric', month: 'long', year: 'numeric',
      }).format(new Date());
    }
    setPrintDate();
    window.addEventListener('beforeprint', setPrintDate);

    document.getElementById('share-print')?.addEventListener('click', () => {
      window.print();
    });

    // ============ INGREDIENTES — porções + unidades ============
    const range = document.getElementById('portion-range') as HTMLInputElement | null;
    const portionValue = document.getElementById('portion-value');
    const metaServings = document.getElementById('meta-servings');
    const ingredientList = document.getElementById('ingredient-list');
    const originalServings = parseInt(ingredientList?.dataset.originalServings ?? '1', 10);
    const ingredientItems = ingredientList?.querySelectorAll<HTMLElement>('li[data-source]');
    const unitBtns = document.querySelectorAll<HTMLButtonElement>('.unit-btn');
    let unitMode: 'metric' | 'imperial' = 'metric';

    const KNOWN_UNITS = ['g','kg','mg','ml','l','cl','dl','xícara','xícaras','colher','colheres','copo','copos'];

    function parseQty(line: string) {
      const m = line.match(/^(\d+\/\d+|\d+(?:[.,]\d+)?)(\s*)(.*)$/);
      if (!m) return null;
      let qty: number;
      if (m[1].includes('/')) {
        const [a, b] = m[1].split('/').map(Number);
        if (!b) return null;
        qty = a / b;
      } else {
        qty = parseFloat(m[1].replace(',', '.'));
      }
      if (!isFinite(qty) || qty === 0) return null;

      let unit: string | null = null;
      let rest = m[3];
      const um = m[3].match(/^([a-zA-ZçÇãÃáÁéÉíÍóÓúÚ]+\.?)(\s+|$)/);
      if (um && KNOWN_UNITS.includes(um[1].toLowerCase())) {
        unit = um[1];
        rest = m[3].slice(um[1].length).replace(/^\s+/, '');
      }
      return { qty, sep: m[2], unit, rest };
    }

    const COMMON: ReadonlyArray<readonly [number, string]> = [
      [0.25, '¼'], [1/3, '⅓'], [0.5, '½'], [2/3, '⅔'], [0.75, '¾'],
    ];
    function formatQty(n: number, decimalSep = ','): string {
      if (n < 0.05) return '0';
      const rounded = Math.round(n * 100) / 100;
      if (Math.abs(rounded - Math.round(rounded)) < 0.05) return String(Math.round(rounded));
      for (const [val, glyph] of COMMON) {
        if (Math.abs(rounded - val) < 0.04) return glyph;
      }
      const whole = Math.floor(rounded);
      const frac = rounded - whole;
      for (const [val, glyph] of COMMON) {
        if (Math.abs(frac - val) < 0.04) return `${whole} ${glyph}`;
      }
      return rounded.toFixed(1).replace('.', decimalSep);
    }

    // Converte (qty, unidade) métrico → imperial. Retorna null quando a unidade
    // não tem equivalente direto (ex: xícara, colher) — nesse caso só escala.
    function toImperial(qty: number, unit: string): { qty: number; label: string } | null {
      const u = unit.toLowerCase();
      if (u === 'g')  return qty >= 454 ? { qty: qty / 453.592, label: 'lb' } : { qty: qty * 0.03527, label: 'oz' };
      if (u === 'kg') return { qty: qty * 2.205, label: 'lb' };
      if (u === 'mg') return { qty: qty * 0.0000353, label: 'oz' };
      if (u === 'ml') {
        if (qty < 8)   return { qty: qty / 4.929,  label: 'tsp' };
        if (qty < 45)  return { qty: qty / 14.787, label: 'tbsp' };
        if (qty < 240) return { qty: qty / 29.574, label: 'fl oz' };
        return { qty: qty / 240, label: 'cup' };
      }
      if (u === 'l')  return { qty: qty * 4.227, label: 'cup' };
      if (u === 'cl') return { qty: qty / 2.957, label: 'fl oz' };
      if (u === 'dl') return { qty: qty * 3.381, label: 'fl oz' };
      return null;
    }

    // Cozinha não exige precisão de 0.1 oz — arredonda por unidade pra ficar legível.
    function roundForLabel(qty: number, label: string): number {
      if (label === 'oz' || label === 'fl oz') {
        if (qty >= 5) return Math.round(qty);
        if (qty >= 1) return Math.round(qty * 2) / 2;
        return Math.round(qty * 4) / 4;
      }
      if (label === 'lb') return Math.round(qty * 10) / 10;
      if (label === 'cup') {
        if (qty >= 3) return Math.round(qty * 2) / 2;
        return Math.round(qty * 4) / 4;
      }
      return Math.round(qty * 4) / 4; // tbsp, tsp
    }

    function rebuild() {
      if (!ingredientItems) return;
      const servings = parseInt(range?.value ?? String(originalServings), 10);
      const ratio = servings / originalServings;

      ingredientItems.forEach((li) => {
        const src = li.dataset.source ?? '';
        const parsed = parseQty(src);
        if (!parsed) { li.textContent = src; return; }

        const newQty = parsed.qty * ratio;

        if (unitMode === 'imperial' && parsed.unit) {
          const conv = toImperial(newQty, parsed.unit);
          if (conv) {
            const rounded = roundForLabel(conv.qty, conv.label);
            const label = (rounded > 1 && conv.label === 'cup') ? 'cups' : conv.label;
            li.textContent = `${formatQty(rounded, '.')} ${label}${parsed.rest ? ' ' + parsed.rest : ''}`;
            return;
          }
        }

        // Métrico (ou imperial sem conversão direta)
        const unitStr = parsed.unit ?? '';
        const after = unitStr && parsed.rest ? ' ' + parsed.rest : (parsed.rest || '');
        li.textContent = `${formatQty(newQty)}${parsed.sep}${unitStr}${after}`;
      });
    }

    range?.addEventListener('input', () => {
      const v = parseInt(range.value, 10);
      if (portionValue) portionValue.textContent = String(v);
      if (metaServings) metaServings.textContent = String(v);
      rebuild();
    });

    unitBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        unitBtns.forEach((b) => {
          b.classList.remove('active');
          b.setAttribute('aria-selected', 'false');
        });
        btn.classList.add('active');
        btn.setAttribute('aria-selected', 'true');
        unitMode = (btn.dataset.unit === 'imperial') ? 'imperial' : 'metric';
        rebuild();
      });
    });
  </script>
</BaseLayout>
