---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';
import { getCollection, render } from 'astro:content';
import { CATEGORY_META } from '../../lib/categories';

export async function getStaticPaths() {
  const recipes = await getCollection('recipes', ({ data }) => data.published);
  return recipes.map((recipe) => ({
    params: { slug: recipe.id },
    props: { recipe },
  }));
}

const { recipe } = Astro.props;
const data = recipe.data;
const category = CATEGORY_META[data.category];
const coverMedia = data.media.find((m) => m.cover) ?? data.media[0];
const otherMedia = data.media.filter((m) => m !== coverMedia);
---

<BaseLayout title={data.title} description={data.description}>
  <header class="site-header">
    <a href="/" class="logo-link" aria-label="Cozy Corner">
      <span class="logo-name">Cozy Corner</span>
      <span class="logo-by">recipes by Gigi</span>
    </a>
    <button class="dark-toggle" id="dark-toggle" type="button" aria-label="alternar dark mode">
      <Icon name="ph:lightbulb-thin" class="icon-light" width={20} height={20} />
      <Icon name="ph:moon-thin" class="icon-dark" width={20} height={20} />
    </button>
  </header>

  <main class="recipe">
    <a href={`/categorias/${data.category}`} class="back-link">
      <Icon name="ph:arrow-left-thin" /> {category.label}
    </a>

    <!-- ============ CAROUSEL ============ -->
    <section class="hero" aria-label="Galeria da receita">
      <div class="carousel">
        <button class="carousel-arrow prev" aria-label="anterior">
          <Icon name="ph:caret-left-thin" width={22} height={22} />
        </button>
        <div class="carousel-stage">
          {coverMedia ? (
            <div class="media-slot">
              {coverMedia.type === 'video'
                ? <span class="placeholder">vídeo · {coverMedia.alt ?? 'sem descrição'}</span>
                : <span class="placeholder">foto · {coverMedia.alt ?? 'sem descrição'}</span>}
            </div>
          ) : (
            <div class="media-slot">
              <span class="placeholder">sem mídia ainda</span>
            </div>
          )}
        </div>
        <button class="carousel-arrow next" aria-label="próximo">
          <Icon name="ph:caret-right-thin" width={22} height={22} />
        </button>
      </div>
      {data.media.length > 1 && (
        <div class="carousel-dots" aria-hidden="true">
          {data.media.map((m, i) => (
            <span class={`dot ${i === 0 ? 'active' : ''} ${m.type === 'video' ? 'video' : ''}`}></span>
          ))}
        </div>
      )}
    </section>

    <!-- ============ TÍTULO + META ============ -->
    <section class="titlebar">
      <h1 class="recipe-title">{data.title}</h1>
      <p class="recipe-meta">
        <Icon name="ph:clock-thin" /> {data.time} min
        <span class="sep">·</span>
        <Icon name="ph:fork-knife-thin" /> {data.servings} porções
        <span class="sep">·</span>
        <Icon name="ph:gauge-thin" /> {data.difficulty}
        {data.tags.includes('vegetariana') && (
          <>
            <span class="sep">·</span>
            <Icon name="ph:plant-thin" /> vegetariana
          </>
        )}
      </p>
      {data.description && <p class="recipe-description">{data.description}</p>}
    </section>

    <!-- ============ BODY ============ -->
    <section class="body">
      <aside class="ingredients-col">
        <h2 class="section-title">Ingredientes</h2>
        <div class="unit-toggle" role="tablist" aria-label="Sistema de unidades">
          <button class="unit-btn active" type="button" aria-selected="true">métrico</button>
          <button class="unit-btn" type="button" aria-selected="false">imperial</button>
        </div>

        <ul class="ingredient-list">
          {data.ingredients.map((ing) => <li>{ing}</li>)}
        </ul>

        <div class="portion-slider">
          <label>
            <span class="portion-label">ajustar porções: <strong>{data.servings}</strong></span>
            <input type="range" min="1" max="12" value={data.servings} />
          </label>
        </div>

        {data.materials.length > 0 && (
          <>
            <h2 class="section-title materials-title">Materiais</h2>
            <ul class="material-list">
              {data.materials.map((m) => (
                <li>
                  <Icon name="ph:wrench-thin" width={14} height={14} />
                  {m}
                </li>
              ))}
            </ul>
          </>
        )}
      </aside>

      <div class="steps-col">
        <div class="steps-header">
          <h2 class="section-title">Modo de preparo</h2>
          <button class="btn btn-primary cooking-mode" type="button">
            <Icon name="ph:cooking-pot-thin" /> Modo cozinha
          </button>
        </div>

        <ol class="step-list">
          {data.steps.map((step, i) => (
            <li class="step">
              <span class="step-num">{i + 1}</span>
              <p>{step}</p>
            </li>
          ))}
        </ol>

        <div class="share">
          <button class="btn btn-primary" type="button">
            <Icon name="ph:whatsapp-logo-thin" /> Mandar pro WhatsApp
          </button>
          <button class="btn btn-ghost" type="button">
            <Icon name="ph:link-thin" /> Copiar link
          </button>
          <button class="btn btn-ghost" type="button">
            <Icon name="ph:printer-thin" /> Imprimir
          </button>
        </div>

        {data.notes && (
          <aside class="recipe-notes">
            <h3 class="notes-title">Notas</h3>
            <p>{data.notes}</p>
          </aside>
        )}
      </div>
    </section>
  </main>

  <style>
    /* ============ HEADER ============ */
    .site-header {
      position: fixed;
      top: 0; left: 0; right: 0;
      height: var(--header-h);
      padding: 0 var(--s-6);
      display: flex;
      align-items: center;
      justify-content: space-between;
      z-index: 100;
      background: rgba(250, 246, 238, 0.85);
      backdrop-filter: blur(8px);
      border-bottom: 1px solid var(--line-soft);
    }
    body.dark-mode .site-header { background: rgba(15, 26, 42, 0.85); }
    .logo-link {
      text-decoration: none;
      display: flex;
      flex-direction: column;
      line-height: 1.1;
    }
    .logo-name {
      font-family: var(--font-brand);
      font-weight: 600;
      font-size: 22px;
      line-height: 1;
      letter-spacing: 0;
    }
    .logo-by {
      font-family: var(--font-mono);
      font-size: 10px;
      color: var(--ink-soft);
      margin-top: 1px;
    }
    .dark-toggle {
      width: 36px; height: 36px;
      background: transparent;
      border: 1px solid var(--line);
      border-radius: var(--r-pill);
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      transition: transform var(--dur-fast);
    }
    .dark-toggle:hover { transform: scale(1.05); }
    .icon-dark { display: none; }
    body.dark-mode .icon-light { display: none; }
    body.dark-mode .icon-dark { display: inline-block; }

    /* ============ MAIN ============ */
    .recipe {
      max-width: 1000px;
      margin: 0 auto;
      padding: calc(var(--header-h) + var(--s-7)) var(--s-6) var(--s-9);
    }

    .back-link {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-family: var(--font-mono);
      font-size: var(--fs-meta);
      color: var(--ink-soft);
      text-decoration: none;
      margin-bottom: var(--s-5);
    }
    .back-link:hover { color: var(--terracota); }

    /* ============ CAROUSEL ============ */
    .hero {
      margin-bottom: var(--s-6);
    }
    .carousel {
      position: relative;
    }
    .carousel-stage {
      aspect-ratio: 16/9;
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--r-md);
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }
    .media-slot {
      width: 100%; height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .placeholder {
      font-family: var(--font-mono);
      font-size: var(--fs-small);
      color: var(--ink-mute);
    }
    .carousel-arrow {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      width: 44px; height: 44px;
      border-radius: var(--r-pill);
      background: var(--bg);
      border: 1px solid var(--line);
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      z-index: 2;
      box-shadow: var(--shadow-1);
      transition: transform var(--dur-fast);
    }
    .carousel-arrow:hover { transform: translateY(-50%) scale(1.05); }
    .carousel-arrow.prev { left: var(--s-3); }
    .carousel-arrow.next { right: var(--s-3); }
    .carousel-dots {
      display: flex;
      gap: 8px;
      justify-content: center;
      margin-top: var(--s-3);
    }
    .carousel-dots .dot {
      width: 8px; height: 8px;
      border-radius: var(--r-pill);
      background: var(--line);
      transition: width var(--dur-fast), background var(--dur-fast);
    }
    .carousel-dots .dot.active {
      background: var(--ink);
      width: 24px;
      border-radius: var(--r-sm);
    }
    .carousel-dots .dot.video {
      background: var(--ink-mute);
      border: 1px solid var(--ink-soft);
    }

    /* ============ TITLEBAR ============ */
    .titlebar { margin-bottom: var(--s-7); }
    .recipe-title {
      font-family: var(--font-display);
      font-weight: 500;
      font-size: var(--fs-h1);
      letter-spacing: -0.02em;
      line-height: var(--lh-tight);
      margin-bottom: var(--s-2);
    }
    .recipe-meta {
      display: inline-flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--s-2);
      font-family: var(--font-mono);
      font-size: var(--fs-meta);
      color: var(--ink-soft);
    }
    .recipe-meta svg { vertical-align: -0.15em; margin-right: 2px; }
    .recipe-meta .sep { opacity: 0.4; margin: 0 2px; }
    .recipe-description {
      margin-top: var(--s-4);
      max-width: var(--max-text);
      color: var(--ink-soft);
      line-height: var(--lh-loose);
    }

    /* ============ BODY ============ */
    .body {
      display: grid;
      grid-template-columns: 280px 1fr;
      gap: var(--s-7);
    }
    .section-title {
      font-family: var(--font-display);
      font-weight: 600;
      font-size: var(--fs-h3);
      letter-spacing: -0.005em;
      margin-bottom: var(--s-3);
    }

    /* ============ INGREDIENTES ============ */
    .ingredients-col {
      position: sticky;
      top: calc(var(--header-h) + var(--s-5));
      align-self: start;
      padding: var(--s-5);
      background: var(--surface);
      border-radius: var(--r-md);
    }
    .unit-toggle {
      display: inline-flex;
      gap: 2px;
      background: var(--bg);
      border: 1px solid var(--line);
      border-radius: var(--r-pill);
      padding: 2px;
      margin-bottom: var(--s-4);
    }
    .unit-btn {
      background: transparent;
      border: none;
      font: inherit;
      font-size: var(--fs-caption);
      color: var(--ink-soft);
      padding: 4px 12px;
      border-radius: var(--r-pill);
      cursor: pointer;
    }
    .unit-btn.active {
      background: var(--ink);
      color: var(--bg);
    }
    .ingredient-list {
      list-style: none;
      margin-bottom: var(--s-4);
    }
    .ingredient-list li {
      padding: var(--s-2) 0;
      border-bottom: 1px solid var(--line-soft);
      font-size: var(--fs-body);
    }
    .ingredient-list li:last-child { border-bottom: none; }

    .portion-slider {
      margin-bottom: var(--s-5);
      font-size: var(--fs-small);
      color: var(--ink-soft);
    }
    .portion-slider input {
      width: 100%;
      margin-top: 6px;
      accent-color: var(--terracota);
    }
    .portion-slider strong { color: var(--ink); font-weight: 500; }

    .materials-title {
      margin-top: var(--s-5);
      padding-top: var(--s-4);
      border-top: 1px solid var(--line-soft);
    }
    .material-list {
      list-style: none;
    }
    .material-list li {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: var(--s-2) 0;
      font-size: var(--fs-small);
      color: var(--ink-soft);
    }

    /* ============ STEPS ============ */
    .steps-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--s-3);
      margin-bottom: var(--s-4);
    }
    .steps-header .section-title { margin-bottom: 0; }

    .step-list {
      list-style: none;
    }
    .step {
      display: grid;
      grid-template-columns: 32px 1fr;
      gap: var(--s-4);
      padding: var(--s-4) 0;
      border-bottom: 1px solid var(--line-soft);
    }
    .step:last-child,
    .step:has(+ .share) { border-bottom: none; }
    .step-num {
      font-family: var(--font-mono);
      font-size: var(--fs-h3);
      color: var(--terracota);
    }
    .step p {
      font-family: var(--font-mono);
      line-height: var(--lh-loose);
    }

    /* ============ SHARE ============ */
    .share {
      margin-top: var(--s-2);
      padding-top: var(--s-6);
      display: flex;
      flex-wrap: wrap;
      gap: var(--s-3);
      border-top: 1px solid var(--line-soft);
    }

    /* ============ BUTTONS ============ */
    .btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 10px 14px;
      border-radius: var(--r-sm);
      font: inherit;
      font-size: var(--fs-small);
      cursor: pointer;
      border: 1px solid transparent;
      transition: opacity var(--dur-fast), transform var(--dur-fast), background var(--dur-base);
    }
    .btn:hover { transform: translateY(-1px); }
    .btn-primary {
      background: var(--terracota);
      color: white;
      border-color: var(--terracota);
    }
    .btn-primary:hover { opacity: 0.92; }
    .btn-ghost {
      background: transparent;
      color: var(--ink);
      border-color: var(--line);
    }
    .btn-ghost:hover { background: var(--surface); }
    .cooking-mode { white-space: nowrap; }

    /* ============ NOTAS ============ */
    .recipe-notes {
      margin-top: var(--s-7);
      padding: var(--s-5);
      background: var(--surface);
      border-radius: var(--r-md);
      border-left: 3px solid var(--terracota);
    }
    .notes-title {
      font-family: var(--font-display);
      font-weight: 600;
      font-size: var(--fs-h3);
      margin-bottom: var(--s-2);
    }
    .recipe-notes p {
      font-family: var(--font-mono);
      color: var(--ink-soft);
      line-height: var(--lh-loose);
    }

    /* ============ MOBILE ============ */
    @media (max-width: 768px) {
      .recipe { padding: calc(var(--header-h) + var(--s-5)) var(--s-4) var(--s-7); }
      .body { grid-template-columns: 1fr; gap: var(--s-5); }
      .ingredients-col { position: static; }
      .steps-header { flex-direction: column; align-items: flex-start; }
      .cooking-mode { width: 100%; justify-content: center; }
    }
  </style>

  <script>
    document.getElementById('dark-toggle')?.addEventListener('click', () => {
      document.body.classList.toggle('dark-mode');
      try {
        localStorage.setItem('cozy-dark-mode',
          document.body.classList.contains('dark-mode') ? 'true' : 'false');
      } catch (err) {}
    });

    // Unit toggle (visual only por enquanto — lógica de conversão vem depois)
    document.querySelectorAll('.unit-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        target.parentElement?.querySelectorAll('.unit-btn').forEach((b) => b.classList.remove('active'));
        target.classList.add('active');
      });
    });
  </script>
</BaseLayout>
