---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';
import { getCollection } from 'astro:content';
import { CATEGORY_META } from '../../lib/categories';
import { recipeSlug } from '../../lib/slug';

export async function getStaticPaths() {
  const allRecipes = await getCollection('recipes', ({ data }) => data.published);

  // Coleta tags distintivas de uma lista de receitas — exclui tags que aparecem
  // em 100% (são redundantes como filtro)
  function distinctiveTags(rs) {
    const count = new Map();
    for (const r of rs) for (const t of r.data.tags) count.set(t, (count.get(t) ?? 0) + 1);
    if (rs.length <= 1) return [...count.keys()];
    return [...count.entries()].filter(([, n]) => n < rs.length).map(([t]) => t);
  }

  // Helper: ordena receitas alfabeticamente por título (case/acento-insensible).
  const sortByTitle = (rs) => [...rs].sort((a, b) =>
    a.data.title.localeCompare(b.data.title, 'pt', { sensitivity: 'base' })
  );

  // Uma página por categoria + uma especial 'todas'.
  // Todas as listas saem em ordem alfabética.
  const paths = Object.entries(CATEGORY_META).map(([slug, meta]) => {
    const catRecipes = sortByTitle(allRecipes.filter((r) => r.data.category.includes(slug as any)));
    return {
      params: { slug },
      props: {
        slug,
        label: meta.label,
        icon: meta.icon,
        hotspot: meta.hotspot,
        recipes: catRecipes,
        tags: distinctiveTags(catRecipes),
      },
    };
  });

  paths.push({
    params: { slug: 'todas' },
    props: {
      slug: 'todas',
      label: 'Todas as receitas',
      icon: 'ph:books-thin',
      hotspot: 'livros',
      recipes: sortByTitle(allRecipes),
      tags: [],
    },
  });

  return paths;
}

const { slug, label, icon, recipes, tags = [] } = Astro.props;
---

<BaseLayout title={label} description={`Receitas da categoria ${label}.`}>
  <header class="site-header">
    <a href="/" class="logo-link" data-fade aria-label="Cozy Corner">
      <span class="logo-name">Cozy Corner</span>
      <span class="logo-by">— by Gigi</span>
    </a>
    <button class="dark-toggle" id="dark-toggle" type="button" aria-label="alternar dark mode">
      <Icon name="ph:lightbulb-thin" class="icon-light" width={20} height={20} />
      <Icon name="ph:moon-thin" class="icon-dark" width={20} height={20} />
    </button>
  </header>

  <main class="category">
    <nav class="top-nav">
      <a href="/" class="back-link" data-fade>
        <Icon name="ph:arrow-left-thin" /> <span data-t="nav.back_to_kitchen">voltar pra cozinha</span>
      </a>
      {slug !== 'todas' && (
        <a href="/categorias/todas/" class="alt-link">
          <Icon name="ph:books-thin" /> <span data-t="nav.see_all_recipes">ver todas as receitas</span>
        </a>
      )}
    </nav>

    <div class="title-block">
      <Icon name={icon} class="category-icon" width={32} height={32} />
      <div>
        <h1 class="cat-title" data-t={`category.${slug}`}>{label}</h1>
        <p class="cat-count" data-cat-count={recipes.length}>
          {recipes.length} {recipes.length === 1 ? 'receita' : 'receitas'}
        </p>
      </div>
    </div>

    <div class="search">
      <Icon name="ph:magnifying-glass-thin" width={18} height={18} />
      <input
        class="search-input"
        type="search"
        id="search"
        placeholder="título, ingrediente ou tag..."
        data-t-attr="placeholder:search.placeholder_full"
        autocomplete="off"
      />
    </div>

    {slug === 'todas' ? (
      <div class="filters filters-cats">
        <button type="button" class="chip chip-active" data-cat="all"><span data-t="filter.all_categories">Todas</span></button>
        {Object.entries(CATEGORY_META).map(([catSlug, meta]) => (
          <button type="button" class="chip" data-cat={catSlug}>
            <Icon name={meta.icon} width={14} height={14} />
            <span data-t={`category.${catSlug}`}>{meta.label.toLowerCase()}</span>
          </button>
        ))}
      </div>
    ) : tags.length > 0 ? (
      <div class="filters">
        <button type="button" class="chip chip-active" data-tag="all" data-t="filter.all">todas</button>
        {tags.map((tag) => (
          <button type="button" class="chip" data-tag={tag}>{tag}</button>
        ))}
      </div>
    ) : null}

    {recipes.length === 0 ? (
      <div class="empty">
        <Icon name="ph:bowl-food-thin" width={64} height={64} />
        <h2 class="t-h2" data-t="meta.no_recipes_yet">ainda sem receitas por aqui</h2>
        <p class="empty-sub" data-t="meta.category_empty_sub">essa categoria está em construção. volte em breve, ou bisbilhote outras gavetas da cozinha.</p>
        <a href="/" class="btn btn-ghost" data-fade>
          <Icon name="ph:arrow-left-thin" /> <span data-t="nav.back_to_kitchen">voltar pra cozinha</span>
        </a>
      </div>
    ) : (
      <ul class="recipe-list" id="recipe-list">
        {recipes.map((r) => {
          // Inclui traduções nos haystacks de busca quando o schema tiver
          // campos *En/_en (ex.: titleEn, ingredientsEn). Hoje retornam
          // undefined e o filter remove. Quando rolar tradução de receitas
          // via Decap, isso passa a indexar PT + EN sem mais código.
          const d: any = r.data;
          const allTitles = [d.title, d.titleEn, d.title_en].filter(Boolean);
          const allDescs = [d.description, d.descriptionEn, d.description_en].filter(Boolean);
          const allIngredients = [...(d.ingredients || []), ...(d.ingredientsEn || []), ...(d.ingredients_en || [])];
          const allTags = [...(d.tags || []), ...(d.tagsEn || []), ...(d.tags_en || [])];
          return (
          <li
            class="recipe-item"
            data-title={allTitles.join(' ').toLowerCase()}
            data-description={allDescs.join(' ').toLowerCase()}
            data-ingredients={allIngredients.join(' ').toLowerCase()}
            data-tags={allTags.join(' ').toLowerCase()}
            data-tag-list={allTags.join('|')}
            data-time={r.data.time}
            data-difficulty={r.data.difficulty}
            data-cat={r.data.category.join('|')}
            data-ingredients-list={JSON.stringify(allIngredients)}
          >
            <a href={`/receitas/${recipeSlug(r)}/`}>
              {(() => {
                const cover = r.data.media.find((m) => m.cover) || r.data.media[0];
                return cover?.src ? (
                  <div class="thumb has-img"><img src={cover.src} alt={cover.alt || r.data.title} loading="lazy" /></div>
                ) : (
                  <div class="thumb" data-t="recipe.photo">foto</div>
                );
              })()}
              <div class="info">
                <h3 class="recipe-name-h">
                  <span class="recipe-name" data-lang="pt">{r.data.title}</span>
                  <span class="recipe-name-en" data-lang="en">{r.data.title_en || r.data.title}</span>
                </h3>
                {(() => {
                  // Cada metadata é um <span class="mi"> com icon + valor +
                  // label e (exceto o último) o separador "·" no FINAL. Ao
                  // quebrar linha, o "·" fica pendurado no fim da linha
                  // anterior e a nova linha começa limpa com o icone — sem
                  // deslocar o item pra direita.
                  const diffKey = r.data.difficulty === 'fácil' ? 'easy'
                    : r.data.difficulty === 'difícil' ? 'hard' : 'medium';
                  const innerItems = [
                    <><Icon name="ph:clock-thin" /> {r.data.time} <span data-t="meta.minutes">min</span></>,
                    r.data.servings ? (
                      <><Icon name="ph:fork-knife-thin" /> {r.data.servings} <span data-t="meta.servings_other">porções</span></>
                    ) : null,
                    <><Icon name="ph:gauge-thin" /> <span data-t={`meta.difficulty_${diffKey}`}>{r.data.difficulty}</span></>,
                  ].filter(Boolean);
                  const lastIdx = innerItems.length - 1;
                  return (
                    <p class="recipe-meta">
                      {innerItems.map((item, i) => (
                        <span class="mi">{item}{i < lastIdx && <span class="sep">·</span>}</span>
                      ))}
                    </p>
                  );
                })()}
                <p class="recipe-row-match" hidden></p>
              </div>
              <Icon name="ph:caret-right-thin" class="row-arrow" width={20} height={20} />
            </a>
          </li>
          );
        })}
      </ul>
    )}

    <div class="no-results" id="no-results" hidden>
      <Icon name="ph:magnifying-glass-thin" width={48} height={48} />
      <p data-t="search.no_results">nenhuma receita encontrada</p>
    </div>
  </main>

  <style>
    /* ============ HEADER ============ */
    .site-header {
      position: fixed;
      top: 0; left: 0; right: 0;
      height: var(--header-h);
      padding: 0 var(--s-6);
      display: flex;
      align-items: center;
      justify-content: space-between;
      z-index: 100;
      background: rgba(250, 246, 238, 0.85);
      backdrop-filter: blur(8px);
      border-bottom: 1px solid var(--line-soft);
    }
    body.dark-mode .site-header { background: rgba(15, 26, 42, 0.85); }
    .logo-link {
      text-decoration: none;
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      line-height: 1.1;
    }
    .logo-name { font-family: var(--font-brand); font-weight: 600; font-size: 22px; line-height: 1; }
    .logo-by { font-family: var(--font-mono); font-size: 12px; color: var(--ink-soft); margin-top: 1px; }
    .dark-toggle {
      width: 36px; height: 36px;
      /* appearance: none impede iOS Safari de aplicar o estilo nativo de
         botão (que renderiza o conteúdo SVG em azul tinted). */
      -webkit-appearance: none;
      appearance: none;
      background: transparent;
      border: 1px solid var(--line);
      border-radius: var(--r-pill);
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      color: var(--ink);
      padding: 0;
    }
    .icon-dark { display: none; }
    body.dark-mode .icon-light { display: none; }
    body.dark-mode .icon-dark { display: inline-block; }
    svg { fill: none; stroke: currentColor; }

    /* ============ MAIN ============ */
    .category {
      max-width: 800px;
      margin: 0 auto;
      padding: calc(var(--header-h) + var(--s-7)) var(--s-6) var(--s-9);
    }

    .top-nav {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: var(--s-2) var(--s-5);
      margin-bottom: var(--s-5);
    }
    .back-link, .alt-link {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-family: var(--font-mono);
      font-size: var(--fs-meta);
      color: var(--ink-soft);
      text-decoration: none;
    }
    .back-link:hover, .alt-link:hover { color: var(--terracota); }

    /* ============ TITLE ============ */
    .title-block {
      display: flex;
      align-items: center;
      gap: var(--s-4);
      margin-bottom: var(--s-6);
    }
    .category-icon { color: var(--terracota); flex-shrink: 0; }
    .cat-title {
      font-family: var(--font-display);
      font-weight: 500;
      font-size: var(--fs-h1);
      letter-spacing: -0.02em;
      line-height: var(--lh-tight);
    }
    .cat-count {
      font-family: var(--font-mono);
      font-size: var(--fs-meta);
      color: var(--ink-soft);
      margin-top: 4px;
    }

    /* ============ SEARCH ============ */
    .search {
      display: flex;
      align-items: center;
      gap: var(--s-3);
      padding: 12px 16px;
      border: 1px solid var(--line);
      border-radius: var(--r-sm);
      background: var(--surface);
      margin-bottom: var(--s-3);
      color: var(--ink-soft);
    }
    .search-input {
      flex: 1;
      background: transparent;
      border: none;
      font: inherit;
      font-family: var(--font-mono);
      font-size: var(--fs-small);
      outline: none;
      color: var(--ink);
    }
    .search-input::placeholder { color: var(--ink-soft); }

    /* ============ FILTERS ============ */
    .filters {
      display: flex;
      flex-wrap: wrap;
      gap: var(--s-2);
      margin-bottom: var(--s-6);
    }
    .chip {
      /* button reset — chips são <button> pra cliques nativos confiáveis
         em qualquer device (iOS Safari, Android, desktop). appearance:none
         tira o estilo padrão do button. */
      -webkit-appearance: none;
      appearance: none;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 4px 12px;
      border: 1px solid var(--line);
      border-radius: var(--r-pill);
      font-family: var(--font-mono);
      font-size: var(--fs-caption);
      cursor: pointer;
      background: var(--bg);
      color: var(--ink-soft);
      transition: all var(--dur-fast);
      user-select: none;
      /* touch-action: manipulation evita delay de 300ms em mobile e
         comportamento de double-tap-zoom em alguns iOS. */
      touch-action: manipulation;
    }
    .chip :global(svg) { fill: none; stroke: currentColor; flex: none; }
    /* Força todos os cliques nos filhos (svg, span interno do data-t) a
       chegarem direto no chip pai. Sem isso, iOS Safari às vezes não
       bubbla cliques de elementos inline aninhados de forma confiável,
       e o filtro não acionava em mobile. */
    .chip > * { pointer-events: none; }
    .chip:hover { border-color: var(--terracota); color: var(--ink); }
    .chip-active, .chip-active:hover {
      background: var(--ink);
      color: var(--bg);
      border-color: var(--ink);
    }

    /* ============ RECIPE LIST ============ */
    .recipe-list { list-style: none; }
    .recipe-item { border-bottom: 1px solid var(--line-soft); }
    .recipe-item a {
      display: grid;
      grid-template-columns: 96px 1fr 24px;
      gap: var(--s-4);
      padding: var(--s-4) 0;
      text-decoration: none;
      color: inherit;
      align-items: center;
      transition: background var(--dur-fast);
    }
    .recipe-item a:hover {
      background: var(--surface);
      padding-left: var(--s-3);
      padding-right: var(--s-3);
      margin: 0 calc(-1 * var(--s-3));
      border-radius: var(--r-sm);
    }
    .recipe-item a:hover .recipe-name,
    .recipe-item a:hover .recipe-name-en { color: var(--terracota); }
    .recipe-item a:hover .row-arrow { transform: translateX(4px); }

    .thumb {
      aspect-ratio: 1;
      background: var(--surface);
      border: 1px dashed var(--line);
      border-radius: var(--r-sm);
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-mono);
      font-size: 12px;
      color: var(--ink-soft);
      overflow: hidden;
    }
    .thumb.has-img {
      border: none;
      background: transparent;
    }
    .thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    /* H3 wrapper (.recipe-name-h) e os spans internos (.recipe-name +
       .recipe-name-en) compartilham o mesmo estilo. O h3 vira display:block
       padrão; os spans são inline mas o data-lang esconde o inativo. */
    .recipe-name-h,
    .recipe-name,
    .recipe-name-en {
      font-family: var(--font-display);
      font-weight: 600;
      font-size: var(--fs-h3);
      margin-bottom: 4px;
      transition: color var(--dur-fast);
    }
    .recipe-meta {
      display: inline-flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 4px;
      font-family: var(--font-mono);
      font-size: var(--fs-meta);
      color: var(--ink-soft);
    }
    /* Cada metadata é um wrapper inline-flex que mantém icon + valor + label
       (e o separador, quando presente) sempre juntos no wrap. Gap interno
       pequeno cuida do espaçamento entre sep e o resto do conteúdo. */
    .recipe-meta .mi {
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }
    .recipe-meta .mi .sep { opacity: 0.4; }
    /* SVGs dos icones meta: garantia explícita de tamanho/display.
       Sem `display: inline-block`, em alguns contextos (especialmente
       quando o svg fica direto dentro de um .mi inline span), a largura
       1em pode degenerar pra 0 e o icone some visualmente. */
    .recipe-meta svg {
      display: inline-block;
      width: 1em;
      height: 1em;
      vertical-align: -0.15em;
      margin-right: 2px;
      flex: none;
    }
    .recipe-meta .sep { opacity: 0.4; }
    /* Linha "em <ingrediente>" mostrada quando a busca casou num
       ingrediente/tag em vez do título. O conteúdo é injetado via JS
       (innerHTML), então as classes filhas (.recipe-match-hl no <mark>)
       precisam de :global() pra escapar do scope hash do Astro —
       senão o <mark> cai no estilo padrão amarelo do browser. */
    .recipe-row-match {
      font-family: var(--font-mono);
      font-size: var(--fs-caption);
      color: var(--ink-soft);
      margin-top: 4px;
    }
    .recipe-row-match :global(.recipe-match-hl),
    :global(mark.recipe-match-hl) {
      background: rgba(197, 107, 74, 0.15);
      color: var(--terracota);
      font-weight: 500;
      padding: 0 2px;
      border-radius: 2px;
    }
    .row-arrow {
      color: var(--ink-soft);
      transition: transform var(--dur-fast);
    }

    /* ============ EMPTY / NO RESULTS ============ */
    .empty, .no-results {
      text-align: center;
      padding: var(--s-8) var(--s-5);
      color: var(--ink-soft);
    }
    /* Filho direto só — pra não pegar SVGs dentro de botões/links aninhados. */
    .empty > svg, .no-results > svg {
      display: block;
      margin: 0 auto var(--s-4);
      color: var(--ink-soft);
    }
    .t-h2 {
      font-family: var(--font-display);
      font-weight: 500;
      font-size: var(--fs-h2);
      color: var(--ink);
      margin-bottom: var(--s-2);
    }
    .empty-sub {
      max-width: 480px;
      margin: 0 auto var(--s-6);
      font-family: var(--font-mono);
      line-height: var(--lh-loose);
    }
    .no-results p {
      font-family: var(--font-mono);
      font-size: var(--fs-small);
    }
    .btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 10px 14px;
      border-radius: var(--r-sm);
      font: inherit;
      font-size: var(--fs-small);
      cursor: pointer;
      text-decoration: none;
      border: 1px solid transparent;
    }
    .btn-ghost {
      background: transparent;
      color: var(--ink);
      border-color: var(--line);
    }
    .btn-ghost:hover { background: var(--surface); }

    @media (max-width: 640px) {
      .recipe-item a { grid-template-columns: 72px 1fr 20px; }
      .cat-title { font-size: 32px; }
    }
    /* Filtros viram trilho horizontal scrollável só em touch real (celular/
       tablet sem mouse). Em desktop responsivo (DevTools mobile, janela
       estreita), continuam fazendo wrap em múltiplas linhas — o trilho
       não é prático com mouse e estava dando problema. */
    @media (max-width: 640px) and (hover: none) and (pointer: coarse) {
      .filters {
        flex-wrap: nowrap;
        overflow-x: auto;
        scroll-snap-type: x proximity;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
        padding-right: var(--s-4);
      }
      .filters::-webkit-scrollbar { display: none; }
      .filters .chip {
        flex: 0 0 auto;
        scroll-snap-align: start;
      }
    }
    /* Em phones: encosta header mais nas bordas (32→16) pra que os
       toggles fiquem mais próximos da margem da tela. */
    @media (max-width: 600px) {
      .site-header { padding: 0 var(--s-4); }
    }
  </style>

  <script>
    // i18n — atualiza textos dinâmicos (count, placeholder search) baseado em window.__COZY_LANG
    const T = (window as any).__cozyT || ((k: string) => k);
    function syncI18n() {
      const T_ = (window as any).__cozyT;
      if (!T_) return;
      // count "X receitas"
      const countEl = document.querySelector('[data-cat-count]') as HTMLElement | null;
      if (countEl) {
        const n = Number(countEl.dataset.catCount || 0);
        const key = n === 1 ? 'search.results_count_one' : 'search.results_count_other';
        countEl.textContent = T_(key, { n });
      }
      // placeholder do search agora vem via data-t-attr=placeholder:search.placeholder_full
      // (resolvido pelo runtime de i18n do BaseLayout). Não precisa mais
      // setar dinamicamente aqui.
    }
    syncI18n();
    document.addEventListener('cozy-lang-changed', syncI18n);

    // Dark mode
    document.getElementById('dark-toggle')?.addEventListener('click', () => {
      document.body.classList.toggle('dark-mode');
      try {
        localStorage.setItem('cozy-dark-mode',
          document.body.classList.contains('dark-mode') ? 'true' : 'false');
      } catch (e) {}
    });

    // Search + filter ao vivo
    const searchInput = document.getElementById('search') as HTMLInputElement;
    const items = document.querySelectorAll<HTMLElement>('.recipe-item');
    const noResults = document.getElementById('no-results');
    const tagChips = document.querySelectorAll<HTMLElement>('[data-tag]');
    const catChips = document.querySelectorAll<HTMLElement>('[data-cat]:not(.recipe-item)');
    let activeTag = 'all';
    let activeCat = 'all';

    function normalizeSearch(s: string): string {
      return s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
    }
    const escHtml = (s: string) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    function highlightMatch(text: string, q: string): string {
      if (!q) return escHtml(text);
      const idx = normalizeSearch(text).indexOf(q);
      if (idx < 0) return escHtml(text);
      const before = text.slice(0, idx);
      const match  = text.slice(idx, idx + q.length);
      const after  = text.slice(idx + q.length);
      return `${escHtml(before)}<mark class="recipe-match-hl">${escHtml(match)}</mark>${escHtml(after)}`;
    }

    function applyFilters() {
      const qRaw = searchInput.value.trim();
      const q = normalizeSearch(qRaw);
      let visible = 0;
      items.forEach((item) => {
        const title = item.dataset.title || '';
        const description = item.dataset.description || '';
        const ingredients = item.dataset.ingredients || '';
        const tagsStr = item.dataset.tags || '';
        const tagList = (item.dataset.tagList || '').split('|').filter(Boolean);
        // data-cat agora é "principais|datas" — uma receita pode ter N categorias.
        const catList = (item.dataset.cat || '').split('|').filter(Boolean);

        // Match acento-insensible. Os data-attrs já vêm com PT + EN
        // concatenados (quando schema tiver tradução).
        const titleN = normalizeSearch(title);
        const descN = normalizeSearch(description);
        const ingN = normalizeSearch(ingredients);
        const tagsN = normalizeSearch(tagsStr);
        const matchesSearch = !q || titleN.includes(q) || descN.includes(q) || ingN.includes(q) || tagsN.includes(q);
        const matchesTag = activeTag === 'all' || tagList.includes(activeTag);
        const matchesCat = activeCat === 'all' || catList.includes(activeCat);

        const show = matchesSearch && matchesTag && matchesCat;
        item.style.display = show ? '' : 'none';
        if (show) visible++;

        // Destaca o trecho do TÍTULO que casa com a busca (igual o
        // drawer da home). Cache do título original em dataset.original
        // pra restaurar quando limpar a busca.
        const recipeNameEl = item.querySelector<HTMLElement>('.recipe-name');
        if (recipeNameEl) {
          if (!recipeNameEl.dataset.original) {
            recipeNameEl.dataset.original = recipeNameEl.textContent || '';
          }
          const originalTitle = recipeNameEl.dataset.original;
          if (show && q && titleN.includes(q)) {
            recipeNameEl.innerHTML = highlightMatch(originalTitle, q);
          } else {
            recipeNameEl.textContent = originalTitle;
          }
        }

        // Atualiza match-line: se a busca casou no título, não mostra
        // contexto extra. Se casou em ingrediente/tag, encontra o
        // primeiro match e mostra "em <ingrediente>".
        const matchLine = item.querySelector<HTMLElement>('.recipe-row-match');
        if (matchLine) {
          if (show && q && !titleN.includes(q)) {
            const ingList: string[] = (() => {
              try { return JSON.parse(item.dataset.ingredientsList || '[]'); } catch { return []; }
            })();
            let ctx: { kind: string, text: string } | null = null;
            for (const ing of ingList) {
              if (normalizeSearch(ing).includes(q)) { ctx = { kind: 'ingredient', text: ing }; break; }
            }
            if (!ctx) {
              for (const tag of tagList) {
                if (normalizeSearch(tag).includes(q)) { ctx = { kind: 'tag', text: tag }; break; }
              }
            }
            if (ctx) {
              const T_ = (window as any).__cozyT;
              const inLabel = ctx.kind === 'tag'
                ? (T_ ? T_('search.match_in_tag') : 'tag')
                : (T_ ? T_('search.match_in') : 'em');
              matchLine.innerHTML = `${escHtml(inLabel)} ${highlightMatch(ctx.text, q)}`;
              matchLine.removeAttribute('hidden');
            } else {
              matchLine.setAttribute('hidden', '');
            }
          } else {
            matchLine.setAttribute('hidden', '');
          }
        }
      });

      if (noResults) {
        if (visible === 0 && items.length > 0) noResults.removeAttribute('hidden');
        else noResults.setAttribute('hidden', '');
      }
    }

    searchInput?.addEventListener('input', applyFilters);

    // Chips agora são <button> com touch-action: manipulation — click
    // funciona nativamente em qualquer device. Listener simples direto
    // em cada chip.
    tagChips.forEach((chip) => {
      chip.addEventListener('click', () => {
        tagChips.forEach((c) => c.classList.remove('chip-active'));
        chip.classList.add('chip-active');
        activeTag = chip.dataset.tag || 'all';
        applyFilters();
      });
    });
    catChips.forEach((chip) => {
      chip.addEventListener('click', () => {
        catChips.forEach((c) => c.classList.remove('chip-active'));
        chip.classList.add('chip-active');
        activeCat = chip.dataset.cat || 'all';
        applyFilters();
      });
    });

    // Drag-to-scroll + wheel scroll no trilho de filtros. SÓ em devices com
    // mouse real (hover: hover). Em touch, mouse events são sintetizados a
    // partir de touch e podem interferir com o tap nos chips, impedindo o
    // filtro de funcionar. Em touch o swipe nativo já cuida do scroll.
    const canHoverFilter = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    if (canHoverFilter) {
      document.querySelectorAll<HTMLElement>('.filters').forEach((track) => {
        // ---- wheel (vertical → horizontal) ----
        track.addEventListener('wheel', (e) => {
          if (track.scrollWidth <= track.clientWidth) return;
          if (Math.abs(e.deltaX) > Math.abs(e.deltaY)) return;
          e.preventDefault();
          track.scrollLeft += e.deltaY;
        }, { passive: false });

        // ---- click-and-drag ----
        let isDown = false;
        let startX = 0;
        let startScrollLeft = 0;
        let movedDistance = 0;

        track.addEventListener('mousedown', (e) => {
          if (track.scrollWidth <= track.clientWidth) return;
          if (e.button !== 0) return;
          isDown = true;
          movedDistance = 0;
          startX = e.pageX;
          startScrollLeft = track.scrollLeft;
          track.classList.add('dragging');
        });
        document.addEventListener('mousemove', (e) => {
          if (!isDown) return;
          e.preventDefault();
          const dx = e.pageX - startX;
          movedDistance = Math.abs(dx);
          track.scrollLeft = startScrollLeft - dx;
        });
        document.addEventListener('mouseup', () => {
          if (!isDown) return;
          isDown = false;
          track.classList.remove('dragging');
        });
        track.addEventListener('click', (e) => {
          if (movedDistance > 5) {
            e.preventDefault();
            e.stopPropagation();
            movedDistance = 0;
          }
        }, true);
      });
    }
  </script>
</BaseLayout>
