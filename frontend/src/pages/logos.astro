---
import BaseLayout from '../layouts/BaseLayout.astro';

// "Cozy Corner" fixo em Caveat. Variando só o subtítulo "recipes by Gigi".
const subtitleVariants = [
  {
    id: 'a',
    name: 'A · Cutive Mono (atual)',
    desc: 'Typewriter delicado contrastando com o handwritten — mistura warm com nostálgico.',
    sub: 'recipes by Gigi',
    fontFamily: "'Cutive Mono', monospace",
    fontSize: 13,
    italic: false,
    weight: 400,
    opacity: 0.55,
  },
  {
    id: 'b',
    name: 'B · Caveat menor',
    desc: 'Mesma família handwritten — identidade unificada, mais suave.',
    sub: 'recipes by Gigi',
    fontFamily: 'Caveat, cursive',
    fontSize: 22,
    italic: false,
    weight: 500,
    opacity: 0.7,
  },
  {
    id: 'c',
    name: 'C · Inter italic light',
    desc: 'Minimalist sans em itálico leve — contraste editorial mas discreto.',
    sub: 'recipes by Gigi',
    fontFamily: 'Inter, sans-serif',
    fontSize: 13,
    italic: true,
    weight: 300,
    opacity: 0.7,
  },
  {
    id: 'd',
    name: 'D · Fraunces italic',
    desc: 'Serif italic refinada — sensação de capa de revista, autoral.',
    sub: 'recipes by Gigi',
    fontFamily: 'Fraunces, serif',
    fontSize: 16,
    italic: true,
    weight: 400,
    opacity: 0.65,
  },
  {
    id: 'e',
    name: 'E · Sacramento (script romântico)',
    desc: 'Script mais fluido e romântico — combina com o Caveat mas mais cursivo.',
    sub: 'recipes by Gigi',
    fontFamily: 'Sacramento, cursive',
    fontSize: 22,
    italic: false,
    weight: 400,
    opacity: 0.7,
  },
  {
    id: 'f',
    name: 'F · Só "by Gigi" — assinatura curta',
    desc: 'Remove "recipes", deixa só "by Gigi" como assinatura — mais limpo.',
    sub: '— by Gigi',
    fontFamily: "'Cutive Mono', monospace",
    fontSize: 13,
    italic: false,
    weight: 400,
    opacity: 0.55,
  },
];

function renderLogo(v: typeof subtitleVariants[number], height = 0) {
  const heightAttr = height > 0 ? `height="${height}"` : `width="320"`;
  const fontStyle = v.italic ? 'italic' : 'normal';
  return `
    <svg viewBox="0 0 480 160" ${heightAttr} xmlns="http://www.w3.org/2000/svg">
      <text x="240" y="86" font-family="Caveat, cursive" font-size="68" font-weight="600" text-anchor="middle" fill="currentColor">Cozy Corner</text>
      <text x="240" y="124" font-family="${v.fontFamily}" font-size="${v.fontSize}" font-style="${fontStyle}" font-weight="${v.weight}" text-anchor="middle" fill="currentColor" opacity="${v.opacity}">${v.sub}</text>
    </svg>
  `;
}
---

<BaseLayout title="Logo · subtitle iteration" description="Variações de subtítulo pro logo Cozy Corner">
  <style is:global>
    @import url('https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..600;1,9..144,300..600&family=Sacramento&display=swap');
  </style>

  <div class="logos-shell">
    <header class="logos-header">
      <p class="t-meta">/logos · subtítulo</p>
      <h1 class="logos-title">Iteração no subtítulo</h1>
      <p class="t-body" style="color: var(--ink-soft); margin-top: 8px; max-width: 600px;">
        "Cozy Corner" em Caveat fixo. Variando só o "recipes by Gigi" — 6 tratamentos pra você comparar.
      </p>
      <button class="dark-toggle" id="dark-toggle" type="button" aria-label="alternar dark mode">toggle dark</button>
    </header>

    {subtitleVariants.map((v) => (
      <section class="variant">
        <div class="variant-meta">
          <h2 class="variant-title">{v.name}</h2>
          <p class="t-small" style="color: var(--ink-soft);">{v.desc}</p>
          <p class="t-meta" style="color: var(--ink-soft); margin-top: 4px;">
            {v.fontFamily.split(',')[0]} · {v.fontSize}px · {v.italic ? 'italic' : 'normal'} · weight {v.weight}
          </p>
        </div>
        <div class="variant-previews">
          <div class="preview preview-light">
            <span class="preview-label">creme</span>
            <div class="logo-render" set:html={renderLogo(v)} />
          </div>
          <div class="preview preview-dark">
            <span class="preview-label">dark</span>
            <div class="logo-render" set:html={renderLogo(v)} />
          </div>
          <div class="preview preview-small">
            <span class="preview-label">tamanho header (~32px)</span>
            <div class="logo-render" set:html={renderLogo(v, 32)} />
          </div>
        </div>
      </section>
    ))}
  </div>

  <style>
    .logos-shell { max-width: 1200px; margin: 0 auto; padding: 48px 32px 96px; }
    .logos-header { margin-bottom: 64px; position: relative; }
    .t-meta { font-family: var(--font-mono); font-size: 12px; color: var(--ink-soft); }
    .logos-title { font-family: var(--font-display); font-weight: 500; font-size: 36px; letter-spacing: -0.02em; margin-top: 8px; }
    .t-body { font-family: var(--font-mono); }
    .t-small { font-family: var(--font-mono); font-size: 13px; }
    .dark-toggle {
      position: absolute; top: 0; right: 0;
      padding: 8px 14px;
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: 999px;
      font: inherit;
      font-family: var(--font-mono);
      font-size: 11px;
      cursor: pointer;
    }
    .variant { padding: 40px 0; border-top: 1px solid var(--line); }
    .variant-meta { margin-bottom: 24px; }
    .variant-title { font-family: var(--font-display); font-weight: 600; font-size: 18px; margin-bottom: 4px; }
    .variant-previews { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    .preview { position: relative; padding: 40px 24px; border-radius: 8px; min-height: 200px; display: flex; align-items: center; justify-content: center; }
    .preview-label { position: absolute; top: 12px; left: 16px; font-family: var(--font-mono); font-size: 10px; color: var(--ink-soft); text-transform: lowercase; }
    .preview-light { background: #FAF6EE; color: #1A1A1A; }
    .preview-dark { background: #0F1A2A; color: #F5F0E5; }
    .preview-dark .preview-label { color: rgba(255,255,255,0.4); }
    .preview-small { grid-column: 1 / -1; background: var(--surface); padding: 32px 24px; min-height: 100px; color: var(--ink); }
    @media (max-width: 768px) { .variant-previews { grid-template-columns: 1fr; } }
  </style>

  <script>
    document.getElementById('dark-toggle')?.addEventListener('click', () => {
      document.body.classList.toggle('dark-mode');
      try { localStorage.setItem('cozy-dark-mode', document.body.classList.contains('dark-mode') ? 'true' : 'false'); } catch (e) {}
    });
  </script>
</BaseLayout>
