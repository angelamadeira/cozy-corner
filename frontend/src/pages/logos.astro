---
import BaseLayout from '../layouts/BaseLayout.astro';

// 6 variações pra comparar: 3 geométricas + 3 orgânicas
const variants = [
  { id: 'v1', name: 'V1 · Inter outline', vibe: 'tipográfico, sans clean em outline fino', org: false },
  { id: 'v2', name: 'V2 · Inter outline + traço terracota', vibe: 'mesma base, assinatura sutil', org: false },
  { id: 'v3', name: 'V3 · Cutive Mono outline lowercase', vibe: 'typewriter delicado, "carta digitada"', org: false },
  { id: 'v4', name: 'V4 · Fraunces italic', vibe: 'serif variável italic — editorial, curvas orgânicas', org: true },
  { id: 'v5', name: 'V5 · Caveat handwritten', vibe: 'caligrafia neat — "manuscrito numa receita"', org: true },
  { id: 'v6', name: 'V6 · Homemade Apple', vibe: 'caligrafia mais autêntica, intimista', org: true },
];
---

<BaseLayout title="Logo Variations" description="Variações tipográficas line-art do logo Cozy Corner">
  <!-- Carrega Fraunces, Caveat e Homemade Apple só nessa página -->
  <style is:global>
    @import url('https://fonts.googleapis.com/css2?family=Caveat:wght@400;500;600&family=Fraunces:ital,opsz,wght@0,9..144,300..600;1,9..144,300..600&family=Homemade+Apple&display=swap');
  </style>

  <div class="logos-shell">
    <header class="logos-header">
      <p class="t-meta">/logos</p>
      <h1 class="logos-title">6 variações tipográficas</h1>
      <p class="t-body" style="color: var(--ink-soft); margin-top: 8px; max-width: 600px;">
        3 geométricas (Inter / Cutive Mono em outline) e 3 orgânicas (serif italic, handwritten). Cada uma em fundo claro, escuro e tamanho de header.
      </p>
      <button class="dark-toggle" id="dark-toggle" type="button" aria-label="alternar dark mode">toggle dark</button>
    </header>

    {variants.map((v) => (
      <section class="variant">
        <div class="variant-meta">
          <h2 class="variant-title">{v.name}{v.org && <span class="org-badge">orgânico</span>}</h2>
          <p class="t-small" style="color: var(--ink-soft);">{v.vibe}</p>
        </div>
        <div class="variant-previews">
          <div class={`preview preview-light ${v.id}`}>
            <span class="preview-label">creme</span>
            <div class="logo-render">
              {v.id === 'v1' && (
                <svg viewBox="0 0 480 140" width="320">
                  <text x="240" y="70" font-family="Inter, sans-serif" font-size="56" font-weight="500" letter-spacing="-1.5" text-anchor="middle" fill="none" stroke="currentColor" stroke-width="0.6">Cozy Corner</text>
                  <text x="240" y="108" font-family="Cutive Mono, monospace" font-size="14" text-anchor="middle" fill="currentColor" opacity="0.55">recipes by Gigi</text>
                </svg>
              )}
              {v.id === 'v2' && (
                <svg viewBox="0 0 480 140" width="320">
                  <text x="240" y="70" font-family="Inter, sans-serif" font-size="56" font-weight="500" letter-spacing="-1.5" text-anchor="middle" fill="none" stroke="currentColor" stroke-width="0.6">Cozy Corner</text>
                  <line x1="180" y1="84" x2="300" y2="84" stroke="#C56B4A" stroke-width="0.8" stroke-linecap="round" />
                  <text x="240" y="116" font-family="Cutive Mono, monospace" font-size="14" text-anchor="middle" fill="currentColor" opacity="0.55">recipes by Gigi</text>
                </svg>
              )}
              {v.id === 'v3' && (
                <svg viewBox="0 0 480 140" width="320">
                  <text x="240" y="68" font-family="Cutive Mono, monospace" font-size="42" text-anchor="middle" fill="none" stroke="currentColor" stroke-width="0.5">cozy corner</text>
                  <text x="240" y="106" font-family="Cutive Mono, monospace" font-size="14" text-anchor="middle" fill="currentColor" opacity="0.55">recipes by gigi</text>
                </svg>
              )}
              {v.id === 'v4' && (
                <svg viewBox="0 0 480 140" width="320">
                  <text x="240" y="76" font-family="Fraunces, serif" font-size="60" font-style="italic" font-weight="400" text-anchor="middle" fill="currentColor">Cozy Corner</text>
                  <text x="240" y="112" font-family="Cutive Mono, monospace" font-size="14" text-anchor="middle" fill="currentColor" opacity="0.55">recipes by Gigi</text>
                </svg>
              )}
              {v.id === 'v5' && (
                <svg viewBox="0 0 480 140" width="320">
                  <text x="240" y="80" font-family="Caveat, cursive" font-size="68" font-weight="500" text-anchor="middle" fill="currentColor">Cozy Corner</text>
                  <text x="240" y="114" font-family="Cutive Mono, monospace" font-size="13" text-anchor="middle" fill="currentColor" opacity="0.55">recipes by Gigi</text>
                </svg>
              )}
              {v.id === 'v6' && (
                <svg viewBox="0 0 480 140" width="320">
                  <text x="240" y="74" font-family="'Homemade Apple', cursive" font-size="38" text-anchor="middle" fill="currentColor">Cozy Corner</text>
                  <text x="240" y="110" font-family="Cutive Mono, monospace" font-size="13" text-anchor="middle" fill="currentColor" opacity="0.55">recipes by Gigi</text>
                </svg>
              )}
            </div>
          </div>
          <div class="preview preview-dark">
            <span class="preview-label">dark</span>
            <div class="logo-render dark">
              {v.id === 'v1' && (
                <svg viewBox="0 0 480 140" width="320">
                  <text x="240" y="70" font-family="Inter, sans-serif" font-size="56" font-weight="500" letter-spacing="-1.5" text-anchor="middle" fill="none" stroke="currentColor" stroke-width="0.6">Cozy Corner</text>
                  <text x="240" y="108" font-family="Cutive Mono, monospace" font-size="14" text-anchor="middle" fill="currentColor" opacity="0.55">recipes by Gigi</text>
                </svg>
              )}
              {v.id === 'v2' && (
                <svg viewBox="0 0 480 140" width="320">
                  <text x="240" y="70" font-family="Inter, sans-serif" font-size="56" font-weight="500" letter-spacing="-1.5" text-anchor="middle" fill="none" stroke="currentColor" stroke-width="0.6">Cozy Corner</text>
                  <line x1="180" y1="84" x2="300" y2="84" stroke="#D58860" stroke-width="0.8" stroke-linecap="round" />
                  <text x="240" y="116" font-family="Cutive Mono, monospace" font-size="14" text-anchor="middle" fill="currentColor" opacity="0.55">recipes by Gigi</text>
                </svg>
              )}
              {v.id === 'v3' && (
                <svg viewBox="0 0 480 140" width="320">
                  <text x="240" y="68" font-family="Cutive Mono, monospace" font-size="42" text-anchor="middle" fill="none" stroke="currentColor" stroke-width="0.5">cozy corner</text>
                  <text x="240" y="106" font-family="Cutive Mono, monospace" font-size="14" text-anchor="middle" fill="currentColor" opacity="0.55">recipes by gigi</text>
                </svg>
              )}
              {v.id === 'v4' && (
                <svg viewBox="0 0 480 140" width="320">
                  <text x="240" y="76" font-family="Fraunces, serif" font-size="60" font-style="italic" font-weight="400" text-anchor="middle" fill="currentColor">Cozy Corner</text>
                  <text x="240" y="112" font-family="Cutive Mono, monospace" font-size="14" text-anchor="middle" fill="currentColor" opacity="0.55">recipes by Gigi</text>
                </svg>
              )}
              {v.id === 'v5' && (
                <svg viewBox="0 0 480 140" width="320">
                  <text x="240" y="80" font-family="Caveat, cursive" font-size="68" font-weight="500" text-anchor="middle" fill="currentColor">Cozy Corner</text>
                  <text x="240" y="114" font-family="Cutive Mono, monospace" font-size="13" text-anchor="middle" fill="currentColor" opacity="0.55">recipes by Gigi</text>
                </svg>
              )}
              {v.id === 'v6' && (
                <svg viewBox="0 0 480 140" width="320">
                  <text x="240" y="74" font-family="'Homemade Apple', cursive" font-size="38" text-anchor="middle" fill="currentColor">Cozy Corner</text>
                  <text x="240" y="110" font-family="Cutive Mono, monospace" font-size="13" text-anchor="middle" fill="currentColor" opacity="0.55">recipes by Gigi</text>
                </svg>
              )}
            </div>
          </div>
          <div class="preview preview-small">
            <span class="preview-label">tamanho header (~32px)</span>
            <div class="logo-render">
              {v.id === 'v1' && <svg viewBox="0 0 480 140" height="32"><text x="240" y="70" font-family="Inter, sans-serif" font-size="56" font-weight="500" letter-spacing="-1.5" text-anchor="middle" fill="none" stroke="currentColor" stroke-width="0.6">Cozy Corner</text><text x="240" y="108" font-family="Cutive Mono, monospace" font-size="14" text-anchor="middle" fill="currentColor" opacity="0.55">recipes by Gigi</text></svg>}
              {v.id === 'v2' && <svg viewBox="0 0 480 140" height="32"><text x="240" y="70" font-family="Inter, sans-serif" font-size="56" font-weight="500" letter-spacing="-1.5" text-anchor="middle" fill="none" stroke="currentColor" stroke-width="0.6">Cozy Corner</text><line x1="180" y1="84" x2="300" y2="84" stroke="#C56B4A" stroke-width="0.8" stroke-linecap="round" /><text x="240" y="116" font-family="Cutive Mono, monospace" font-size="14" text-anchor="middle" fill="currentColor" opacity="0.55">recipes by Gigi</text></svg>}
              {v.id === 'v3' && <svg viewBox="0 0 480 140" height="32"><text x="240" y="68" font-family="Cutive Mono, monospace" font-size="42" text-anchor="middle" fill="none" stroke="currentColor" stroke-width="0.5">cozy corner</text><text x="240" y="106" font-family="Cutive Mono, monospace" font-size="14" text-anchor="middle" fill="currentColor" opacity="0.55">recipes by gigi</text></svg>}
              {v.id === 'v4' && <svg viewBox="0 0 480 140" height="32"><text x="240" y="76" font-family="Fraunces, serif" font-size="60" font-style="italic" font-weight="400" text-anchor="middle" fill="currentColor">Cozy Corner</text><text x="240" y="112" font-family="Cutive Mono, monospace" font-size="14" text-anchor="middle" fill="currentColor" opacity="0.55">recipes by Gigi</text></svg>}
              {v.id === 'v5' && <svg viewBox="0 0 480 140" height="32"><text x="240" y="80" font-family="Caveat, cursive" font-size="68" font-weight="500" text-anchor="middle" fill="currentColor">Cozy Corner</text><text x="240" y="114" font-family="Cutive Mono, monospace" font-size="13" text-anchor="middle" fill="currentColor" opacity="0.55">recipes by Gigi</text></svg>}
              {v.id === 'v6' && <svg viewBox="0 0 480 140" height="32"><text x="240" y="74" font-family="'Homemade Apple', cursive" font-size="38" text-anchor="middle" fill="currentColor">Cozy Corner</text><text x="240" y="110" font-family="Cutive Mono, monospace" font-size="13" text-anchor="middle" fill="currentColor" opacity="0.55">recipes by Gigi</text></svg>}
            </div>
          </div>
        </div>
      </section>
    ))}
  </div>

  <style>
    .logos-shell { max-width: 1200px; margin: 0 auto; padding: 48px 32px 96px; }
    .logos-header { margin-bottom: 64px; position: relative; }
    .t-meta { font-family: var(--font-mono); font-size: 12px; color: var(--ink-soft); }
    .logos-title { font-family: var(--font-display); font-weight: 500; font-size: 36px; letter-spacing: -0.02em; margin-top: 8px; }
    .t-body { font-family: var(--font-mono); }
    .t-small { font-family: var(--font-mono); font-size: 13px; }
    .dark-toggle {
      position: absolute; top: 0; right: 0;
      padding: 8px 14px;
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: 999px;
      font: inherit;
      font-family: var(--font-mono);
      font-size: 11px;
      cursor: pointer;
    }
    .variant { padding: 40px 0; border-top: 1px solid var(--line); }
    .variant-meta { margin-bottom: 24px; }
    .variant-title { font-family: var(--font-display); font-weight: 600; font-size: 18px; margin-bottom: 4px; display: flex; align-items: center; gap: 8px; }
    .org-badge {
      font-family: var(--font-mono);
      font-size: 10px;
      padding: 2px 8px;
      background: var(--terracota);
      color: white;
      border-radius: 999px;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }
    .variant-previews { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    .preview { position: relative; padding: 40px 24px; border-radius: 8px; min-height: 180px; display: flex; align-items: center; justify-content: center; }
    .preview-label { position: absolute; top: 12px; left: 16px; font-family: var(--font-mono); font-size: 10px; color: var(--ink-mute); text-transform: lowercase; }
    .preview-light { background: #FAF6EE; color: #1A1A1A; }
    .preview-dark { background: #0F1A2A; color: #F5F0E5; }
    .preview-dark .preview-label { color: rgba(255,255,255,0.4); }
    .preview-small { grid-column: 1 / -1; background: var(--surface); padding: 32px 24px; min-height: 100px; color: var(--ink); }
    @media (max-width: 768px) { .variant-previews { grid-template-columns: 1fr; } }
  </style>

  <script>
    document.getElementById('dark-toggle')?.addEventListener('click', () => {
      document.body.classList.toggle('dark-mode');
      try { localStorage.setItem('cozy-dark-mode', document.body.classList.contains('dark-mode') ? 'true' : 'false'); } catch (e) {}
    });
  </script>
</BaseLayout>
