---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';
import { getCollection } from 'astro:content';
import { CATEGORY_META } from '../lib/categories';
import introData from '../content/pages/intro.json';
import cozinhaData from '../content/pages/cozinha.json';
import recadoData from '../content/pages/recado.json';
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';

// SVG da cozinha inlined em build time (pra hotspots com hit-area exata).
// Três versões responsivas — só uma fica visível por vez, controlada por CSS.
const kitchenSvg = readFileSync(resolve(process.cwd(), 'public/kitchen/cozinha.svg'), 'utf-8');
const kitchenTabletSvg = readFileSync(resolve(process.cwd(), 'public/kitchen/cozinha-tablet.svg'), 'utf-8');
const kitchenMobile1Svg = readFileSync(resolve(process.cwd(), 'public/kitchen/cozinha-mobile-1.svg'), 'utf-8');
const kitchenMobile2Svg = readFileSync(resolve(process.cwd(), 'public/kitchen/cozinha-mobile-2.svg'), 'utf-8');

const recipes = await getCollection('recipes', ({ data }) => data.published);

// Agrupa receitas por categoria pra alimentar o drawer dinamicamente.
// Uma receita pode estar em várias categorias → aparece em cada uma.
const recipesByCategory: Record<string, typeof recipes> = {};
for (const r of recipes) {
  for (const cat of r.data.category) {
    (recipesByCategory[cat] ??= []).push(r);
  }
}
// "todas" engloba todas
recipesByCategory.todas = recipes;

const countByCategory = Object.fromEntries(
  Object.entries(recipesByCategory).map(([k, v]) => [k, v.length])
);
---

<BaseLayout description="Receitas autorais da Gigi — narrativa, lenta, com carinho.">

  <!-- ===================== INTRO COVER (azul escuro, typewriter) ===================== -->
  <div class="intro-cover" id="intro-cover">
    <button class="cover-skip" id="cover-skip" type="button">
      <span data-t="intro.skip">{introData.skipLabel.replace(' ✕', '')}</span>
      <Icon name="ph:x-thin" width={14} height={14} />
    </button>
    <p class="phrase typewriter" id="ph1"></p>
    <p class="phrase typewriter" id="ph2"></p>
  </div>

  <!-- ===================== HEADER (logo morfa pra cá) ===================== -->
  <header class="site-header">
    <div class="logo" id="header-logo">
      <span class="logo-name">Cozy Corner</span>
      <span class="logo-by">— by Gigi</span>
    </div>
  </header>

  <div class="scroll-hint" id="scroll-hint">
    <Icon name="ph:arrow-down-thin" /> <span data-t="intro.scroll_hint">role pra continuar</span>
  </div>

  <!-- ===================== HERO (fixed, morfa pro header) ===================== -->
  <div class="hero-logo" id="hero-logo">
    <span class="hero-name">Cozy Corner</span>
    <span class="hero-by">— by Gigi</span>
  </div>

  <!-- ===================== CENA 1 — espaço pro morph acontecer ===================== -->
  <section id="scene-intro" aria-hidden="true"></section>

  <!-- ===================== TRANSIÇÃO BG ===================== -->
  <section id="flow-transition" aria-hidden="true"></section>

  <!-- ===================== COZINHA ===================== -->
  <section id="flow-kitchen">
    <!-- Desktop (>= 1024px) -->
    <div class="kitchen-canvas kitchen-desktop">
      <Fragment set:html={kitchenSvg} />
    </div>
    <!-- Tablet (601-1023px) -->
    <div class="kitchen-canvas kitchen-tablet">
      <Fragment set:html={kitchenTabletSvg} />
    </div>
    <!-- Mobile (<=600px) — duas partes lado a lado, com scroll horizontal -->
    <div class="kitchen-mobile-wrap">
      <div class="kitchen-mobile-scroll" id="kitchen-mobile-scroll">
        <div class="kitchen-canvas kitchen-mobile-part">
          <Fragment set:html={kitchenMobile1Svg} />
        </div>
        <div class="kitchen-canvas kitchen-mobile-part">
          <Fragment set:html={kitchenMobile2Svg} />
        </div>
      </div>
      <button class="mobile-swipe-hint" id="mobile-swipe-hint" type="button" aria-label="ver mais da cozinha">
        <Icon name="ph:arrow-right-thin" width={22} height={22} />
      </button>
    </div>
  </section>

  <!-- ===================== DRAWERS / MODAIS ===================== -->
  <div class="drawer-backdrop" id="drawer-backdrop"></div>

  <!-- Category drawer (renderiza receitas dinamicamente via JS) -->
  <aside class="cat-drawer" id="cat-drawer" aria-hidden="true" aria-labelledby="cat-title">
    <button class="drawer-close" data-close type="button" aria-label="fechar">
      <Icon name="ph:x-thin" width={20} height={20} />
    </button>
    <button class="drawer-crumb" data-close type="button">
      <Icon name="ph:arrow-left-thin" /> <span data-t="nav.back_to_kitchen">voltar pra cozinha</span>
    </button>
    <h2 id="cat-title" class="drawer-title">Pratos principais</h2>
    <p class="drawer-count" id="cat-count">0 receitas</p>

    <div class="drawer-search">
      <Icon name="ph:magnifying-glass-thin" width={16} height={16} />
      <input class="search-input" type="search" placeholder="buscar nesta categoria..." data-t-attr="placeholder:search.placeholder" />
    </div>

    <div class="drawer-filters">
      <span class="chip chip-active" data-t="filter.all">todas</span>
      <span class="chip" data-t="filter.quick">até 30 min</span>
      <span class="chip" data-t="filter.vegetarian">vegetariana</span>
      <span class="chip" data-t="filter.gluten_free">sem glúten</span>
    </div>

    <ul class="recipe-list" id="cat-results"></ul>
  </aside>

  <!-- Sobre mim drawer -->
  <aside class="cat-drawer" id="sobre-drawer" aria-hidden="true" aria-labelledby="sobre-title">
    <button class="drawer-close" data-close type="button" aria-label="fechar">
      <Icon name="ph:x-thin" width={20} height={20} />
    </button>
    <figure class="sobre-photo">
      <img
        src="/sobre/foto.jpg"
        alt="Foto da Gigi com o marido"
        data-t-attr="alt:sobre.photo_alt"
        loading="lazy"
      />
    </figure>
    <h2 id="sobre-title" class="drawer-title" data-t="sobre.title">Oi, tudo bem?</h2>
    <p class="drawer-prose" data-t="sobre.p1">
      Essa sou eu e meu marido e essa é a nossa cozinha. Sinta-se livre pra
      explorar e conhecer as receitas que fazem parte da nossa vida.
    </p>
    <p class="drawer-prose" data-t="sobre.p2">
      Criamos esse cantinho pra compartilhar um pouco daquilo que fazemos com
      tanto amor e carinho pra nossa família e amigos.
    </p>
    <p class="drawer-prose" data-t="sobre.p3">
      Ah! E esse na bancada pra quem não conhece é o Akim. Ele geralmente dorme
      o dia inteiro e só para pra ficar miando pela casa. Duvida? Vê o que
      acontece quando mexe com ele!
    </p>
    <p class="drawer-prose" data-t="sobre.p4">
      Fiquem à vontade, divirtam-se cozinhando e bom apetite =)
    </p>
  </aside>

  <!-- Tooltip flutuante dos hotspots -->
  <div class="kitchen-tooltip" id="kitchen-tooltip" role="tooltip"></div>

  <!-- Recado modal (post-it) -->
  <div class="recado-modal" id="recado-modal" aria-hidden="true" role="dialog" aria-labelledby="recado-title">
    <button class="drawer-close" data-close type="button" aria-label="fechar">
      <Icon name="ph:x-thin" width={20} height={20} />
    </button>
    <h2 id="recado-title" class="recado-title" data-t="recado.title">{recadoData.title}</h2>
    <p class="recado-sub" data-t="recado.subtitle">{recadoData.subtitle}</p>
    <label class="field-label" data-t="recado.name_label">seu nome</label>
    <input class="field-input" id="r-name" type="text" />
    <label class="field-label" data-t="recado.message_label">mensagem</label>
    <textarea class="field-input" id="r-msg" placeholder="oi Gigi!" data-t-attr="placeholder:recado.placeholder"></textarea>
    <button class="btn btn-primary recado-send" id="r-send" type="button">
      <Icon name="ph:envelope-thin" /> <span data-t="recado.send">enviar por email</span>
    </button>
  </div>

  <!-- Recipes data pra o drawer (renderizado via JS) -->
  <script type="application/json" id="recipes-data" set:html={JSON.stringify({
    byCategory: Object.fromEntries(
      Object.entries(recipesByCategory).map(([k, v]) => [
        k,
        v.map(r => ({
          id: r.id,
          title: r.data.title,
          time: r.data.time,
          servings: r.data.servings,
          difficulty: r.data.difficulty,
        }))
      ])
    ),
    counts: countByCategory,
    catMeta: Object.fromEntries(Object.entries(CATEGORY_META).map(([k, v]) => [k, v.label])),
    catMetaTodas: 'Todas as receitas',
    email: recadoData.email,
    emailSubject: recadoData.emailSubject,
    emailTemplate: recadoData.emailTemplate,
  })}></script>

  <style>
    /* ============ ÍCONES (line art, herdam cor) ============ */
    [data-icon] svg, svg { fill: none; stroke: currentColor; }
    .icon-dark { display: none; }
    body.dark-mode .icon-light { display: none; }
    body.dark-mode .icon-dark { display: inline-block; }

    /* ============ INTRO COVER ============ */
    body.intro-active { overflow: hidden; }

    .intro-cover {
      position: fixed;
      inset: 0;
      background: var(--cover-dark);
      color: white;
      z-index: 200;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0 var(--s-5);
      text-align: center;
      clip-path: inset(0 0 0 0);
      transition: clip-path 1.4s var(--ease-in-out);
    }
    .intro-cover.wiped {
      clip-path: inset(100% 0 0 0);
      pointer-events: none;
    }
    .cover-skip {
      position: absolute;
      top: 20px; right: var(--s-6);
      background: transparent;
      border: none;
      color: white;
      opacity: 0.55;
      font-family: var(--font-mono);
      font-size: var(--fs-caption);
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 4px;
      transition: opacity var(--dur-fast);
      z-index: 5;
    }
    .cover-skip:hover { opacity: 1; }
    .intro-cover .phrase {
      position: absolute;
      font-family: var(--font-mono);
      font-size: var(--fs-intro);
      color: white;
      opacity: 0;
      max-width: 820px;
      padding: 0 var(--s-5);
      line-height: var(--lh-snug);
    }
    .phrase.typewriter::after {
      content: '|';
      display: inline-block;
      margin-left: 4px;
      opacity: 0.6;
      animation: caret 0.9s steps(2) infinite;
    }
    .phrase.typewriter.done::after { content: ''; }
    @keyframes caret {
      0%, 50% { opacity: 0.6; }
      51%, 100% { opacity: 0; }
    }

    /* ============ HEADER ============ */
    .site-header {
      position: fixed;
      top: 0; left: 0; right: 0;
      height: var(--header-h);
      padding: 0 var(--s-6);
      z-index: 100;
    }
    .site-header .logo {
      position: absolute;
      top: 50%; left: 50%;
      transform: translate(-50%, -50%);
      display: flex;
      flex-direction: column;
      align-items: flex-end; /* "— by Gigi" alinhado à direita */
      line-height: 1.1;
      opacity: 0;
    }
    .logo-name {
      font-family: var(--font-brand);
      font-weight: 600;
      font-size: 22px;
      line-height: 1;
      letter-spacing: 0;
    }
    .logo-by {
      font-family: var(--font-mono);
      font-size: 10px;
      opacity: 0.55;
      margin-top: 1px;
    }

    /* ============ HERO (morfa pro header) ============ */
    .hero-logo {
      position: fixed;
      top: 50%; left: 50%;
      transform: translate(-50%, -50%);
      transform-origin: center center;
      display: flex;
      flex-direction: column;
      align-items: flex-end; /* "— by Gigi" alinhado à direita do "Cozy Corner" */
      gap: var(--s-2);
      opacity: 0;
      z-index: 80;
      pointer-events: none;
      will-change: transform, opacity;
      transition: opacity 1s var(--ease-out) 0.3s;
    }
    .hero-logo.visible { opacity: 1; }
    .hero-name {
      font-family: var(--font-brand);
      font-weight: 600;
      font-size: clamp(64px, 12vw, 128px);
      letter-spacing: 0;
      line-height: 1;
      color: var(--ink);
      white-space: nowrap;
    }
    .hero-by {
      font-family: var(--font-mono);
      font-size: clamp(13px, 1.8vw, 18px);
      opacity: 0.55;
      color: var(--ink);
    }

    /* Hero pousa sobre var(--bg) que adapta light/dark naturalmente */

    /* ============ SCROLL HINT ============ */
    .scroll-hint {
      position: fixed;
      bottom: var(--s-6);
      left: 50%;
      transform: translateX(-50%);
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-family: var(--font-mono);
      font-size: var(--fs-caption);
      color: var(--ink-soft);
      opacity: 0;
      z-index: 90;
      transition: opacity var(--dur-base);
      pointer-events: none;
      animation: bob 1.8s ease-in-out infinite;
    }
    .scroll-hint.show { opacity: 0.65; }
    .scroll-hint.hidden { opacity: 0; }
    @keyframes bob {
      0%, 100% { transform: translateX(-50%) translateY(0); }
      50% { transform: translateX(-50%) translateY(6px); }
    }

    /* ============ SEÇÕES DA HOMEPAGE ============ */
    /* Tudo no cream warm de --bg. Azul e terracota são acentos/detalhes. */
    #scene-intro {
      min-height: 100vh;
      background: var(--bg);
    }
    #flow-transition {
      height: 50vh;
      background: var(--bg);
    }

    /* ============ COZINHA ============ */
    #flow-kitchen {
      background: var(--bg);
      padding: 0;
      /* --vh-real é window.innerHeight medido por JS no BaseLayout.
         Confiável em iOS Safari, onde 100vh/svh nem sempre excluem
         a barra de URL. Fallbacks pra browsers velhos. */
      height: 100vh;
      height: 100svh;
      height: var(--vh-real, 100svh);
      min-height: 100vh;
      min-height: 100svh;
      min-height: var(--vh-real, 100svh);
      overflow: hidden;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      align-items: center;
    }
    .kitchen-title {
      max-width: var(--max-content);
      margin: 0 auto var(--s-3);
      font-family: var(--font-mono);
      font-size: var(--fs-caption);
      color: var(--ink-mute);
      text-transform: lowercase;
      letter-spacing: 0.05em;
    }
    .kitchen-canvas {
      position: relative;
      color: var(--ink);
    }
    /* Desktop: preenche 100vh de altura, aspect 1500:1000.
       Excesso lateral cortado pelo overflow:hidden do #flow-kitchen. */
    .kitchen-desktop {
      height: min(100svh, 1000px);
      aspect-ratio: 1500 / 1000;
    }
    .kitchen-canvas :global(svg) {
      width: 100%;
      height: 100%;
      display: block;
    }
    /* ============ RESPONSIVO ============
       Por padrão (desktop) mostra só .kitchen-desktop.
       Tablet e mobile ficam escondidos. */
    .kitchen-tablet,
    .kitchen-mobile-wrap { display: none; }

    /* Tablet: 601-1023px — usa o SVG 991x1000 com aspect compatível */
    @media (max-width: 1023px) and (min-width: 601px) {
      .kitchen-desktop { display: none; }
      .kitchen-tablet {
        display: block;
        /* Largura limitada por viewport-width OU height-derivada (não passa
           do viewport vertical). Garante que a altura nunca excede 100vh. */
        width: min(90vw, calc(100svh * 991 / 1000));
        aspect-ratio: 991 / 1000;
      }
    }

    /* Mobile: <=600px — duas partes lado a lado, scroll horizontal */
    @media (max-width: 600px) {
      .kitchen-desktop,
      .kitchen-tablet { display: none; }
      /* Herda o flex flex-end do #flow-kitchen base, mas remove o
         padding lateral (cozinha encosta nas bordas no mobile). */
      #flow-kitchen {
        padding-left: 0;
        padding-right: 0;
      }
      /* Wrap ocupa 100vw e 100vh, ancorada ao bottom do viewport pelo
         flex-end do pai. SVG dentro usa preserveAspectRatio=xMidYMax meet
         pra que a bancada cole no fundo da tela em qualquer aspect ratio. */
      .kitchen-mobile-wrap {
        display: block;
        position: relative;
        width: 100vw;
        height: 100vh;
        height: 100svh;
        height: var(--vh-real, 100svh);
      }
      .kitchen-mobile-scroll {
        display: flex;
        width: 100%;
        height: 100%;
        overflow-x: auto;
        overflow-y: hidden;
        scroll-snap-type: x mandatory;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
      }
      .kitchen-mobile-scroll::-webkit-scrollbar { display: none; }
      .kitchen-mobile-part {
        flex: 0 0 100vw;
        width: 100vw;
        height: 100%;
        margin: 0;
        scroll-snap-align: start;
      }
      .kitchen-mobile-part :global(svg) {
        width: 100%;
        height: 100%;
        display: block;
      }
      /* Esconde os detalhes do counter-paneling (lonas verticais de madeira
         abaixo da bancada) no mobile. A bancada vira o "rodapé" da cozinha
         e cola na base do viewport, sem detalhes cortados pela barra do iOS. */
      .kitchen-mobile-part :global(#counter-paneling) {
        display: none;
      }
      /* Empurra o conteúdo da PRIMEIRA tela mobile 2px pra esquerda,
         menos a bancada e o paneling (que ficam fixos no lugar). */
      .kitchen-mobile-part:first-child :global(svg > g) {
        transform: translateX(-2px);
      }
      .kitchen-mobile-part:first-child :global(#bancada),
      .kitchen-mobile-part:first-child :global(#counter-paneling) {
        transform: translateX(2px);
      }
      /* Frame de foto e livros: shift de 28px à direita
         (só na primeira tela mobile). */
      .kitchen-mobile-part:first-child :global(#sobre),
      .kitchen-mobile-part:first-child :global(#todas) {
        transform: translateX(28px);
      }
      /* Estante: shift de 14px à direita. */
      .kitchen-mobile-part:first-child :global(#estante) {
        transform: translateX(14px);
      }
      /* Prato principal: shift de 20px à direita. */
      .kitchen-mobile-part:first-child :global(#principais) {
        transform: translateX(20px);
      }
      /* SEGUNDA tela mobile: empurra todo o conteúdo 16px pra direita
         (planta, relógio, geladeira, calendário, recado), mantendo
         bancada e paneling no lugar. */
      .kitchen-mobile-part:last-child :global(svg > g) {
        transform: translateX(16px);
      }
      .kitchen-mobile-part:last-child :global(#bancada),
      .kitchen-mobile-part:last-child :global(#counter-paneling) {
        transform: translateX(-16px);
      }
      /* Botão de navegação: setinha clicável que alterna entre as duas partes.
         Fixed pra ficar sempre acessível enquanto o usuário rola pela cozinha. */
      .mobile-swipe-hint {
        position: fixed;
        right: var(--s-3);
        left: auto;
        bottom: var(--s-5);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        background: var(--ink);
        color: var(--bg);
        border: none;
        border-radius: 999px;
        box-shadow: var(--shadow-2);
        opacity: 0.9;
        cursor: pointer;
        animation: swipe-nudge 1.6s ease-in-out infinite;
        z-index: 50;
        transition: opacity 200ms ease-out;
      }
      .mobile-swipe-hint:hover { opacity: 1; }
      .mobile-swipe-hint :global(svg) { display: block; }
      /* Quando estiver na segunda parte: seta vira, botão muda pra esquerda, nudge inverte */
      .mobile-swipe-hint.flipped {
        left: var(--s-3);
        right: auto;
        animation: swipe-nudge-rev 1.6s ease-in-out infinite;
      }
      .mobile-swipe-hint.flipped :global(svg) { transform: scaleX(-1); }
      @keyframes swipe-nudge {
        0%, 100% { transform: translateX(0); }
        50% { transform: translateX(-6px); }
      }
      @keyframes swipe-nudge-rev {
        0%, 100% { transform: translateX(0); }
        50% { transform: translateX(6px); }
      }
      @media (prefers-reduced-motion: reduce) {
        .mobile-swipe-hint,
        .mobile-swipe-hint.flipped { animation: none; }
      }
    }
    /* Em dark mode, o currentColor já vira cream (--ink) automaticamente,
       então não precisa de filter: invert (que inverteria o cream pra navy
       e deixaria a cena imperceptível sobre o fundo navy). */

    /* Hotspots no SVG — bounding-box do grupo é a área clicável.
       Cobre tanto <g class='hs'> quanto <path class='hs'>. */
    .kitchen-canvas :global(.hs) {
      cursor: pointer;
      pointer-events: bounding-box;
      transform-box: fill-box;
      transform-origin: center;
      /* Anima só `scale` no hover (propriedade separada), pra não animar
         o `transform: translateX(...)` que usamos pra reposicionar
         elementos no mobile. */
      transition: scale 200ms ease;
    }
    /* Hover só em dispositivos que realmente suportam (mouse/trackpad).
       Em touch, o estado de hover fica grudado depois do tap, deixando
       o elemento em terracota até o próximo toque em outro lugar. */
    @media (hover: hover) {
      .kitchen-canvas :global(.hs:hover) { scale: 1.03; }
      /* Hover: pinta o stroke em terracota pra destacar */
      .kitchen-canvas :global(.hs:hover) :global(*[stroke="currentColor"]),
      .kitchen-canvas :global(.hs:hover[stroke="currentColor"]) {
        stroke: var(--terracota);
      }
      .kitchen-canvas :global(.hs:hover) :global(*[fill="currentColor"]),
      .kitchen-canvas :global(.hs:hover[fill="currentColor"]) {
        fill: var(--terracota);
      }
    }
    /* Feedback visual de tap: JS adiciona .hs-pressed por ~280ms quando
       o user clica. Funciona melhor que :active em touch (que pode ser
       brevíssimo demais). */
    .kitchen-canvas :global(.hs.hs-pressed) { scale: 1.03; }
    .kitchen-canvas :global(.hs.hs-pressed) :global(*[stroke="currentColor"]),
    .kitchen-canvas :global(.hs.hs-pressed[stroke="currentColor"]) {
      stroke: var(--terracota);
    }
    .kitchen-canvas :global(.hs.hs-pressed) :global(*[fill="currentColor"]),
    .kitchen-canvas :global(.hs.hs-pressed[fill="currentColor"]) {
      fill: var(--terracota);
    }
    .kitchen-canvas :global(.hs:focus) { outline: none; }
    .kitchen-canvas :global(.hs:focus-visible) {
      outline: 2px solid var(--terracota);
      outline-offset: 4px;
    }
    /* Debug opcional (D): pinta fundo dos bbox dos hotspots */
    body.hs-debug .kitchen-canvas :global(.hs) :global(*[stroke="currentColor"]),
    body.hs-debug .kitchen-canvas :global(.hs[stroke="currentColor"]) {
      stroke: var(--terracota);
    }

    /* Zzz do gatinho dormindo — flutuam pra cima-direita e somem */
    .kitchen-canvas :global(.zzz-puff) {
      opacity: 0;
      transform-box: fill-box;
      transform-origin: center;
      animation: zzz-drift 4.5s ease-out infinite;
    }
    .kitchen-canvas :global(.zzz-2) { animation-delay: 1.5s; }
    .kitchen-canvas :global(.zzz-3) { animation-delay: 3s; }
    /* Gato acordado: pausa os zzz no clique (durante o tooltip "miau") */
    body.cat-awake .kitchen-canvas :global(.zzz-puff) {
      animation-play-state: paused;
    }
    @keyframes zzz-drift {
      0%   { opacity: 0; transform: translate(0, 0) scale(0.6); }
      15%  { opacity: 0.8; }
      70%  { opacity: 0.4; }
      100% { opacity: 0; transform: translate(40px, -55px) scale(1.4); }
    }
    @media (prefers-reduced-motion: reduce) {
      .kitchen-canvas :global(.zzz-puff) {
        animation: none;
        opacity: 0.5;
      }
      .kitchen-canvas :global(.zzz-2) { transform: translate(15px, -20px); }
      .kitchen-canvas :global(.zzz-3) { transform: translate(30px, -40px) scale(1.2); }
    }

    /* Quando um drawer abre, encolhe o body, alinha cena ao bottom */
    body {
      transition: padding-right 0.45s var(--ease-out);
    }
    @media (min-width: 960px) {
      body.drawer-open {
        padding-right: 520px;
      }
      body.drawer-open #flow-kitchen {
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        min-height: 100vh;
      }
      /* Com a gaveta aberta, a cena usa toda a largura sobrando
         (em vez dos 70% padrão), pra não ficar pequena demais. */
      body.drawer-open .kitchen-canvas {
        width: 100%;
      }
      /* Header também encolhe pra acompanhar — logo segue centrado
         com o conteúdo, não com a viewport. */
      body.drawer-open .site-header {
        right: 520px;
      }
    }
    .site-header {
      transition: right 0.45s var(--ease-out);
    }

    /* Tooltip flutuante — alinhado ao DS */
    .kitchen-tooltip {
      position: fixed;
      transform: translate(-50%, -100%) translateY(calc(-1 * var(--s-3)));
      background: var(--ink);
      color: var(--bg);
      font-family: var(--font-mono);
      font-size: var(--fs-meta);
      letter-spacing: 0.02em;
      line-height: 1;
      padding: var(--s-2) var(--s-4);
      border-radius: var(--r-md);
      box-shadow: var(--shadow-2);
      pointer-events: none;
      white-space: nowrap;
      opacity: 0;
      transition: opacity var(--dur-base) var(--ease-out);
      z-index: 300;
    }
    .kitchen-tooltip::after {
      content: '';
      position: absolute;
      top: 100%; left: 50%;
      transform: translateX(-50%);
      border: 6px solid transparent;
      border-top-color: var(--ink);
    }
    .kitchen-tooltip.show { opacity: 1; }
    /* Em dispositivos sem hover (touch — celular/tablet), esconde o tooltip.
       Hover não dispara naturalmente em touch, e o "click pra ver" não é UX
       intuitiva nesse contexto. */
    @media (hover: none), (pointer: coarse) {
      .kitchen-tooltip { display: none !important; }
    }

    /* Drawer prose pra sobre mim */
    .drawer-prose {
      font-family: var(--font-mono);
      font-size: var(--fs-body);
      line-height: var(--lh-loose);
      color: var(--ink-soft);
      margin-bottom: var(--s-4);
    }
    /* Foto do "sobre" — preto e branco via CSS, quadrada com cantos suaves */
    .sobre-photo {
      margin: 0 0 var(--s-5);
      width: 200px;
      aspect-ratio: 1 / 1;
      border-radius: var(--r-md, 12px);
      overflow: hidden;
      background: var(--surface);
    }
    .sobre-photo img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      filter: grayscale(1) contrast(1.02);
    }

    /* ============ DRAWERS / MODAL ============ */
    .drawer-backdrop {
      position: fixed; inset: 0;
      background: rgba(26,26,26,0.2);
      opacity: 0; visibility: hidden;
      transition: opacity var(--dur-base), visibility var(--dur-base);
      z-index: 150;
    }
    /* No dark mode o overlay escuro some no fundo navy. Usa cream sutil
       pra criar contraste visível por cima. */
    body.dark-mode .drawer-backdrop {
      background: rgba(245, 240, 229, 0.12);
    }
    .drawer-backdrop.open { opacity: 1; visibility: visible; }

    .cat-drawer {
      position: fixed;
      top: 0; right: 0; bottom: 0;
      width: 520px;
      max-width: 100vw;
      background: var(--bg);
      border-left: 1px solid var(--line);
      box-shadow: var(--shadow-3);
      transform: translateX(100%);
      transition: transform 0.5s var(--ease-out);
      z-index: 200;
      overflow-y: auto;
      padding: var(--s-7) var(--s-6);
    }
    .cat-drawer.open { transform: translateX(0); }

    .drawer-close {
      position: absolute;
      top: var(--s-3); right: var(--s-3);
      background: transparent;
      border: none;
      cursor: pointer;
      color: var(--ink-soft);
      width: 36px; height: 36px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: var(--r-pill);
    }
    .drawer-close:hover { background: var(--surface); }

    .drawer-crumb {
      background: transparent;
      border: none;
      cursor: pointer;
      color: var(--ink-soft);
      font-family: var(--font-mono);
      font-size: var(--fs-meta);
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 0;
      margin-bottom: var(--s-5);
    }
    .drawer-crumb:hover { color: var(--terracota); }

    .drawer-title {
      font-family: var(--font-display);
      font-weight: 500;
      font-size: var(--fs-h2);
      letter-spacing: -0.01em;
      margin-bottom: var(--s-1);
    }
    .drawer-count {
      font-family: var(--font-mono);
      font-size: var(--fs-meta);
      color: var(--ink-mute);
      margin-bottom: var(--s-5);
    }

    .drawer-search {
      position: relative;
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 10px 12px;
      border: 1px solid var(--line);
      border-radius: var(--r-sm);
      background: var(--surface);
      margin-bottom: var(--s-3);
      color: var(--ink-soft);
    }
    .drawer-search .search-input {
      flex: 1;
      background: transparent;
      border: none;
      font: inherit;
      font-family: var(--font-mono);
      font-size: var(--fs-small);
      outline: none;
      color: var(--ink);
    }
    .drawer-search .search-input::placeholder { color: var(--ink-mute); }

    .drawer-filters {
      display: flex;
      flex-wrap: wrap;
      gap: var(--s-2);
      margin-bottom: var(--s-5);
    }
    .chip {
      padding: 4px 12px;
      border: 1px solid var(--line);
      border-radius: var(--r-pill);
      font-family: var(--font-mono);
      font-size: var(--fs-caption);
      cursor: pointer;
      background: var(--bg);
      color: var(--ink-soft);
      transition: all var(--dur-fast);
    }
    .chip:hover { border-color: var(--terracota); color: var(--ink); }
    .chip-active, .chip-active:hover {
      background: var(--ink);
      color: var(--bg);
      border-color: var(--ink);
    }

    /* recipe-list é populada via JS innerHTML — precisa ser :global pra
       o CSS do Astro alcançar os elementos dinâmicos */
    .recipe-list { list-style: none; }
    .recipe-list :global(li) {
      border-bottom: 1px solid var(--line-soft);
    }
    .recipe-list :global(a) {
      display: grid;
      grid-template-columns: 80px 1fr;
      gap: var(--s-4);
      padding: var(--s-3) 0;
      text-decoration: none;
      color: inherit;
      align-items: center;
    }
    .recipe-list :global(a:hover .recipe-row-title) { color: var(--terracota); }
    .recipe-list :global(.recipe-thumb) {
      aspect-ratio: 1;
      background: var(--surface);
      border: 1px dashed var(--line);
      border-radius: var(--r-sm);
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-mono);
      font-size: 10px;
      color: var(--ink-mute);
    }
    .recipe-list :global(.recipe-row-title) {
      font-family: var(--font-display);
      font-weight: 600;
      font-size: var(--fs-h3);
      margin-bottom: 2px;
      transition: color var(--dur-fast);
    }
    .recipe-list :global(.recipe-row-meta) {
      font-family: var(--font-mono);
      font-size: var(--fs-meta);
      color: var(--ink-mute);
    }

    /* Recado modal */
    .recado-modal {
      position: fixed;
      top: 50%; left: 50%;
      transform: translate(-50%, -50%) scale(0.96);
      width: 440px;
      max-width: calc(100vw - 32px);
      background: var(--bg);
      border-radius: var(--r-lg);
      box-shadow: var(--shadow-3);
      padding: 40px 32px 32px;
      z-index: 220;
      opacity: 0;
      visibility: hidden;
      transition: opacity var(--dur-base), transform var(--dur-base), visibility var(--dur-base);
    }
    .recado-modal.open {
      opacity: 1;
      visibility: visible;
      transform: translate(-50%, -50%) scale(1);
    }
    .recado-modal::before {
      content: '';
      position: absolute;
      top: -8px; left: 50%;
      transform: translateX(-50%) rotate(-2deg);
      width: 90px; height: 16px;
      background: #FBE9A6;
      border-radius: 2px;
      box-shadow: 0 1px 2px rgba(0,0,0,0.1);
    }
    .recado-title {
      font-family: var(--font-display);
      font-weight: 500;
      font-size: var(--fs-h2);
      letter-spacing: -0.01em;
      margin-bottom: 6px;
    }
    .recado-sub {
      color: var(--ink-soft);
      font-size: var(--fs-small);
      margin-bottom: var(--s-5);
    }
    .field-label {
      display: block;
      font-family: var(--font-mono);
      font-size: var(--fs-meta);
      color: var(--ink-soft);
      margin-top: var(--s-3);
      margin-bottom: 4px;
    }
    .field-input {
      width: 100%;
      padding: 10px 12px;
      border: 1px solid var(--line);
      border-radius: var(--r-sm);
      font: inherit;
      font-family: var(--font-mono);
      font-size: var(--fs-small);
      background: var(--bg);
      color: var(--ink);
    }
    textarea.field-input { min-height: 90px; resize: vertical; }
    .recado-send { margin-top: var(--s-5); width: 100%; justify-content: center; }
    .recado-alt {
      text-align: center;
      font-family: var(--font-mono);
      font-size: var(--fs-caption);
      color: var(--ink-mute);
      margin-top: var(--s-4);
    }
    .recado-alt a {
      color: var(--ink-soft);
      text-decoration: underline;
    }

    /* ============ BOTÕES ============ */
    .btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 10px 14px;
      border-radius: var(--r-sm);
      font: inherit;
      font-size: var(--fs-small);
      cursor: pointer;
      border: 1px solid transparent;
      transition: opacity var(--dur-fast), transform var(--dur-fast);
    }
    .btn:hover { transform: translateY(-1px); }
    .btn-primary {
      background: var(--terracota);
      color: white;
      border-color: var(--terracota);
    }
    .btn-primary:hover { opacity: 0.92; }

    /* ============ MOBILE/TABLET ajustes ============ */
    @media (max-width: 768px) {
      .cat-drawer { width: 100%; }
      .recado-modal { padding: 32px 20px 24px; }
    }
  </style>

  <script>
    // =============================================
    // ELEMENTS
    // =============================================
    const introCover = document.getElementById('intro-cover')!;
    const ph1 = document.getElementById('ph1')!;
    const ph2 = document.getElementById('ph2')!;
    const scrollHint = document.getElementById('scroll-hint')!;
    const heroLogo = document.getElementById('hero-logo')!;
    const headerLogo = document.getElementById('header-logo')!;
    const sceneIntro = document.getElementById('scene-intro')!;
    const catDrawer = document.getElementById('cat-drawer')!;
    const recadoModal = document.getElementById('recado-modal')!;
    const backdrop = document.getElementById('drawer-backdrop')!;
    const catTitle = document.getElementById('cat-title')!;
    const catCount = document.getElementById('cat-count')!;
    const catResults = document.getElementById('cat-results')!;

    const dataNode = document.getElementById('recipes-data');
    const RECIPES = dataNode ? JSON.parse(dataNode.textContent!) : { byCategory: {}, counts: {}, catMeta: {} };

    let userScrolled = false;
    let typewriterDone = false;

    // "Já chegou na cozinha" — flag que persiste entre visitas.
    // Na primeira visita roda intro + hero + morph até chegar na cozinha.
    // A partir do momento que chega na cozinha (em qualquer visita), trava ali.
    const KITCHEN_REACHED_KEY = 'cozy-kitchen-reached';
    const kitchenReachedBefore = (() => {
      try { return localStorage.getItem(KITCHEN_REACHED_KEY) === 'true'; } catch (e) { return false; }
    })();
    let kitchenLocked = false;
    function lockKitchen() {
      if (kitchenLocked) return;
      kitchenLocked = true;
      try { localStorage.setItem(KITCHEN_REACHED_KEY, 'true'); } catch (e) {}
      // Cozinha vira o topo da página — esconde intro e transição.
      sceneIntro.style.display = 'none';
      const flowTransition = document.getElementById('flow-transition');
      if (flowTransition) flowTransition.style.display = 'none';
      // Hero some, header já visível e sem morph.
      heroLogo.style.display = 'none';
      headerLogo.style.opacity = '1';
      // Snap pro topo (que agora é a cozinha) sem scroll animado.
      window.scrollTo(0, 0);
    }

    if (kitchenReachedBefore) {
      // Visita recorrente / volta de outra tela: já trava direto na cozinha,
      // sem intro, sem hero, sem morph.
      introCover.style.transition = 'none';
      introCover.classList.add('wiped');
      document.body.classList.remove('intro-active');
      userScrolled = true;
      lockKitchen();
    } else {
      document.body.classList.add('intro-active');
    }

    // DEBUG: aperta 'D' pra ver os retângulos clicáveis dos hotspots.
    document.addEventListener('keydown', (e) => {
      if ((e.key === 'd' || e.key === 'D') && !['INPUT','TEXTAREA'].includes((document.activeElement?.tagName)||'')) {
        document.body.classList.toggle('hs-debug');
      }
    });

    // =============================================
    // TYPEWRITER + WIPE
    // =============================================
    // Strings i18n — usam __cozyT injetado no BaseLayout (fallback PT em runtime)
    const T = (window as any).__cozyT || ((k: string) => k);
    const TEXT_1 = T('intro.hello');
    const TEXT_2 = T('intro.welcome');
    const TYPE_SPEED = 70;
    const DELAY_BEFORE_1 = 500;
    const PAUSE_AFTER_1 = 700;
    const FADE_DUR = 350;

    const sleep = (ms: number) => new Promise(r => setTimeout(r, ms));

    async function typeInto(el: HTMLElement, text: string) {
      el.textContent = '';
      el.style.opacity = '1';
      for (let i = 0; i <= text.length; i++) {
        el.textContent = text.slice(0, i);
        await sleep(TYPE_SPEED);
      }
      el.classList.add('done');
    }

    async function revealAfterTypewriter() {
      await sleep(800);
      introCover.classList.add('wiped');
      heroLogo.classList.add('visible');
      await sleep(1400);
      document.body.classList.remove('intro-active');
      if (!userScrolled) scrollHint.classList.add('show');
    }

    async function runIntroSequence() {
      await sleep(DELAY_BEFORE_1);
      if (userScrolled) return;
      await typeInto(ph1, TEXT_1);
      if (userScrolled) return;
      await sleep(PAUSE_AFTER_1);
      if (userScrolled) return;

      ph1.style.transition = `opacity ${FADE_DUR}ms ease`;
      ph1.style.opacity = '0';
      await sleep(FADE_DUR);
      if (userScrolled) return;

      await typeInto(ph2, TEXT_2);
      typewriterDone = true;

      await sleep(600);
      if (!userScrolled) scrollHint.classList.add('show');
    }

    // Detecta scroll real
    window.addEventListener('scroll', () => {
      if (window.scrollY > 30 && !userScrolled) {
        userScrolled = true;
        scrollHint.classList.add('hidden');
      }
    }, { passive: true });

    // Esconde a cover e leva direto pra cozinha (com morph completo)
    document.getElementById('cover-skip')?.addEventListener('click', () => {
      introCover.style.transition = 'none';
      introCover.classList.add('wiped');
      // força reflow
      introCover.offsetHeight;
      document.body.classList.remove('intro-active');
      userScrolled = true;
      heroLogo.classList.add('visible');
      // Scroll suave pra cozinha — durante o scroll o morph acontece naturalmente.
      // Quando chegar na cozinha o listener de scroll abaixo chama lockKitchen().
      document.getElementById('flow-kitchen')?.scrollIntoView({ behavior: 'smooth' });
    });

    // Roda a sequência do typewriter SÓ na primeira visita
    if (!kitchenReachedBefore) {
      runIntroSequence()
        .then(() => revealAfterTypewriter());
    }

    // Detecta quando o user chega na cozinha pela primeira vez — trava ali.
    function checkKitchenReached() {
      if (kitchenLocked) return;
      const rect = sceneIntro.getBoundingClientRect();
      // Quando o fim da intro passa pelo topo da viewport, já chegou na cozinha.
      // (sceneIntro tem 100vh + flow-transition 50vh acima da cozinha)
      const flowTransition = document.getElementById('flow-transition');
      const transitionRect = flowTransition?.getBoundingClientRect();
      const reachedKitchen = transitionRect
        ? transitionRect.bottom <= 0
        : rect.bottom <= 0;
      if (reachedKitchen) lockKitchen();
    }
    window.addEventListener('scroll', checkKitchenReached, { passive: true });

    // =============================================
    // MORPH — hero diminui e morfa pro header conforme rola
    // =============================================
    let firstMorphCall = true;
    function updateMorph() {
      // Depois que a cozinha foi travada, o hero está oculto — nada a morfar.
      if (kitchenLocked) return;
      if (firstMorphCall) {
        heroLogo.style.transition = 'none';
        firstMorphCall = false;
      }
      const scrollY = window.scrollY;
      const morphRange = window.innerHeight * 0.55;
      const progress = Math.min(1, Math.max(0, scrollY / morphRange));

      const scale = 1 - progress * 0.78;
      const endX = window.innerWidth / 2;
      const endY = 28;
      const startX = window.innerWidth / 2;
      const startY = window.innerHeight / 2;
      const tx = (endX - startX) * progress;
      const ty = (endY - startY) * progress;

      let heroOp = 1;
      if (progress > 0.78) heroOp = Math.max(0, 1 - (progress - 0.78) / 0.08);

      heroLogo.style.transform =
        `translate(calc(-50% + ${tx}px), calc(-50% + ${ty}px)) scale(${scale})`;
      heroLogo.style.opacity = String(heroOp);

      let headerOp = 0;
      if (progress > 0.88) headerOp = Math.min(1, (progress - 0.88) / 0.08);
      headerLogo.style.opacity = String(headerOp);
    }
    window.addEventListener('scroll', updateMorph, { passive: true });
    window.addEventListener('resize', updateMorph);
    // Estado inicial — caso o user já esteja com scroll setado (refresh, anchor)
    updateMorph();

    // =============================================
    // DRAWERS / MODAIS
    // =============================================
    function renderRecipeList(category: string) {
      const recipes = RECIPES.byCategory[category] || [];
      catResults.innerHTML = recipes.map((r: any) => `
        <li>
          <a href="/receitas/${r.id}/">
            <div class="recipe-thumb">foto</div>
            <div>
              <div class="recipe-row-title">${r.title}</div>
              <div class="recipe-row-meta">${[`${r.time} min`, r.servings ? `${r.servings} porções` : null, r.difficulty].filter(Boolean).join(' · ')}</div>
            </div>
          </a>
        </li>
      `).join('');
      if (recipes.length === 0) {
        const emptyMsg = T('meta.no_recipes_yet') || 'ainda sem receitas por aqui...';
        catResults.innerHTML = `<li style="padding: 24px 0; color: var(--ink-mute); font-family: var(--font-mono); font-size: 14px;">${emptyMsg}</li>`;
      }
    }

    const sobreDrawer = document.getElementById('sobre-drawer')!;

    function openCategory(key: string) {
      // Pega label do dicionário i18n (category.{key}) — fallback pro PT do JSON
      const label = T(`category.${key}`) || RECIPES.catMeta[key] || key;
      catTitle.textContent = label;
      const count = RECIPES.counts[key] || 0;
      const unitKey = count === 1 ? 'search.results_count_one' : 'search.results_count_other';
      catCount.textContent = T(unitKey, { n: count });
      renderRecipeList(key);
      catDrawer.classList.add('open');
      backdrop.classList.add('open');
      document.body.classList.add('drawer-open');
    }

    function openRecado() {
      // Recado é modal centrado (não side drawer) — não encolhe a cozinha
      recadoModal.classList.add('open');
      backdrop.classList.add('open');
    }

    function openSobre() {
      sobreDrawer.classList.add('open');
      backdrop.classList.add('open');
      document.body.classList.add('drawer-open');
    }

    function closeAll() {
      catDrawer.classList.remove('open');
      recadoModal.classList.remove('open');
      sobreDrawer.classList.remove('open');
      backdrop.classList.remove('open');
      document.body.classList.remove('drawer-open');
    }

    // Tooltip flutuante
    const tooltip = document.getElementById('kitchen-tooltip')!;
    let tooltipPinTimer: number | undefined;
    function showTooltipAt(g: Element, text: string, pinMs = 0) {
      const rect = g.getBoundingClientRect();
      tooltip.textContent = text;
      tooltip.style.left = `${rect.left + rect.width / 2}px`;
      tooltip.style.top = `${rect.top}px`;
      tooltip.classList.add('show');
      window.clearTimeout(tooltipPinTimer);
      if (pinMs > 0) {
        tooltip.dataset.pinned = '1';
        tooltipPinTimer = window.setTimeout(() => {
          delete tooltip.dataset.pinned;
          if (!g.matches(':hover')) tooltip.classList.remove('show');
          else tooltip.textContent = (g as HTMLElement).dataset?.label ?? '';
        }, pinMs);
      }
    }

    // Pega a chave i18n correta pra cada hotspot baseado em action/key.
    // Pro dark-mode, escolhe a mensagem conforme o estado atual (light/dark).
    function hotspotLabelKey(ds: DOMStringMap): string | null {
      const action = ds.action;
      if (action === 'cat' && ds.key) return `category.${ds.key}`;
      if (action === 'recado') return 'hotspot.recado';
      if (action === 'sobre') return 'hotspot.sobre';
      if (action === 'dark-mode') {
        return document.body.classList.contains('dark-mode')
          ? 'hotspot.dark_mode_on'   // tá escuro → "acender"
          : 'hotspot.dark_mode_off'; // tá claro → "apagar"
      }
      return null; // akim não tem hover label (só miau no click)
    }

    // Hotspots (elementos SVG <g>/<path> com class="hs" no inline SVG)
    document.querySelectorAll<Element>('.kitchen-canvas .hs').forEach((g) => {
      const ds = (g as HTMLElement | SVGElement).dataset;
      const fire = () => {
        // Feedback visual de tap: classe que dura ~280ms (mais confiável
        // que :active em touch, que pode ser brevíssimo demais pra ser visto).
        g.classList.add('hs-pressed');
        window.setTimeout(() => g.classList.remove('hs-pressed'), 280);

        const action = ds.action;
        const key = ds.key;
        if (action === 'cat' && key) openCategory(key);
        else if (action === 'recado') openRecado();
        else if (action === 'sobre') openSobre();
        else if (action === 'akim') {
          showTooltipAt(g, T('hotspot.akim_meow') || 'miau 🐱', 1400);
          document.body.classList.add('cat-awake');
          window.setTimeout(() => document.body.classList.remove('cat-awake'), 1400);
        }
        else if (action === 'dark-mode') {
          document.body.classList.toggle('dark-mode');
          try {
            localStorage.setItem('cozy-dark-mode',
              document.body.classList.contains('dark-mode') ? 'true' : 'false');
          } catch (err) {}
        }
      };
      g.addEventListener('click', fire);
      g.addEventListener('keydown', (e: Event) => {
        const k = (e as KeyboardEvent).key;
        if (k === 'Enter' || k === ' ') { e.preventDefault(); fire(); }
      });

      // Tooltip hover — resolve a chave i18n NA HORA do show pra respeitar:
      // - troca de idioma (PT/EN)
      // - estado dinâmico (ex.: dark_mode_off/on muda com a luz)
      if (hotspotLabelKey(ds) !== null) {
        const show = () => {
          if (!tooltip.dataset.pinned) {
            const key = hotspotLabelKey(ds);
            const text = (key && (window as any).__cozyT?.(key)) || ds.label || '';
            showTooltipAt(g, text);
          }
        };
        const hide = () => { if (!tooltip.dataset.pinned) tooltip.classList.remove('show'); };
        g.addEventListener('mouseenter', show);
        g.addEventListener('mouseleave', hide);
        g.addEventListener('focus', show);
        g.addEventListener('blur', hide);
      }
    });

    // Relógio analógico — gira os ponteiros pra hora atual do navegador.
    // Cada ponteiro tem data-baked (ângulo em graus que o path já carrega
    // desenhado) e data-cx/data-cy (centro de rotação). A rotação aplicada
    // é (alvo - baked) em torno de (cx, cy).
    // querySelectorAll pega todas as instâncias (desktop, tablet, mobile-2).
    const hourHands = document.querySelectorAll<SVGGElement>('[id="clock-hour"]');
    const minuteHands = document.querySelectorAll<SVGGElement>('[id="clock-minute"]');
    const secondHands = document.querySelectorAll<SVGGElement>('[id="clock-second"]');
    function rotateHand(el: SVGGElement, target: number) {
      const baked = Number(el.dataset.baked ?? 0);
      const cx = Number(el.dataset.cx ?? 0);
      const cy = Number(el.dataset.cy ?? 0);
      const delta = target - baked;
      el.setAttribute('transform', `rotate(${delta} ${cx} ${cy})`);
    }
    function tickClock() {
      if (!hourHands.length && !minuteHands.length && !secondHands.length) return;
      const now = new Date();
      const h = now.getHours() % 12;
      const m = now.getMinutes();
      const s = now.getSeconds();
      const hourTarget = h * 30 + m * 0.5;
      const minuteTarget = m * 6 + s * 0.1;
      const secondTarget = s * 6;
      hourHands.forEach(el => rotateHand(el, hourTarget));
      minuteHands.forEach(el => rotateHand(el, minuteTarget));
      secondHands.forEach(el => rotateHand(el, secondTarget));
    }
    tickClock();
    setInterval(tickClock, 1000);

    // Mobile: botão clicável que alterna entre as duas partes da cozinha
    const mobileScroll = document.getElementById('kitchen-mobile-scroll');
    const swipeHint = document.getElementById('mobile-swipe-hint');
    if (mobileScroll && swipeHint) {
      function updateHintDirection() {
        // Se já passou da metade, a seta aponta pra esquerda (voltar pra parte 1)
        const half = mobileScroll.scrollWidth / 2;
        const isAtSecond = mobileScroll.scrollLeft > half * 0.5;
        swipeHint.classList.toggle('flipped', isAtSecond);
      }
      swipeHint.addEventListener('click', () => {
        const isAtFirst = mobileScroll.scrollLeft < mobileScroll.scrollWidth * 0.25;
        mobileScroll.scrollTo({
          left: isAtFirst ? mobileScroll.scrollWidth : 0,
          behavior: 'smooth',
        });
      });
      // Atualiza direção da seta quando scrolla (manual via swipe ou click)
      mobileScroll.addEventListener('scroll', updateHintDirection, { passive: true });
    }

    backdrop.addEventListener('click', closeAll);
    document.querySelectorAll('[data-close]').forEach(el => el.addEventListener('click', closeAll));
    document.addEventListener('keydown', e => { if (e.key === 'Escape') closeAll(); });

    // Recado → email (abre o cliente de email padrão com tudo preenchido)
    document.getElementById('r-send')?.addEventListener('click', () => {
      const nome = (document.getElementById('r-name') as HTMLInputElement).value.trim();
      const msg = (document.getElementById('r-msg') as HTMLTextAreaElement).value.trim();
      const tpl = RECIPES.emailTemplate || 'Oi Gigi, sou {nome}.\n\n{mensagem}';
      const body = tpl
        .replace('{nome}', nome || 'um visitante')
        .replace('{mensagem}', msg || 'vim do seu Cozy Corner!');
      const subject = RECIPES.emailSubject || 'Recado do Cozy Corner';
      const url = `mailto:${RECIPES.email}`
        + `?subject=${encodeURIComponent(subject)}`
        + `&body=${encodeURIComponent(body)}`;
      window.location.href = url;
    });
  </script>
</BaseLayout>
