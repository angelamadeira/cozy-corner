---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';
import { getCollection } from 'astro:content';
import { CATEGORY_META } from '../lib/categories';
import introData from '../content/pages/intro.json';
import cozinhaData from '../content/pages/cozinha.json';
import recadoData from '../content/pages/recado.json';

const recipes = await getCollection('recipes', ({ data }) => data.published);

// Agrupa receitas por categoria pra alimentar o drawer dinamicamente
const recipesByCategory: Record<string, typeof recipes> = {};
for (const r of recipes) {
  (recipesByCategory[r.data.category] ??= []).push(r);
}
// "todas" engloba todas
recipesByCategory.todas = recipes;

const countByCategory = Object.fromEntries(
  Object.entries(recipesByCategory).map(([k, v]) => [k, v.length])
);
---

<BaseLayout description="Receitas autorais da Gigi — narrativa, lenta, com carinho.">

  <!-- ===================== INTRO COVER (azul escuro, typewriter) ===================== -->
  <div class="intro-cover" id="intro-cover">
    <button class="cover-skip" id="cover-skip" type="button">
      {introData.skipLabel.replace(' ✕', '')}
      <Icon name="ph:x-thin" width={14} height={14} />
    </button>
    <p class="phrase typewriter" id="ph1"></p>
    <p class="phrase typewriter" id="ph2"></p>
  </div>

  <!-- ===================== HEADER (logo morfa pra cá) ===================== -->
  <header class="site-header">
    <div class="logo" id="header-logo">
      <span class="logo-name">Cozy Corner</span>
      <span class="logo-by">— by Gigi</span>
    </div>
  </header>

  <div class="scroll-hint" id="scroll-hint">
    <Icon name="ph:arrow-down-thin" /> role pra continuar
  </div>

  <!-- ===================== HERO (fixed, morfa pro header) ===================== -->
  <div class="hero-logo" id="hero-logo">
    <span class="hero-name">Cozy Corner</span>
    <span class="hero-by">— by Gigi</span>
  </div>

  <!-- ===================== CENA 1 — espaço pro morph acontecer ===================== -->
  <section id="scene-intro" aria-hidden="true"></section>

  <!-- ===================== TRANSIÇÃO BG ===================== -->
  <section id="flow-transition" aria-hidden="true"></section>

  <!-- ===================== COZINHA ===================== -->
  <section id="flow-kitchen">
    <p class="kitchen-title">cozinha · clique em qualquer elemento</p>
    <div class="kitchen-canvas">
      <svg class="scene" viewBox="0 0 1500 1000" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Cozinha com elementos clicáveis">
        <!-- Estrutura (não-clicável) -->
        <rect x="128.048" y="859.93" width="1320.45" height="341.57" stroke="currentColor" stroke-width="5"/>
        <rect x="969.717" y="468.094" width="417.956" height="393.909" stroke="currentColor" stroke-width="5"/>
        <path d="M275.492 560.37H814.443" stroke="currentColor" stroke-width="5"/>
        <path d="M967.217 472.667L1390.17 472.667" stroke="currentColor" stroke-width="5"/>

        <!-- Para congelar (geladeira superior) -->
        <g class="hs" data-action="cat" data-key="congelar" role="button" aria-label="Para congelar" data-label="para congelar" tabindex="0">
          <rect x="969.717" y="264.396" width="417.956" height="205.771" stroke="currentColor" stroke-width="5"/>
        </g>
        <!-- Pratos principais -->
        <g class="hs" data-action="cat" data-key="principais" role="button" aria-label="Pratos principais" data-label="pratos principais" tabindex="0">
          <rect x="419.449" y="765.154" width="221.331" height="96.8491" stroke="currentColor" stroke-width="5"/>
        </g>
        <!-- Sobremesas -->
        <g class="hs" data-action="cat" data-key="sobremesas" role="button" aria-label="Sobremesas" data-label="sobremesas" tabindex="0">
          <rect x="732.069" y="765.154" width="137.872" height="96.8491" stroke="currentColor" stroke-width="5"/>
        </g>
        <!-- Receitas rápidas (relógio) -->
        <g class="hs" data-action="cat" data-key="rapidas" role="button" aria-label="Receitas rápidas" data-label="receitas rápidas" tabindex="0">
          <circle cx="786.824" cy="221.347" r="83.7888" stroke="currentColor" stroke-width="5"/>
          <path d="M786.824 166.179V223.505L817.944 253.883" stroke="currentColor" stroke-width="5"/>
        </g>
        <!-- Vegetarianas (vaso + planta) -->
        <g class="hs" data-action="cat" data-key="vegetarianas" role="button" aria-label="Vegetarianas" data-label="vegetarianas" tabindex="0">
          <rect x="1201.71" y="169.62" width="136.457" height="96.8491" stroke="currentColor" stroke-width="5"/>
          <path d="M1181.18 126.031L1236.53 168.907H1284.07V162.394H1410.38L1298.26 143.399L1333.75 113.549L1259.24 136.343L1236.53 78V136.343L1181.18 126.031Z" stroke="currentColor" stroke-width="5"/>
        </g>
        <!-- Datas comemorativas (calendário) -->
        <g class="hs" data-action="cat" data-key="datas" role="button" aria-label="Datas comemorativas" data-label="datas comemorativas" tabindex="0">
          <rect x="1043.27" y="550.139" width="133.628" height="129.384" stroke="currentColor" stroke-width="5"/>
          <rect x="1061.66" y="592.576" width="23.2914" height="20.4623" stroke="currentColor" stroke-width="5"/>
          <rect x="1061.66" y="627.94" width="23.2914" height="20.4623" stroke="currentColor" stroke-width="5"/>
          <rect x="1098.44" y="592.576" width="23.2914" height="20.4623" stroke="currentColor" stroke-width="5"/>
          <rect x="1098.44" y="627.94" width="23.2914" height="20.4623" stroke="currentColor" stroke-width="5"/>
          <rect x="1135.22" y="592.576" width="23.2914" height="20.4623" stroke="currentColor" stroke-width="5"/>
          <rect x="1135.22" y="627.94" width="23.2914" height="20.4623" stroke="currentColor" stroke-width="5"/>
        </g>
        <!-- Deixe seu recado (post-it) -->
        <g class="hs" data-action="recado" role="button" aria-label="Deixe seu recado" data-label="deixe seu recado" tabindex="0">
          <rect x="1278.15" y="529.925" width="79.279" height="76.699" transform="rotate(37.465 1278.15 529.925)" stroke="currentColor" stroke-width="5"/>
        </g>
        <!-- Sobre mim (quadro) -->
        <g class="hs" data-action="sobre" role="button" aria-label="Sobre mim" data-label="sobre mim" tabindex="0">
          <rect x="343.062" y="397.365" width="146.359" height="163.334" stroke="currentColor" stroke-width="5"/>
          <rect x="355.793" y="411.511" width="120.897" height="135.042" stroke="currentColor" stroke-width="5"/>
        </g>
        <!-- Todas as receitas (livros) -->
        <g class="hs" data-action="cat" data-key="todas" role="button" aria-label="Todas as receitas" data-label="todas as receitas" tabindex="0">
          <rect x="577.881" y="509.117" width="156.261" height="27.5351" stroke="currentColor" stroke-width="5"/>
          <rect x="577.881" y="534.579" width="156.261" height="26.1205" stroke="currentColor" stroke-width="5"/>
        </g>
        <!-- Dark mode (interruptor) -->
        <g class="hs" data-action="dark-mode" role="button" aria-label="Dark mode (liga/desliga)" data-label="dark mode" tabindex="0">
          <rect x="50.2463" y="516.19" width="77.0451" height="96.8491" stroke="currentColor" stroke-width="5"/>
          <rect x="72.8794" y="544.481" width="30.3643" height="38.8517" stroke="currentColor" stroke-width="5"/>
        </g>
        <!-- Akim (gato) -->
        <g class="hs" data-action="akim" role="button" aria-label="Akim" tabindex="0">
          <path d="M158.033 755.725C166.743 762.978 172.228 773.535 172.228 785.287L172.214 786.309C172.171 787.894 172.025 789.457 171.788 790.991C184.918 787.371 200.318 785.287 216.787 785.287L219.032 785.3C266.041 785.842 303.783 803.362 303.783 824.896L303.777 825.407C303.174 847.046 264.458 864.503 216.787 864.503L214.542 864.49C167.907 863.952 130.391 846.705 129.798 825.407L129.791 824.895L128.696 824.882C106.128 824.348 87.939 807.371 87.3674 786.309L87.3538 785.287C87.3538 781.398 87.9571 777.641 89.0764 774.09L88.3225 774.809L80.3782 741.961L109.448 750.52C115.489 747.434 122.42 745.679 129.791 745.679L130.886 745.691C131 745.694 131.115 745.7 131.229 745.703L150.251 726.682L158.033 755.725ZM216.787 790.287C199.547 790.287 183.637 792.632 170.478 796.572C165.729 811.508 151.801 822.755 134.794 824.619C134.792 824.711 134.791 824.804 134.791 824.896C134.792 832.671 141.941 841.339 157.344 848.352C172.299 855.16 193.311 859.503 216.787 859.503C240.264 859.503 261.275 855.16 276.231 848.352C291.634 841.339 298.783 832.671 298.783 824.896C298.783 817.12 291.635 808.452 276.231 801.438C261.275 794.63 240.264 790.287 216.787 790.287ZM127.071 750.77C107.384 752.065 92.354 767.313 92.3538 785.287C92.354 804.081 108.785 819.894 129.791 819.895C130.022 819.895 130.252 819.891 130.481 819.887C133.596 808.648 147.054 798.876 166.377 792.61C166.933 790.242 167.228 787.791 167.228 785.287C167.228 774.021 161.322 763.828 152.068 757.468L127.071 750.77ZM164.344 798.595C161.887 799.485 159.549 800.434 157.344 801.438C145.476 806.842 138.508 813.228 135.935 819.432C148.932 817.46 159.49 809.337 164.344 798.595ZM91.1467 765.216L103.078 753.855L87.2737 749.202L91.1467 765.216ZM137.645 746.358C142.697 747.241 147.434 748.958 151.685 751.353L147.663 736.34L137.645 746.358Z" fill="currentColor"/>
        </g>
      </svg>
    </div>
  </section>

  <!-- ===================== DRAWERS / MODAIS ===================== -->
  <div class="drawer-backdrop" id="drawer-backdrop"></div>

  <!-- Category drawer (renderiza receitas dinamicamente via JS) -->
  <aside class="cat-drawer" id="cat-drawer" aria-hidden="true" aria-labelledby="cat-title">
    <button class="drawer-close" data-close type="button" aria-label="fechar">
      <Icon name="ph:x-thin" width={20} height={20} />
    </button>
    <button class="drawer-crumb" data-close type="button">
      <Icon name="ph:arrow-left-thin" /> voltar pra cozinha
    </button>
    <h2 id="cat-title" class="drawer-title">Pratos principais</h2>
    <p class="drawer-count" id="cat-count">0 receitas</p>

    <div class="drawer-search">
      <Icon name="ph:magnifying-glass-thin" width={16} height={16} />
      <input class="search-input" type="search" placeholder="buscar nesta categoria..." />
    </div>

    <div class="drawer-filters">
      <span class="chip chip-active">todas</span>
      <span class="chip">até 30 min</span>
      <span class="chip">vegetariana</span>
      <span class="chip">sem glúten</span>
    </div>

    <ul class="recipe-list" id="cat-results"></ul>
  </aside>

  <!-- Sobre mim drawer -->
  <aside class="cat-drawer" id="sobre-drawer" aria-hidden="true" aria-labelledby="sobre-title">
    <button class="drawer-close" data-close type="button" aria-label="fechar">
      <Icon name="ph:x-thin" width={20} height={20} />
    </button>
    <h2 id="sobre-title" class="drawer-title">Oi, sou a Gigi</h2>
    <p class="drawer-prose">
      Cozinhar é meu jeito de juntar gente. Esse cantinho é onde eu vou guardando
      o que aprendi — receitas autorais, herdadas, adaptadas — pra ter sempre à
      mão e pra dividir com quem aparece.
    </p>
    <p class="drawer-prose">
      Mais sobre mim, sobre o blog e sobre as cozinhas que me inspiram em breve
      por aqui. Por enquanto: fica à vontade pra bisbilhotar as gavetas. 💛
    </p>
  </aside>

  <!-- Tooltip flutuante dos hotspots -->
  <div class="kitchen-tooltip" id="kitchen-tooltip" role="tooltip"></div>

  <!-- Recado modal (post-it) -->
  <div class="recado-modal" id="recado-modal" aria-hidden="true" role="dialog" aria-labelledby="recado-title">
    <button class="drawer-close" data-close type="button" aria-label="fechar">
      <Icon name="ph:x-thin" width={20} height={20} />
    </button>
    <h2 id="recado-title" class="recado-title">{recadoData.title}</h2>
    <p class="recado-sub">{recadoData.subtitle}</p>
    <label class="field-label">seu nome</label>
    <input class="field-input" id="r-name" type="text" />
    <label class="field-label">mensagem</label>
    <textarea class="field-input" id="r-msg" placeholder={`oi Gigi!`}></textarea>
    <button class="btn btn-primary recado-send" id="r-send" type="button">
      <Icon name="ph:whatsapp-logo-thin" /> enviar pelo WhatsApp
    </button>
    <p class="recado-alt">ou me escreve em <a href={`mailto:${recadoData.emailFallback}`}>{recadoData.emailFallback}</a></p>
  </div>

  <!-- Recipes data pra o drawer (renderizado via JS) -->
  <script type="application/json" id="recipes-data" set:html={JSON.stringify({
    byCategory: Object.fromEntries(
      Object.entries(recipesByCategory).map(([k, v]) => [
        k,
        v.map(r => ({
          id: r.id,
          title: r.data.title,
          time: r.data.time,
          servings: r.data.servings,
          difficulty: r.data.difficulty,
        }))
      ])
    ),
    counts: countByCategory,
    catMeta: Object.fromEntries(Object.entries(CATEGORY_META).map(([k, v]) => [k, v.label])),
    catMetaTodas: 'Todas as receitas',
    whatsappNumber: recadoData.whatsappNumber,
    whatsappTemplate: recadoData.whatsappTemplate,
  })}></script>

  <style>
    /* ============ ÍCONES (line art, herdam cor) ============ */
    [data-icon] svg, svg { fill: none; stroke: currentColor; }
    .icon-dark { display: none; }
    body.dark-mode .icon-light { display: none; }
    body.dark-mode .icon-dark { display: inline-block; }

    /* ============ INTRO COVER ============ */
    body.intro-active { overflow: hidden; }

    .intro-cover {
      position: fixed;
      inset: 0;
      background: var(--cover-dark);
      color: white;
      z-index: 200;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0 var(--s-5);
      text-align: center;
      clip-path: inset(0 0 0 0);
      transition: clip-path 1.4s var(--ease-in-out);
    }
    .intro-cover.wiped {
      clip-path: inset(100% 0 0 0);
      pointer-events: none;
    }
    .cover-skip {
      position: absolute;
      top: 20px; right: var(--s-6);
      background: transparent;
      border: none;
      color: white;
      opacity: 0.55;
      font-family: var(--font-mono);
      font-size: var(--fs-caption);
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 4px;
      transition: opacity var(--dur-fast);
      z-index: 5;
    }
    .cover-skip:hover { opacity: 1; }
    .intro-cover .phrase {
      position: absolute;
      font-family: var(--font-mono);
      font-size: var(--fs-intro);
      color: white;
      opacity: 0;
      max-width: 820px;
      padding: 0 var(--s-5);
      line-height: var(--lh-snug);
    }
    .phrase.typewriter::after {
      content: '|';
      display: inline-block;
      margin-left: 4px;
      opacity: 0.6;
      animation: caret 0.9s steps(2) infinite;
    }
    .phrase.typewriter.done::after { content: ''; }
    @keyframes caret {
      0%, 50% { opacity: 0.6; }
      51%, 100% { opacity: 0; }
    }

    /* ============ HEADER ============ */
    .site-header {
      position: fixed;
      top: 0; left: 0; right: 0;
      height: var(--header-h);
      padding: 0 var(--s-6);
      z-index: 100;
    }
    .site-header .logo {
      position: absolute;
      top: 50%; left: 50%;
      transform: translate(-50%, -50%);
      display: flex;
      flex-direction: column;
      align-items: flex-end; /* "— by Gigi" alinhado à direita */
      line-height: 1.1;
      opacity: 0;
    }
    .logo-name {
      font-family: var(--font-brand);
      font-weight: 600;
      font-size: 22px;
      line-height: 1;
      letter-spacing: 0;
    }
    .logo-by {
      font-family: var(--font-mono);
      font-size: 10px;
      opacity: 0.55;
      margin-top: 1px;
    }

    /* ============ HERO (morfa pro header) ============ */
    .hero-logo {
      position: fixed;
      top: 50%; left: 50%;
      transform: translate(-50%, -50%);
      transform-origin: center center;
      display: flex;
      flex-direction: column;
      align-items: flex-end; /* "— by Gigi" alinhado à direita do "Cozy Corner" */
      gap: var(--s-2);
      opacity: 0;
      z-index: 80;
      pointer-events: none;
      will-change: transform, opacity;
      transition: opacity 1s var(--ease-out) 0.3s;
    }
    .hero-logo.visible { opacity: 1; }
    .hero-name {
      font-family: var(--font-brand);
      font-weight: 600;
      font-size: clamp(64px, 12vw, 128px);
      letter-spacing: 0;
      line-height: 1;
      color: var(--ink);
      white-space: nowrap;
    }
    .hero-by {
      font-family: var(--font-mono);
      font-size: clamp(13px, 1.8vw, 18px);
      opacity: 0.55;
      color: var(--ink);
    }

    /* Hero pousa sobre var(--bg) que adapta light/dark naturalmente */

    /* ============ SCROLL HINT ============ */
    .scroll-hint {
      position: fixed;
      bottom: var(--s-6);
      left: 50%;
      transform: translateX(-50%);
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-family: var(--font-mono);
      font-size: var(--fs-caption);
      color: var(--ink-soft);
      opacity: 0;
      z-index: 90;
      transition: opacity var(--dur-base);
      pointer-events: none;
      animation: bob 1.8s ease-in-out infinite;
    }
    .scroll-hint.show { opacity: 0.65; }
    .scroll-hint.hidden { opacity: 0; }
    @keyframes bob {
      0%, 100% { transform: translateX(-50%) translateY(0); }
      50% { transform: translateX(-50%) translateY(6px); }
    }

    /* ============ SEÇÕES DA HOMEPAGE ============ */
    /* Tudo no cream warm de --bg. Azul e terracota são acentos/detalhes. */
    #scene-intro {
      min-height: 100vh;
      background: var(--bg);
    }
    #flow-transition {
      height: 50vh;
      background: var(--bg);
    }

    /* ============ COZINHA ============ */
    #flow-kitchen {
      background: var(--bg);
      padding: var(--s-7) var(--s-6) 0; /* sem padding-bottom — cozinha encosta na borda */
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
    }
    .kitchen-title {
      max-width: var(--max-content);
      margin: 0 auto var(--s-3);
      font-family: var(--font-mono);
      font-size: var(--fs-caption);
      color: var(--ink-mute);
      text-transform: lowercase;
      letter-spacing: 0.05em;
    }
    .kitchen-canvas {
      position: relative;
      width: 70%;
      aspect-ratio: 1500 / 1000;
      margin: 0 auto;
      color: var(--ink);
    }
    .kitchen-canvas .scene {
      width: 100%;
      height: 100%;
      display: block;
    }
    /* Hotspots no SVG — área = bbox do grupo */
    .kitchen-canvas .scene :global(.hs) {
      cursor: pointer;
      pointer-events: bounding-box;
      transition: transform 200ms ease;
      transform-box: fill-box;
      transform-origin: center;
    }
    .kitchen-canvas .scene :global(.hs:hover) { transform: scale(1.04); }
    .kitchen-canvas .scene :global(.hs:hover > rect),
    .kitchen-canvas .scene :global(.hs:hover > circle),
    .kitchen-canvas .scene :global(.hs:hover > path) {
      stroke: var(--terracota);
    }
    .kitchen-canvas .scene :global(.hs:hover > path[fill="currentColor"]) {
      fill: var(--terracota);
    }
    .kitchen-canvas .scene :global(.hs:focus) { outline: none; }
    .kitchen-canvas .scene :global(.hs:focus-visible) {
      outline: 2px solid var(--terracota);
      outline-offset: 4px;
    }

    /* Quando um drawer abre, encolhe o body, alinha cena ao bottom */
    body {
      transition: padding-right 0.45s var(--ease-out);
    }
    @media (min-width: 960px) {
      body.drawer-open {
        padding-right: 520px;
      }
      body.drawer-open #flow-kitchen {
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        min-height: 100vh;
      }
    }

    /* Tooltip flutuante */
    .kitchen-tooltip {
      position: fixed;
      transform: translate(-50%, -100%) translateY(-18px);
      background: var(--ink);
      color: var(--bg);
      font-family: var(--font-mono);
      font-size: var(--fs-meta);
      letter-spacing: 0.02em;
      padding: 8px 14px;
      border-radius: var(--r-sm);
      box-shadow: var(--shadow-1);
      pointer-events: none;
      white-space: nowrap;
      opacity: 0;
      transition: opacity var(--dur-fast);
      z-index: 300;
    }
    .kitchen-tooltip::after {
      content: '';
      position: absolute;
      top: 100%; left: 50%;
      transform: translateX(-50%);
      border: 5px solid transparent;
      border-top-color: var(--ink);
    }
    .kitchen-tooltip.show { opacity: 1; }

    /* Drawer prose pra sobre mim */
    .drawer-prose {
      font-family: var(--font-mono);
      font-size: var(--fs-body);
      line-height: var(--lh-loose);
      color: var(--ink-soft);
      margin-bottom: var(--s-4);
    }

    /* ============ DRAWERS / MODAL ============ */
    .drawer-backdrop {
      position: fixed; inset: 0;
      background: rgba(26,26,26,0.2);
      opacity: 0; visibility: hidden;
      transition: opacity var(--dur-base), visibility var(--dur-base);
      z-index: 150;
    }
    .drawer-backdrop.open { opacity: 1; visibility: visible; }

    .cat-drawer {
      position: fixed;
      top: 0; right: 0; bottom: 0;
      width: 520px;
      max-width: 100vw;
      background: var(--bg);
      border-left: 1px solid var(--line);
      box-shadow: var(--shadow-3);
      transform: translateX(100%);
      transition: transform 0.5s var(--ease-out);
      z-index: 200;
      overflow-y: auto;
      padding: var(--s-7) var(--s-6);
    }
    .cat-drawer.open { transform: translateX(0); }

    .drawer-close {
      position: absolute;
      top: var(--s-3); right: var(--s-3);
      background: transparent;
      border: none;
      cursor: pointer;
      color: var(--ink-soft);
      width: 36px; height: 36px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: var(--r-pill);
    }
    .drawer-close:hover { background: var(--surface); }

    .drawer-crumb {
      background: transparent;
      border: none;
      cursor: pointer;
      color: var(--ink-soft);
      font-family: var(--font-mono);
      font-size: var(--fs-meta);
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 0;
      margin-bottom: var(--s-5);
    }
    .drawer-crumb:hover { color: var(--terracota); }

    .drawer-title {
      font-family: var(--font-display);
      font-weight: 500;
      font-size: var(--fs-h2);
      letter-spacing: -0.01em;
      margin-bottom: var(--s-1);
    }
    .drawer-count {
      font-family: var(--font-mono);
      font-size: var(--fs-meta);
      color: var(--ink-mute);
      margin-bottom: var(--s-5);
    }

    .drawer-search {
      position: relative;
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 10px 12px;
      border: 1px solid var(--line);
      border-radius: var(--r-sm);
      background: var(--surface);
      margin-bottom: var(--s-3);
      color: var(--ink-soft);
    }
    .drawer-search .search-input {
      flex: 1;
      background: transparent;
      border: none;
      font: inherit;
      font-family: var(--font-mono);
      font-size: var(--fs-small);
      outline: none;
      color: var(--ink);
    }
    .drawer-search .search-input::placeholder { color: var(--ink-mute); }

    .drawer-filters {
      display: flex;
      flex-wrap: wrap;
      gap: var(--s-2);
      margin-bottom: var(--s-5);
    }
    .chip {
      padding: 4px 12px;
      border: 1px solid var(--line);
      border-radius: var(--r-pill);
      font-family: var(--font-mono);
      font-size: var(--fs-caption);
      cursor: pointer;
      background: var(--bg);
      color: var(--ink-soft);
      transition: all var(--dur-fast);
    }
    .chip:hover { border-color: var(--terracota); color: var(--ink); }
    .chip-active, .chip-active:hover {
      background: var(--ink);
      color: var(--bg);
      border-color: var(--ink);
    }

    /* recipe-list é populada via JS innerHTML — precisa ser :global pra
       o CSS do Astro alcançar os elementos dinâmicos */
    .recipe-list { list-style: none; }
    .recipe-list :global(li) {
      border-bottom: 1px solid var(--line-soft);
    }
    .recipe-list :global(a) {
      display: grid;
      grid-template-columns: 80px 1fr;
      gap: var(--s-4);
      padding: var(--s-3) 0;
      text-decoration: none;
      color: inherit;
      align-items: center;
    }
    .recipe-list :global(a:hover .recipe-row-title) { color: var(--terracota); }
    .recipe-list :global(.recipe-thumb) {
      aspect-ratio: 1;
      background: var(--surface);
      border: 1px dashed var(--line);
      border-radius: var(--r-sm);
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-mono);
      font-size: 10px;
      color: var(--ink-mute);
    }
    .recipe-list :global(.recipe-row-title) {
      font-family: var(--font-display);
      font-weight: 600;
      font-size: var(--fs-h3);
      margin-bottom: 2px;
      transition: color var(--dur-fast);
    }
    .recipe-list :global(.recipe-row-meta) {
      font-family: var(--font-mono);
      font-size: var(--fs-meta);
      color: var(--ink-mute);
    }

    /* Recado modal */
    .recado-modal {
      position: fixed;
      top: 50%; left: 50%;
      transform: translate(-50%, -50%) scale(0.96);
      width: 440px;
      max-width: calc(100vw - 32px);
      background: var(--bg);
      border-radius: var(--r-lg);
      box-shadow: var(--shadow-3);
      padding: 40px 32px 32px;
      z-index: 220;
      opacity: 0;
      visibility: hidden;
      transition: opacity var(--dur-base), transform var(--dur-base), visibility var(--dur-base);
    }
    .recado-modal.open {
      opacity: 1;
      visibility: visible;
      transform: translate(-50%, -50%) scale(1);
    }
    .recado-modal::before {
      content: '';
      position: absolute;
      top: -8px; left: 50%;
      transform: translateX(-50%) rotate(-2deg);
      width: 90px; height: 16px;
      background: #FBE9A6;
      border-radius: 2px;
      box-shadow: 0 1px 2px rgba(0,0,0,0.1);
    }
    .recado-title {
      font-family: var(--font-display);
      font-weight: 500;
      font-size: var(--fs-h2);
      letter-spacing: -0.01em;
      margin-bottom: 6px;
    }
    .recado-sub {
      color: var(--ink-soft);
      font-size: var(--fs-small);
      margin-bottom: var(--s-5);
    }
    .field-label {
      display: block;
      font-family: var(--font-mono);
      font-size: var(--fs-meta);
      color: var(--ink-soft);
      margin-top: var(--s-3);
      margin-bottom: 4px;
    }
    .field-input {
      width: 100%;
      padding: 10px 12px;
      border: 1px solid var(--line);
      border-radius: var(--r-sm);
      font: inherit;
      font-family: var(--font-mono);
      font-size: var(--fs-small);
      background: var(--bg);
      color: var(--ink);
    }
    textarea.field-input { min-height: 90px; resize: vertical; }
    .recado-send { margin-top: var(--s-5); width: 100%; justify-content: center; }
    .recado-alt {
      text-align: center;
      font-family: var(--font-mono);
      font-size: var(--fs-caption);
      color: var(--ink-mute);
      margin-top: var(--s-4);
    }
    .recado-alt a {
      color: var(--ink-soft);
      text-decoration: underline;
    }

    /* ============ BOTÕES ============ */
    .btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 10px 14px;
      border-radius: var(--r-sm);
      font: inherit;
      font-size: var(--fs-small);
      cursor: pointer;
      border: 1px solid transparent;
      transition: opacity var(--dur-fast), transform var(--dur-fast);
    }
    .btn:hover { transform: translateY(-1px); }
    .btn-primary {
      background: var(--terracota);
      color: white;
      border-color: var(--terracota);
    }
    .btn-primary:hover { opacity: 0.92; }

    /* ============ MOBILE ============ */
    @media (max-width: 768px) {
      #flow-kitchen { padding: var(--s-6) var(--s-4) var(--s-7); }
      .kitchen-canvas { aspect-ratio: 3/4; }
      .hs-vaso        { top: 10%; left: 8%;  width: 22%; height: 12%; }
      .hs-livros      { top: 10%; right: 8%; width: 22%; height: 12%; }
      .hs-relogio     { top: 26%; left: 38%; width: 24%; height: 8%; }
      .hs-prato       { top: 40%; left: 16%; width: 28%; height: 8%; }
      .hs-doce        { top: 40%; right: 16%; width: 28%; height: 8%; }
      .hs-freezer     { top: 56%; left: 25%; width: 50%; height: 10%; }
      .hs-calendario  { top: 70%; left: 18%; width: 28%; height: 10%; }
      .hs-postit      { top: 70%; right: 18%; width: 28%; height: 10%; }
      .hs-switch      { top: 18%; right: 8%; width: 8%; height: 6%; }
      .cat-drawer { width: 100%; }
      .recado-modal { padding: 32px 20px 24px; }
    }
  </style>

  <script>
    // =============================================
    // ELEMENTS
    // =============================================
    const introCover = document.getElementById('intro-cover')!;
    const ph1 = document.getElementById('ph1')!;
    const ph2 = document.getElementById('ph2')!;
    const scrollHint = document.getElementById('scroll-hint')!;
    const heroLogo = document.getElementById('hero-logo')!;
    const headerLogo = document.getElementById('header-logo')!;
    const sceneIntro = document.getElementById('scene-intro')!;
    const catDrawer = document.getElementById('cat-drawer')!;
    const recadoModal = document.getElementById('recado-modal')!;
    const backdrop = document.getElementById('drawer-backdrop')!;
    const catTitle = document.getElementById('cat-title')!;
    const catCount = document.getElementById('cat-count')!;
    const catResults = document.getElementById('cat-results')!;

    const dataNode = document.getElementById('recipes-data');
    const RECIPES = dataNode ? JSON.parse(dataNode.textContent!) : { byCategory: {}, counts: {}, catMeta: {} };

    let userScrolled = false;
    let typewriterDone = false;

    // Intro só roda na PRIMEIRA visita. Próximas vão direto pro hero.
    const INTRO_SEEN_KEY = 'cozy-intro-seen';
    const introSeen = (() => {
      try { return localStorage.getItem(INTRO_SEEN_KEY) === 'true'; } catch (e) { return false; }
    })();
    function markIntroSeen() {
      try { localStorage.setItem(INTRO_SEEN_KEY, 'true'); } catch (e) {}
    }

    if (introSeen) {
      // Skip intro: já viu antes, vai direto pra cozinha sem morph animado
      introCover.style.transition = 'none';
      introCover.classList.add('wiped');
      document.body.classList.remove('intro-active');
      heroLogo.classList.add('visible');
      userScrolled = true;
      // Pula pro flow-kitchen instantaneamente — sem scroll suave, sem morph visível
      requestAnimationFrame(() => {
        document.getElementById('flow-kitchen')?.scrollIntoView({ behavior: 'auto', block: 'start' });
      });
    } else {
      document.body.classList.add('intro-active');
    }

    // =============================================
    // TYPEWRITER + WIPE
    // =============================================
    const TEXT_1 = 'olá!';
    const TEXT_2 = 'que bom te ver por aqui :)';
    const TYPE_SPEED = 70;
    const DELAY_BEFORE_1 = 500;
    const PAUSE_AFTER_1 = 700;
    const FADE_DUR = 350;

    const sleep = (ms: number) => new Promise(r => setTimeout(r, ms));

    async function typeInto(el: HTMLElement, text: string) {
      el.textContent = '';
      el.style.opacity = '1';
      for (let i = 0; i <= text.length; i++) {
        el.textContent = text.slice(0, i);
        await sleep(TYPE_SPEED);
      }
      el.classList.add('done');
    }

    async function revealAfterTypewriter() {
      await sleep(800);
      introCover.classList.add('wiped');
      heroLogo.classList.add('visible');
      await sleep(1400);
      document.body.classList.remove('intro-active');
      if (!userScrolled) scrollHint.classList.add('show');
    }

    async function runIntroSequence() {
      await sleep(DELAY_BEFORE_1);
      if (userScrolled) return;
      await typeInto(ph1, TEXT_1);
      if (userScrolled) return;
      await sleep(PAUSE_AFTER_1);
      if (userScrolled) return;

      ph1.style.transition = `opacity ${FADE_DUR}ms ease`;
      ph1.style.opacity = '0';
      await sleep(FADE_DUR);
      if (userScrolled) return;

      await typeInto(ph2, TEXT_2);
      typewriterDone = true;

      await sleep(600);
      if (!userScrolled) scrollHint.classList.add('show');
    }

    // Detecta scroll real
    window.addEventListener('scroll', () => {
      if (window.scrollY > 30 && !userScrolled) {
        userScrolled = true;
        scrollHint.classList.add('hidden');
      }
    }, { passive: true });

    // Esconde a cover e leva direto pra cozinha (com morph completo)
    document.getElementById('cover-skip')?.addEventListener('click', () => {
      introCover.style.transition = 'none';
      introCover.classList.add('wiped');
      // força reflow
      introCover.offsetHeight;
      document.body.classList.remove('intro-active');
      userScrolled = true;
      heroLogo.classList.add('visible');
      // Scroll suave pra cozinha — durante o scroll o morph acontece naturalmente
      document.getElementById('flow-kitchen')?.scrollIntoView({ behavior: 'smooth' });
      markIntroSeen();
    });

    // Roda a sequência do typewriter SÓ na primeira visita
    if (!introSeen) {
      runIntroSequence()
        .then(() => revealAfterTypewriter())
        .then(() => markIntroSeen());
    }

    // =============================================
    // MORPH — hero diminui e morfa pro header conforme rola
    // =============================================
    let firstMorphCall = true;
    function updateMorph() {
      if (firstMorphCall) {
        heroLogo.style.transition = 'none';
        firstMorphCall = false;
      }
      const scrollY = window.scrollY;
      const morphRange = window.innerHeight * 0.55;
      const progress = Math.min(1, Math.max(0, scrollY / morphRange));

      const scale = 1 - progress * 0.78;
      const endX = window.innerWidth / 2;
      const endY = 28;
      const startX = window.innerWidth / 2;
      const startY = window.innerHeight / 2;
      const tx = (endX - startX) * progress;
      const ty = (endY - startY) * progress;

      let heroOp = 1;
      if (progress > 0.78) heroOp = Math.max(0, 1 - (progress - 0.78) / 0.08);

      heroLogo.style.transform =
        `translate(calc(-50% + ${tx}px), calc(-50% + ${ty}px)) scale(${scale})`;
      heroLogo.style.opacity = String(heroOp);

      let headerOp = 0;
      if (progress > 0.88) headerOp = Math.min(1, (progress - 0.88) / 0.08);
      headerLogo.style.opacity = String(headerOp);
    }
    window.addEventListener('scroll', updateMorph, { passive: true });
    window.addEventListener('resize', updateMorph);
    // Estado inicial — caso o user já esteja com scroll setado (refresh, anchor)
    updateMorph();

    // =============================================
    // DRAWERS / MODAIS
    // =============================================
    function renderRecipeList(category: string) {
      const recipes = RECIPES.byCategory[category] || [];
      catResults.innerHTML = recipes.map((r: any) => `
        <li>
          <a href="/receitas/${r.id}/">
            <div class="recipe-thumb">foto</div>
            <div>
              <div class="recipe-row-title">${r.title}</div>
              <div class="recipe-row-meta">${r.time} min · ${r.servings} porções · ${r.difficulty}</div>
            </div>
          </a>
        </li>
      `).join('');
      if (recipes.length === 0) {
        catResults.innerHTML = `<li style="padding: 24px 0; color: var(--ink-mute); font-family: var(--font-mono); font-size: 14px;">ainda sem receitas por aqui...</li>`;
      }
    }

    const sobreDrawer = document.getElementById('sobre-drawer')!;

    function openCategory(key: string) {
      const label = key === 'todas' ? (RECIPES.catMetaTodas || 'Todas as receitas') : (RECIPES.catMeta[key] || key);
      catTitle.textContent = label;
      const count = RECIPES.counts[key] || 0;
      catCount.textContent = `${count} receita${count === 1 ? '' : 's'}`;
      renderRecipeList(key);
      catDrawer.classList.add('open');
      backdrop.classList.add('open');
      document.body.classList.add('drawer-open');
    }

    function openRecado() {
      // Recado é modal centrado (não side drawer) — não encolhe a cozinha
      recadoModal.classList.add('open');
      backdrop.classList.add('open');
    }

    function openSobre() {
      sobreDrawer.classList.add('open');
      backdrop.classList.add('open');
      document.body.classList.add('drawer-open');
    }

    function closeAll() {
      catDrawer.classList.remove('open');
      recadoModal.classList.remove('open');
      sobreDrawer.classList.remove('open');
      backdrop.classList.remove('open');
      document.body.classList.remove('drawer-open');
    }

    // Tooltip flutuante
    const tooltip = document.getElementById('kitchen-tooltip')!;
    let tooltipPinTimer: number | undefined;
    function showTooltipAt(g: SVGGElement, text: string, pinMs = 0) {
      const rect = g.getBoundingClientRect();
      tooltip.textContent = text;
      tooltip.style.left = `${rect.left + rect.width / 2}px`;
      tooltip.style.top = `${rect.top}px`;
      tooltip.classList.add('show');
      window.clearTimeout(tooltipPinTimer);
      if (pinMs > 0) {
        tooltip.dataset.pinned = '1';
        tooltipPinTimer = window.setTimeout(() => {
          delete tooltip.dataset.pinned;
          if (!g.matches(':hover')) tooltip.classList.remove('show');
          else tooltip.textContent = g.dataset.label ?? '';
        }, pinMs);
      }
    }

    // Hotspots (SVG groups)
    document.querySelectorAll<SVGGElement>('.kitchen-canvas .hs').forEach((g) => {
      const fire = () => {
        const action = g.dataset.action;
        const key = g.dataset.key;
        if (action === 'cat' && key) openCategory(key);
        else if (action === 'recado') openRecado();
        else if (action === 'sobre') openSobre();
        else if (action === 'akim') showTooltipAt(g, 'miau 🐱', 1400);
        else if (action === 'dark-mode') {
          document.body.classList.toggle('dark-mode');
          try {
            localStorage.setItem('cozy-dark-mode',
              document.body.classList.contains('dark-mode') ? 'true' : 'false');
          } catch (err) {}
        }
      };
      g.addEventListener('click', fire);
      g.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); fire(); }
      });

      // Tooltip hover (sem akim — gato é silencioso, só miau no clique)
      const label = g.dataset.label;
      if (label) {
        const show = () => { if (!tooltip.dataset.pinned) showTooltipAt(g, label); };
        const hide = () => { if (!tooltip.dataset.pinned) tooltip.classList.remove('show'); };
        g.addEventListener('mouseenter', show);
        g.addEventListener('mouseleave', hide);
        g.addEventListener('focus', show);
        g.addEventListener('blur', hide);
      }
    });

    backdrop.addEventListener('click', closeAll);
    document.querySelectorAll('[data-close]').forEach(el => el.addEventListener('click', closeAll));
    document.addEventListener('keydown', e => { if (e.key === 'Escape') closeAll(); });

    // Recado → WhatsApp
    document.getElementById('r-send')?.addEventListener('click', () => {
      const nome = (document.getElementById('r-name') as HTMLInputElement).value.trim();
      const msg = (document.getElementById('r-msg') as HTMLTextAreaElement).value.trim();
      const tpl = RECIPES.whatsappTemplate || 'Oi Gigi, sou {nome}.\n\n{mensagem}';
      const texto = tpl
        .replace('{nome}', nome || 'um visitante')
        .replace('{mensagem}', msg || 'vim do seu Cozy Corner!');
      window.open(`https://wa.me/${RECIPES.whatsappNumber}?text=${encodeURIComponent(texto)}`, '_blank');
    });
  </script>
</BaseLayout>
