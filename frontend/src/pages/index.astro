---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';
import { getCollection } from 'astro:content';
import { CATEGORY_META } from '../lib/categories';
import { recipeSlug } from '../lib/slug';
import introData from '../content/pages/intro.json';
import cozinhaData from '../content/pages/cozinha.json';
import recadoData from '../content/pages/recado.json';
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';

// SVG da cozinha inlined em build time (pra hotspots com hit-area exata).
// Três versões responsivas — só uma fica visível por vez, controlada por CSS.
const kitchenSvg = readFileSync(resolve(process.cwd(), 'public/kitchen/cozinha.svg'), 'utf-8');
const kitchenTabletSvg = readFileSync(resolve(process.cwd(), 'public/kitchen/cozinha-tablet.svg'), 'utf-8');
const kitchenMobile1Svg = readFileSync(resolve(process.cwd(), 'public/kitchen/cozinha-mobile-1.svg'), 'utf-8');
const kitchenMobile2Svg = readFileSync(resolve(process.cwd(), 'public/kitchen/cozinha-mobile-2.svg'), 'utf-8');

const recipes = await getCollection('recipes', ({ data }) => data.published);

// Agrupa receitas por categoria pra alimentar o drawer dinamicamente.
// Uma receita pode estar em várias categorias → aparece em cada uma.
const recipesByCategory: Record<string, typeof recipes> = {};
for (const r of recipes) {
  for (const cat of r.data.category) {
    (recipesByCategory[cat] ??= []).push(r);
  }
}
// "todas" engloba todas
recipesByCategory.todas = recipes;

const countByCategory = Object.fromEntries(
  Object.entries(recipesByCategory).map(([k, v]) => [k, v.length])
);
---

<BaseLayout description="Receitas autorais da Gigi — narrativa, lenta, com carinho.">

  <!-- ===================== INTRO COVER (azul escuro, typewriter) ===================== -->
  <div class="intro-cover" id="intro-cover">
    <button class="cover-skip" id="cover-skip" type="button">
      <span data-t="intro.skip">{introData.skipLabel.replace(' ✕', '')}</span>
      <Icon name="ph:x-thin" width={14} height={14} />
    </button>
    <p class="phrase typewriter" id="ph1"></p>
    <p class="phrase typewriter" id="ph2"></p>
  </div>

  <!-- ===================== HEADER (logo morfa pra cá) ===================== -->
  <header class="site-header">
    <div class="logo" id="header-logo">
      <span class="logo-name">Cozy Corner</span>
      <span class="logo-by">— by Gigi</span>
    </div>
  </header>

  <div class="scroll-hint" id="scroll-hint">
    <Icon name="ph:arrow-down-thin" /> <span data-t="intro.scroll_hint">role pra continuar</span>
  </div>

  <!-- ===================== HERO (fixed, morfa pro header) ===================== -->
  <div class="hero-logo" id="hero-logo">
    <span class="hero-name">Cozy Corner</span>
    <span class="hero-by">— by Gigi</span>
  </div>

  <!-- ===================== CENA 1 — espaço pro morph acontecer ===================== -->
  <section id="scene-intro" aria-hidden="true"></section>

  <!-- ===================== TRANSIÇÃO BG ===================== -->
  <section id="flow-transition" aria-hidden="true"></section>

  <!-- ===================== COZINHA ===================== -->
  <section id="flow-kitchen">
    <!-- Desktop (>= 1024px) -->
    <div class="kitchen-canvas kitchen-desktop">
      <Fragment set:html={kitchenSvg} />
    </div>
    <!-- Tablet (601-1023px) -->
    <div class="kitchen-canvas kitchen-tablet">
      <Fragment set:html={kitchenTabletSvg} />
    </div>
    <!-- Mobile (<=600px) — duas partes lado a lado, com scroll horizontal -->
    <div class="kitchen-mobile-wrap">
      <div class="kitchen-mobile-scroll" id="kitchen-mobile-scroll">
        <div class="kitchen-canvas kitchen-mobile-part">
          <Fragment set:html={kitchenMobile1Svg} />
        </div>
        <div class="kitchen-canvas kitchen-mobile-part">
          <Fragment set:html={kitchenMobile2Svg} />
        </div>
      </div>
      <button class="mobile-swipe-hint" id="mobile-swipe-hint" type="button" aria-label="ver mais da cozinha">
        <Icon name="ph:arrow-right-thin" width={22} height={22} />
      </button>
    </div>
  </section>

  <!-- ===================== DRAWERS / MODAIS ===================== -->
  <div class="drawer-backdrop" id="drawer-backdrop"></div>

  <!-- Category drawer (renderiza receitas dinamicamente via JS) -->
  <aside class="cat-drawer" id="cat-drawer" aria-hidden="true" aria-labelledby="cat-title">
    <button class="drawer-close" data-close type="button" aria-label="fechar">
      <Icon name="ph:x-thin" width={20} height={20} />
    </button>
    <button class="drawer-crumb" data-close type="button">
      <Icon name="ph:arrow-left-thin" /> <span data-t="nav.back_to_kitchen">voltar pra cozinha</span>
    </button>
    <h2 id="cat-title" class="drawer-title">Pratos principais</h2>
    <p class="drawer-count" id="cat-count">0 receitas</p>

    <div class="drawer-search">
      <Icon name="ph:magnifying-glass-thin" width={16} height={16} />
      <input class="search-input" type="search" placeholder="título, ingrediente ou tag..." data-t-attr="placeholder:search.placeholder_full" />
    </div>

    <ul class="recipe-list" id="cat-results"></ul>
  </aside>

  <!-- Sobre mim drawer -->
  <aside class="cat-drawer" id="sobre-drawer" aria-hidden="true" aria-labelledby="sobre-title">
    <button class="drawer-close" data-close type="button" aria-label="fechar">
      <Icon name="ph:x-thin" width={20} height={20} />
    </button>
    <button class="drawer-crumb" data-close type="button">
      <Icon name="ph:arrow-left-thin" /> <span data-t="nav.back_to_kitchen">voltar pra cozinha</span>
    </button>
    <figure class="sobre-photo">
      <img
        src="/sobre/foto.jpg"
        alt="Foto da Gigi com o marido"
        data-t-attr="alt:sobre.photo_alt"
        loading="lazy"
      />
    </figure>
    <h2 id="sobre-title" class="drawer-title" data-t="sobre.title">Oi, tudo bem?</h2>
    <p class="drawer-prose" data-t="sobre.p1">
      Essa sou eu e meu marido e essa é a nossa cozinha. Sinta-se livre pra
      explorar e conhecer as receitas que fazem parte da nossa vida.
    </p>
    <p class="drawer-prose" data-t="sobre.p2">
      Criamos esse cantinho pra compartilhar um pouco daquilo que fazemos com
      tanto amor e carinho pra nossa família e amigos.
    </p>
    <p class="drawer-prose" data-t="sobre.p3">
      Ah! E esse na bancada pra quem não conhece é o Akim. Ele geralmente dorme
      o dia inteiro e só para pra ficar miando pela casa. Duvida? Vê o que
      acontece quando mexe com ele!
    </p>
    <p class="drawer-prose" data-t="sobre.p4">
      Fiquem à vontade, divirtam-se cozinhando e bom apetite =)
    </p>
  </aside>

  <!-- Tooltip flutuante dos hotspots -->
  <div class="kitchen-tooltip" id="kitchen-tooltip" role="tooltip"></div>

  <!-- Recado modal (post-it) -->
  <div class="recado-modal" id="recado-modal" aria-hidden="true" role="dialog" aria-labelledby="recado-title">
    <button class="drawer-close" data-close type="button" aria-label="fechar">
      <Icon name="ph:x-thin" width={20} height={20} />
    </button>
    <h2 id="recado-title" class="recado-title" data-t="recado.title">{recadoData.title}</h2>
    <p class="recado-sub" data-t="recado.subtitle">{recadoData.subtitle}</p>
    <label class="field-label" data-t="recado.name_label">seu nome</label>
    <input class="field-input" id="r-name" type="text" />
    <label class="field-label" data-t="recado.email_label">seu email</label>
    <input class="field-input" id="r-email" type="email" required />
    <label class="field-label" data-t="recado.message_label">mensagem</label>
    <textarea class="field-input" id="r-msg" placeholder="oi Gigi!" data-t-attr="placeholder:recado.placeholder"></textarea>
    {/* Honeypot — campo invisível pra confundir bots. Humanos não preenchem. */}
    <input type="text" id="r-website" name="website" tabindex="-1" autocomplete="off"
           style="position:absolute;left:-9999px;opacity:0;height:0;width:0;" aria-hidden="true" />
    <button class="btn btn-primary recado-send" id="r-send" type="button">
      <Icon name="ph:paper-plane-tilt-thin" /> <span data-t="recado.send" id="r-send-label">enviar</span>
    </button>
    <p class="recado-status" id="r-status" hidden></p>
  </div>

  <!-- Recipes data pra o drawer (renderizado via JS) -->
  <script type="application/json" id="recipes-data" set:html={JSON.stringify({
    byCategory: Object.fromEntries(
      Object.entries(recipesByCategory).map(([k, v]) => [
        k,
        v.map(r => {
          const coverMedia = r.data.media.find(m => m.cover) || r.data.media[0];
          const d: any = r.data;
          // Quando o schema ganhar campos de tradução (titleEn, descriptionEn,
          // ingredientsEn, tagsEn — ou title_en/etc), eles entram no haystack
          // da busca automaticamente. Por enquanto retornam undefined e são
          // ignorados pelo join/filter.
          const allTitles = [d.title, d.titleEn, d.title_en].filter(Boolean);
          const allDescriptions = [d.description, d.descriptionEn, d.description_en].filter(Boolean);
          const allIngredients = [...(d.ingredients || []), ...(d.ingredientsEn || []), ...(d.ingredients_en || [])];
          const allTags = [...(d.tags || []), ...(d.tagsEn || []), ...(d.tags_en || [])];
          return {
            id: r.id,                  // mantido por compat — não usado em URLs
            slug: recipeSlug(r),       // URL slug derivado do título (ver lib/slug.ts)
            title: r.data.title,
            // Campos pré-normalizados (lowercase) usados pela busca dentro
            // do drawer da cozinha. Manter aqui evita ter que normalizar
            // toda string no client a cada keystroke.
            // Concatena PT + EN (se existirem) pra busca casar em qualquer idioma.
            searchTitle: allTitles.join(' ').toLowerCase(),
            searchDescription: allDescriptions.join(' ').toLowerCase(),
            searchIngredients: allIngredients.join(' ').toLowerCase(),
            searchTags: allTags.join(' ').toLowerCase(),
            // Listas originais — usadas pra mostrar qual item matchou
            // ("em chocolate meio amargo"). Inclui idiomas extras quando
            // existirem.
            ingredients: allIngredients,
            tags: allTags,
            time: r.data.time,
            servings: r.data.servings,
            difficulty: r.data.difficulty,
            cover: coverMedia?.src || '',
            coverAlt: coverMedia?.alt || r.data.title,
          };
        })
      ])
    ),
    counts: countByCategory,
    catMeta: Object.fromEntries(Object.entries(CATEGORY_META).map(([k, v]) => [k, v.label])),
    catMetaTodas: 'Todas as receitas',
    email: recadoData.email,
    emailSubject: recadoData.emailSubject,
    emailTemplate: recadoData.emailTemplate,
  })}></script>

  <style>
    /* ============ ÍCONES (line art, herdam cor) ============ */
    [data-icon] svg, svg { fill: none; stroke: currentColor; }
    .icon-dark { display: none; }
    body.dark-mode .icon-light { display: none; }
    body.dark-mode .icon-dark { display: inline-block; }

    /* ============ INTRO COVER ============ */
    body.intro-active { overflow: hidden; }

    .intro-cover {
      position: fixed;
      inset: 0;
      background: var(--cover-dark);
      color: white;
      z-index: 200;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0 var(--s-5);
      text-align: center;
      clip-path: inset(0 0 0 0);
      transition: clip-path 1.4s var(--ease-in-out);
    }
    .intro-cover.wiped {
      clip-path: inset(100% 0 0 0);
      pointer-events: none;
    }
    .cover-skip {
      position: absolute;
      top: 20px; right: var(--s-6);
      background: transparent;
      border: none;
      color: white;
      opacity: 0.55;
      font-family: var(--font-mono);
      font-size: var(--fs-caption);
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 4px;
      transition: opacity var(--dur-fast);
      z-index: 5;
    }
    .cover-skip:hover { opacity: 1; }
    .intro-cover .phrase {
      position: absolute;
      font-family: var(--font-mono);
      font-size: var(--fs-intro);
      color: white;
      opacity: 0;
      max-width: 820px;
      padding: 0 var(--s-5);
      line-height: var(--lh-snug);
    }
    .phrase.typewriter::after {
      content: '|';
      display: inline-block;
      margin-left: 4px;
      opacity: 0.6;
      animation: caret 0.9s steps(2) infinite;
    }
    .phrase.typewriter.done::after { content: ''; }
    @keyframes caret {
      0%, 50% { opacity: 0.6; }
      51%, 100% { opacity: 0; }
    }

    /* ============ HEADER ============ */
    .site-header {
      position: fixed;
      top: 0; left: 0; right: 0;
      height: var(--header-h);
      padding: 0 var(--s-6);
      z-index: 100;
    }
    .site-header .logo {
      position: absolute;
      top: 50%; left: 50%;
      transform: translate(-50%, -50%);
      display: flex;
      flex-direction: column;
      align-items: flex-end; /* "— by Gigi" alinhado à direita */
      line-height: 1.1;
      opacity: 0;
    }
    .logo-name {
      font-family: var(--font-brand);
      font-weight: 600;
      font-size: 22px;
      line-height: 1;
      letter-spacing: 0;
    }
    .logo-by {
      font-family: var(--font-mono);
      font-size: 12px;
      opacity: 0.55;
      margin-top: 1px;
    }

    /* ============ HERO (morfa pro header) ============ */
    .hero-logo {
      position: fixed;
      top: 50%; left: 50%;
      transform: translate(-50%, -50%);
      transform-origin: center center;
      display: flex;
      flex-direction: column;
      align-items: flex-end; /* "— by Gigi" alinhado à direita do "Cozy Corner" */
      gap: var(--s-2);
      opacity: 0;
      z-index: 80;
      pointer-events: none;
      will-change: transform, opacity;
      transition: opacity 1s var(--ease-out) 0.3s;
    }
    .hero-logo.visible { opacity: 1; }
    .hero-name {
      font-family: var(--font-brand);
      font-weight: 600;
      font-size: clamp(64px, 12vw, 128px);
      letter-spacing: 0;
      line-height: 1;
      color: var(--ink);
      white-space: nowrap;
    }
    .hero-by {
      font-family: var(--font-mono);
      font-size: clamp(13px, 1.8vw, 18px);
      opacity: 0.55;
      color: var(--ink);
    }

    /* Hero pousa sobre var(--bg) que adapta light/dark naturalmente */

    /* ============ SCROLL HINT ============ */
    .scroll-hint {
      position: fixed;
      bottom: var(--s-6);
      left: 50%;
      transform: translateX(-50%);
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-family: var(--font-mono);
      font-size: var(--fs-caption);
      color: var(--ink-soft);
      opacity: 0;
      z-index: 90;
      transition: opacity var(--dur-base);
      pointer-events: none;
      animation: bob 1.8s ease-in-out infinite;
    }
    .scroll-hint.show { opacity: 0.65; }
    .scroll-hint.hidden { opacity: 0; }
    @keyframes bob {
      0%, 100% { transform: translateX(-50%) translateY(0); }
      50% { transform: translateX(-50%) translateY(6px); }
    }

    /* ============ SEÇÕES DA HOMEPAGE ============ */
    /* Tudo no cream warm de --bg. Azul e terracota são acentos/detalhes. */
    #scene-intro {
      min-height: 100vh;
      background: var(--bg);
    }
    #flow-transition {
      height: 50vh;
      background: var(--bg);
    }

    /* ============ COZINHA ============ */
    #flow-kitchen {
      background: var(--bg);
      padding: 0;
      /* --vh-real é window.innerHeight medido por JS no BaseLayout.
         Confiável em iOS Safari, onde 100vh/svh nem sempre excluem
         a barra de URL. Fallbacks pra browsers velhos. */
      height: 100vh;
      height: 100svh;
      height: var(--vh-real, 100svh);
      min-height: 100vh;
      min-height: 100svh;
      min-height: var(--vh-real, 100svh);
      overflow: hidden;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      align-items: center;
    }
    .kitchen-title {
      max-width: var(--max-content);
      margin: 0 auto var(--s-3);
      font-family: var(--font-mono);
      font-size: var(--fs-caption);
      color: var(--ink-soft);
      text-transform: lowercase;
      letter-spacing: 0.05em;
    }
    .kitchen-canvas {
      position: relative;
      /* Linhas mais cozy: usa --ink-soft (warm gray-brown) em vez do
         --ink quase preto. Hotspots viram --terracota no hover/pressed,
         então mantêm o destaque visual sem precisar do contraste alto. */
      color: var(--ink-soft);
    }
    /* Desktop: preenche 100vh de altura, aspect 1500:1000.
       Excesso lateral cortado pelo overflow:hidden do #flow-kitchen. */
    .kitchen-desktop {
      height: min(100svh, 1000px);
      aspect-ratio: 1500 / 1000;
    }
    .kitchen-canvas :global(svg) {
      width: 100%;
      height: 100%;
      display: block;
    }
    /* ============ RESPONSIVO ============
       Por padrão (desktop) mostra só .kitchen-desktop.
       Tablet e mobile ficam escondidos. */
    .kitchen-tablet,
    .kitchen-mobile-wrap { display: none; }

    /* Tablet: 601-1023px — usa o SVG 991x1000 com aspect compatível */
    @media (max-width: 1023px) and (min-width: 601px) {
      .kitchen-desktop { display: none; }
      .kitchen-tablet {
        display: block;
        /* Largura limitada por viewport-width OU height-derivada (não passa
           do viewport vertical). Garante que a altura nunca excede 100vh. */
        width: min(90vw, calc(100svh * 991 / 1000));
        aspect-ratio: 991 / 1000;
      }
    }

    /* Mobile: <=600px — duas partes lado a lado, scroll horizontal */
    @media (max-width: 600px) {
      .kitchen-desktop,
      .kitchen-tablet { display: none; }
      /* Herda o flex flex-end do #flow-kitchen base, mas remove o
         padding lateral (cozinha encosta nas bordas no mobile). */
      #flow-kitchen {
        padding-left: 0;
        padding-right: 0;
      }
      /* Wrap ocupa 100vw e 100vh, ancorada ao bottom do viewport pelo
         flex-end do pai. SVG dentro usa preserveAspectRatio=xMidYMax meet
         pra que a bancada cole no fundo da tela em qualquer aspect ratio. */
      .kitchen-mobile-wrap {
        display: block;
        position: relative;
        width: 100vw;
        height: 100vh;
        height: 100svh;
        height: var(--vh-real, 100svh);
      }
      .kitchen-mobile-scroll {
        display: flex;
        width: 100%;
        height: 100%;
        overflow-x: auto;
        overflow-y: hidden;
        scroll-snap-type: x mandatory;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
      }
      .kitchen-mobile-scroll::-webkit-scrollbar { display: none; }
      .kitchen-mobile-part {
        flex: 0 0 100vw;
        width: 100vw;
        height: 100%;
        margin: 0;
        scroll-snap-align: start;
      }
      .kitchen-mobile-part :global(svg) {
        width: 100%;
        height: 100%;
        display: block;
      }
      /* Esconde os detalhes do counter-paneling (lonas verticais de madeira
         abaixo da bancada) no mobile. A bancada vira o "rodapé" da cozinha
         e cola na base do viewport, sem detalhes cortados pela barra do iOS. */
      .kitchen-mobile-part :global(#counter-paneling) {
        display: none;
      }
      /* Empurra o conteúdo da PRIMEIRA tela mobile 2px pra esquerda,
         menos a bancada e o paneling (que ficam fixos no lugar). */
      .kitchen-mobile-part:first-child :global(svg > g) {
        transform: translateX(-2px);
      }
      .kitchen-mobile-part:first-child :global(#bancada),
      .kitchen-mobile-part:first-child :global(#counter-paneling) {
        transform: translateX(2px);
      }
      /* Frame de foto e livros: shift de 28px à direita
         (só na primeira tela mobile). */
      .kitchen-mobile-part:first-child :global(#sobre),
      .kitchen-mobile-part:first-child :global(#todas) {
        transform: translateX(28px);
      }
      /* Estante: shift de 14px à direita. */
      .kitchen-mobile-part:first-child :global(#estante) {
        transform: translateX(14px);
      }
      /* Prato principal: shift de 20px à direita. */
      .kitchen-mobile-part:first-child :global(#principais) {
        transform: translateX(20px);
      }
      /* SEGUNDA tela mobile: empurra todo o conteúdo 16px pra direita
         (planta, relógio, geladeira, calendário, recado), mantendo
         bancada e paneling no lugar. */
      .kitchen-mobile-part:last-child :global(svg > g) {
        transform: translateX(16px);
      }
      .kitchen-mobile-part:last-child :global(#bancada),
      .kitchen-mobile-part:last-child :global(#counter-paneling) {
        transform: translateX(-16px);
      }
      /* Botão de navegação: setinha clicável que alterna entre as duas partes.
         Position absolute (não fixed) pra ficar dentro do wrap, que já usa
         --vh-real e portanto fica acima da barra de URL do iOS Safari. */
      .mobile-swipe-hint {
        position: absolute;
        right: var(--s-3);
        left: auto;
        bottom: var(--s-5);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        background: var(--ink);
        color: var(--bg);
        border: none;
        border-radius: 999px;
        box-shadow: var(--shadow-2);
        opacity: 0.9;
        cursor: pointer;
        animation: swipe-nudge 1.6s ease-in-out infinite;
        z-index: 50;
        transition: opacity 200ms ease-out;
      }
      .mobile-swipe-hint:hover { opacity: 1; }
      .mobile-swipe-hint :global(svg) { display: block; }
      /* Quando estiver na segunda parte: seta vira, botão muda pra esquerda, nudge inverte */
      .mobile-swipe-hint.flipped {
        left: var(--s-3);
        right: auto;
        animation: swipe-nudge-rev 1.6s ease-in-out infinite;
      }
      .mobile-swipe-hint.flipped :global(svg) { transform: scaleX(-1); }
      @keyframes swipe-nudge {
        0%, 100% { transform: translateX(0); }
        50% { transform: translateX(-6px); }
      }
      @keyframes swipe-nudge-rev {
        0%, 100% { transform: translateX(0); }
        50% { transform: translateX(6px); }
      }
      @media (prefers-reduced-motion: reduce) {
        .mobile-swipe-hint,
        .mobile-swipe-hint.flipped { animation: none; }
      }
    }
    /* Em dark mode, o currentColor já vira cream (--ink) automaticamente,
       então não precisa de filter: invert (que inverteria o cream pra navy
       e deixaria a cena imperceptível sobre o fundo navy). */

    /* Hotspots no SVG — bounding-box do grupo é a área clicável.
       Cobre tanto <g class='hs'> quanto <path class='hs'>. */
    .kitchen-canvas :global(.hs) {
      cursor: pointer;
      pointer-events: bounding-box;
      transform-box: fill-box;
      transform-origin: center;
      /* Anima só `scale` no hover (propriedade separada), pra não animar
         o `transform: translateX(...)` que usamos pra reposicionar
         elementos no mobile. */
      transition: scale 200ms ease;
    }
    /* Hover só em dispositivos que realmente suportam (mouse/trackpad).
       Em touch, o estado de hover fica grudado depois do tap, deixando
       o elemento em terracota até o próximo toque em outro lugar. */
    @media (hover: hover) {
      .kitchen-canvas :global(.hs:hover) { scale: 1.03; }
      /* Hover: pinta o stroke em terracota pra destacar */
      .kitchen-canvas :global(.hs:hover) :global(*[stroke="currentColor"]),
      .kitchen-canvas :global(.hs:hover[stroke="currentColor"]) {
        stroke: var(--terracota);
      }
      .kitchen-canvas :global(.hs:hover) :global(*[fill="currentColor"]),
      .kitchen-canvas :global(.hs:hover[fill="currentColor"]) {
        fill: var(--terracota);
      }
    }
    /* Mobile: desabilita o highlight padrão do browser (azul/cinza
       translúcido em iOS/Android) pra que só o terracota da classe
       .hs-pressed apareça no tap. */
    .kitchen-canvas :global(.hs) {
      -webkit-tap-highlight-color: transparent;
    }
    /* Feedback visual de tap: JS adiciona .hs-pressed por ~280ms quando
       o user clica. Funciona melhor que :active em touch (que pode ser
       brevíssimo demais). */
    .kitchen-canvas :global(.hs.hs-pressed) { scale: 1.03; }
    .kitchen-canvas :global(.hs.hs-pressed) :global(*[stroke="currentColor"]),
    .kitchen-canvas :global(.hs.hs-pressed[stroke="currentColor"]) {
      stroke: var(--terracota);
    }
    .kitchen-canvas :global(.hs.hs-pressed) :global(*[fill="currentColor"]),
    .kitchen-canvas :global(.hs.hs-pressed[fill="currentColor"]) {
      fill: var(--terracota);
    }
    .kitchen-canvas :global(.hs:focus) { outline: none; }
    .kitchen-canvas :global(.hs:focus-visible) {
      outline: 2px solid var(--terracota);
      outline-offset: 4px;
    }
    /* Debug opcional (D): pinta fundo dos bbox dos hotspots */
    body.hs-debug .kitchen-canvas :global(.hs) :global(*[stroke="currentColor"]),
    body.hs-debug .kitchen-canvas :global(.hs[stroke="currentColor"]) {
      stroke: var(--terracota);
    }

    /* Zzz do gatinho dormindo — flutuam pra cima-direita e somem */
    .kitchen-canvas :global(.zzz-puff) {
      opacity: 0;
      transform-box: fill-box;
      transform-origin: center;
      animation: zzz-drift 4.5s ease-out infinite;
    }
    .kitchen-canvas :global(.zzz-2) { animation-delay: 1.5s; }
    .kitchen-canvas :global(.zzz-3) { animation-delay: 3s; }
    /* Gato acordado: pausa os zzz no clique (durante o tooltip "miau") */
    body.cat-awake .kitchen-canvas :global(.zzz-puff) {
      animation-play-state: paused;
    }
    @keyframes zzz-drift {
      0%   { opacity: 0; transform: translate(0, 0) scale(0.6); }
      15%  { opacity: 0.8; }
      70%  { opacity: 0.4; }
      100% { opacity: 0; transform: translate(40px, -55px) scale(1.4); }
