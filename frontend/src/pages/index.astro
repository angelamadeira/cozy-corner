  </style>

  <script>
    // =============================================
    // ELEMENTS
    // =============================================
    const introCover = document.getElementById('intro-cover')!;
    const ph1 = document.getElementById('ph1')!;
    const ph2 = document.getElementById('ph2')!;
    const scrollHint = document.getElementById('scroll-hint')!;
    const heroLogo = document.getElementById('hero-logo')!;
    const headerLogo = document.getElementById('header-logo')!;
    const sceneIntro = document.getElementById('scene-intro')!;
    const catDrawer = document.getElementById('cat-drawer')!;
    const recadoModal = document.getElementById('recado-modal')!;
    const backdrop = document.getElementById('drawer-backdrop')!;
    const catTitle = document.getElementById('cat-title')!;
    const catCount = document.getElementById('cat-count')!;
    const catResults = document.getElementById('cat-results')!;

    const dataNode = document.getElementById('recipes-data');
    const RECIPES = dataNode ? JSON.parse(dataNode.textContent!) : { byCategory: {}, counts: {}, catMeta: {} };

    let userScrolled = false;
    let typewriterDone = false;

    // "Já chegou na cozinha" — flag que persiste entre visitas.
    // Na primeira visita roda intro + hero + morph até chegar na cozinha.
    // A partir do momento que chega na cozinha (em qualquer visita), trava ali.
    const KITCHEN_REACHED_KEY = 'cozy-kitchen-reached';
    const kitchenReachedBefore = (() => {
      try { return localStorage.getItem(KITCHEN_REACHED_KEY) === 'true'; } catch (e) { return false; }
    })();
    let kitchenLocked = false;
    function lockKitchen() {
      if (kitchenLocked) return;
      kitchenLocked = true;
      const wasFirstTime = !kitchenReachedBefore;
      try { localStorage.setItem(KITCHEN_REACHED_KEY, 'true'); } catch (e) {}
      // Cozinha vira o topo da página — esconde intro e transição.
      sceneIntro.style.display = 'none';
      const flowTransition = document.getElementById('flow-transition');
      if (flowTransition) flowTransition.style.display = 'none';
      // Hero some, header já visível e sem morph.
      heroLogo.style.display = 'none';
      headerLogo.style.opacity = '1';
      // Snap pro topo (que agora é a cozinha) sem scroll animado.
      window.scrollTo(0, 0);
      // Primeira vez chegando na cozinha → mostra balão "Oi, tudo bem?"
      // em cima do hotspot Nossa cozinha (sobre) após 1.2s. A trava de
      // cliques (body.welcome-pending) já foi adicionada lá em cima ao
      // detectar !kitchenReachedBefore — fica desde o load até o balão
      // welcome desaparecer (~6.6s depois do balão aparecer).
      if (wasFirstTime) {
        window.setTimeout(showWelcomeBalloon, 1200);
      }
    }

    function showWelcomeBalloon() {
      // Encontra o hotspot 'sobre' atualmente visível (desktop/tablet/mobile-1).
      const candidates = document.querySelectorAll<Element>('.kitchen-canvas .hs[data-action="sobre"]');
      let target: Element | null = null;
      candidates.forEach((el) => {
        if (target) return;
        const rect = (el as SVGGraphicsElement).getBoundingClientRect();
        if (rect.width > 0 && rect.height > 0) target = el;
      });
      if (!target) return;
      const text = ((window as any).__cozyT?.('sobre.title')) || 'Oi, tudo bem?';
      // Marca como welcome pra escapar da regra que esconde tooltips em touch
      tooltip.classList.add('is-welcome');
      // ttl 5s — balão aparece, fica pinned, depois some
      showTooltipAt(target, text, 5000);
      window.setTimeout(() => {
        tooltip.classList.remove('is-welcome');
        // Só libera cliques DEPOIS que o balão sumiu — user vê o welcome
        // inteiro sem disparar nada por acidente.
        document.body.classList.remove('welcome-pending');
      }, 5400);
    }

    if (kitchenReachedBefore) {
      // Visita recorrente / volta de outra tela: já trava direto na cozinha,
      // sem intro, sem hero, sem morph.
      introCover.style.transition = 'none';
      introCover.classList.add('wiped');
      document.body.classList.remove('intro-active');
      userScrolled = true;
      lockKitchen();
    } else {
      document.body.classList.add('intro-active');
      // Trava cliques + tooltips em hotspots e toggles desde o carregamento
      // (não só depois que a cozinha trava). Sem isso, durante o scroll da
      // intro pra cozinha o user já enxergava tooltips e podia clicar em
      // hotspots peeking pela tela. A classe só sai quando o balão welcome
      // termina (em showWelcomeBalloon setTimeout).
      document.body.classList.add('welcome-pending');
    }

    // DEBUG: aperta 'D' pra ver os retângulos clicáveis dos hotspots.
    document.addEventListener('keydown', (e) => {
      if ((e.key === 'd' || e.key === 'D') && !['INPUT','TEXTAREA'].includes((document.activeElement?.tagName)||'')) {
        document.body.classList.toggle('hs-debug');
      }
    });

    // =============================================
    // TYPEWRITER + WIPE
    // =============================================
    // Strings i18n — usam __cozyT injetado no BaseLayout (fallback PT em runtime)
    const T = (window as any).__cozyT || ((k: string) => k);
    const TEXT_1 = T('intro.hello');
    const TEXT_2 = T('intro.welcome');
    const TYPE_SPEED = 70;
    const DELAY_BEFORE_1 = 500;
    const PAUSE_AFTER_1 = 700;
    const FADE_DUR = 350;

    const sleep = (ms: number) => new Promise(r => setTimeout(r, ms));

    async function typeInto(el: HTMLElement, text: string) {
      el.textContent = '';
      el.style.opacity = '1';
      for (let i = 0; i <= text.length; i++) {
        el.textContent = text.slice(0, i);
        await sleep(TYPE_SPEED);
      }
      el.classList.add('done');
    }

    async function revealAfterTypewriter() {
      await sleep(800);
      introCover.classList.add('wiped');
      heroLogo.classList.add('visible');
      await sleep(1400);
      document.body.classList.remove('intro-active');
      if (!userScrolled) scrollHint.classList.add('show');
    }

    async function runIntroSequence() {
      await sleep(DELAY_BEFORE_1);
      if (userScrolled) return;
      await typeInto(ph1, TEXT_1);
      if (userScrolled) return;
      await sleep(PAUSE_AFTER_1);
      if (userScrolled) return;

      ph1.style.transition = `opacity ${FADE_DUR}ms ease`;
      ph1.style.opacity = '0';
      await sleep(FADE_DUR);
      if (userScrolled) return;

      await typeInto(ph2, TEXT_2);
      typewriterDone = true;

      await sleep(600);
      if (!userScrolled) scrollHint.classList.add('show');
    }

    // Detecta scroll real
    window.addEventListener('scroll', () => {
      if (window.scrollY > 30 && !userScrolled) {
        userScrolled = true;
        scrollHint.classList.add('hidden');
      }
    }, { passive: true });

    // Esconde a cover e leva direto pra cozinha (com morph completo)
    document.getElementById('cover-skip')?.addEventListener('click', () => {
      introCover.style.transition = 'none';
      introCover.classList.add('wiped');
      // força reflow
      introCover.offsetHeight;
      document.body.classList.remove('intro-active');
      userScrolled = true;
      heroLogo.classList.add('visible');
      // Scroll suave pra cozinha — durante o scroll o morph acontece naturalmente.
      // Quando chegar na cozinha o listener de scroll abaixo chama lockKitchen().
      document.getElementById('flow-kitchen')?.scrollIntoView({ behavior: 'smooth' });
    });

    // Roda a sequência do typewriter SÓ na primeira visita
    if (!kitchenReachedBefore) {
      runIntroSequence()
        .then(() => revealAfterTypewriter());
    }

    // Detecta quando o user chega na cozinha pela primeira vez — trava ali.
    function checkKitchenReached() {
      if (kitchenLocked) return;
      const rect = sceneIntro.getBoundingClientRect();
      // Quando o fim da intro passa pelo topo da viewport, já chegou na cozinha.
      // (sceneIntro tem 100vh + flow-transition 50vh acima da cozinha)
      const flowTransition = document.getElementById('flow-transition');
      const transitionRect = flowTransition?.getBoundingClientRect();
      const reachedKitchen = transitionRect
        ? transitionRect.bottom <= 0
        : rect.bottom <= 0;
      if (reachedKitchen) lockKitchen();
    }
    window.addEventListener('scroll', checkKitchenReached, { passive: true });

    // =============================================
    // MORPH — hero diminui e morfa pro header conforme rola
    // =============================================
    let firstMorphCall = true;
    function updateMorph() {
      // Depois que a cozinha foi travada, o hero está oculto — nada a morfar.
      if (kitchenLocked) return;
      if (firstMorphCall) {
        heroLogo.style.transition = 'none';
        firstMorphCall = false;
      }
      const scrollY = window.scrollY;
      const morphRange = window.innerHeight * 0.55;
      const progress = Math.min(1, Math.max(0, scrollY / morphRange));

      const scale = 1 - progress * 0.78;
      const endX = window.innerWidth / 2;
      const endY = 28;
      const startX = window.innerWidth / 2;
      const startY = window.innerHeight / 2;
      const tx = (endX - startX) * progress;
      const ty = (endY - startY) * progress;

      let heroOp = 1;
      if (progress > 0.78) heroOp = Math.max(0, 1 - (progress - 0.78) / 0.08);

      heroLogo.style.transform =
        `translate(calc(-50% + ${tx}px), calc(-50% + ${ty}px)) scale(${scale})`;
      heroLogo.style.opacity = String(heroOp);

      let headerOp = 0;
      if (progress > 0.88) headerOp = Math.min(1, (progress - 0.88) / 0.08);
      headerLogo.style.opacity = String(headerOp);
    }
    window.addEventListener('scroll', updateMorph, { passive: true });
    window.addEventListener('resize', updateMorph);
    // Estado inicial — caso o user já esteja com scroll setado (refresh, anchor)
    updateMorph();

    // =============================================
    // DRAWERS / MODAIS
    // =============================================
    // Normaliza string pra match acento-insensible
    function normalizeSearch(s: string): string {
      return s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
    }

    // Escape HTML pra valores que vão dentro de innerHTML
    const escAttr = (s: string) => String(s).replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    const escHtml = (s: string) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

    // Acha o primeiro ingrediente (ou tag) que casa com a query.
    // Retorna { kind: 'ingredient'|'tag', text: '...' } ou null se nada bater.
    function findMatchContext(r: any, q: string): { kind: string, text: string } | null {
      if (!q) return null;
      for (const ing of (r.ingredients || [])) {
        if (normalizeSearch(ing).includes(q)) return { kind: 'ingredient', text: ing };
      }
      for (const tag of (r.tags || [])) {
        if (normalizeSearch(tag).includes(q)) return { kind: 'tag', text: tag };
      }
      return null;
    }

    // Destaca o trecho da string que bate com a query (case/acento-insensible).
    function highlightMatch(text: string, q: string): string {
      if (!q) return escHtml(text);
      const normText = normalizeSearch(text);
      const idx = normText.indexOf(q);
      if (idx < 0) return escHtml(text);
      // Como normalize NFD preserva o length de chars latinos comuns, dá pra
      // mapear o índice de volta pro texto original.
      const before = text.slice(0, idx);
      const match  = text.slice(idx, idx + q.length);
      const after  = text.slice(idx + q.length);
      return `${escHtml(before)}<mark class="recipe-match-hl">${escHtml(match)}</mark>${escHtml(after)}`;
    }

    function renderRecipeList(category: string, query = '') {
      const all = RECIPES.byCategory[category] || [];
      // Filtra por título / ingredientes / tags (já lowercase no JSON)
      const q = normalizeSearch(query.trim());
      const recipes = q
        ? all.filter((r: any) => {
            // Campos searchTitle/searchDescription/searchIngredients/searchTags
            // já vêm concatenados com versões em todos os idiomas disponíveis
            // (PT + EN) e em lowercase. Aqui só normaliza acentos e procura.
            const t = normalizeSearch(r.searchTitle || '');
            const d = normalizeSearch(r.searchDescription || '');
            const i = normalizeSearch(r.searchIngredients || '');
            const g = normalizeSearch(r.searchTags || '');
            return t.includes(q) || d.includes(q) || i.includes(q) || g.includes(q);
          })
        : all;
      catResults.innerHTML = recipes.map((r: any) => {
        const thumb = r.cover
          ? `<div class="recipe-thumb has-img"><img src="${escAttr(r.cover)}" alt="${escAttr(r.coverAlt || r.title)}" loading="lazy" /></div>`
          : `<div class="recipe-thumb">foto</div>`;
        // Se a busca casou no título, só destaca o título. Senão mostra
        // ingrediente/tag que bateu numa linha extra abaixo do meta.
        const titleHit = q && normalizeSearch(r.searchTitle || '').includes(q);
        const titleHtml = titleHit ? highlightMatch(r.title, q) : escHtml(r.title);
        let matchLine = '';
        if (q && !titleHit) {
          const ctx = findMatchContext(r, q);
          if (ctx) {
            const inLabel = ctx.kind === 'tag'
              ? (T('search.match_in_tag') || 'tag')
              : (T('search.match_in') || 'em');
            matchLine = `<div class="recipe-row-match">${escHtml(inLabel)} ${highlightMatch(ctx.text, q)}</div>`;
          }
        }
        const meta = [`${r.time} min`, r.servings ? `${r.servings} porções` : null, r.difficulty].filter(Boolean).join(' · ');
        return `
        <li>
          <a href="/receitas/${r.slug}/">
            ${thumb}
            <div>
              <div class="recipe-row-title">${titleHtml}</div>
              <div class="recipe-row-meta">${meta}</div>
              ${matchLine}
            </div>
          </a>
        </li>
      `;
      }).join('');
      if (recipes.length === 0) {
        const emptyMsg = q
          ? (T('search.no_results') || 'nenhuma receita encontrada')
          : (T('meta.no_recipes_yet') || 'ainda sem receitas por aqui...');
        catResults.innerHTML = `<li style="padding: 24px 0; color: var(--ink-soft); font-family: var(--font-mono); font-size: 14px;">${emptyMsg}</li>`;
      }
    }

    const sobreDrawer = document.getElementById('sobre-drawer')!;
    const drawerSearchInput = catDrawer.querySelector<HTMLInputElement>('.search-input');
    let currentCategoryKey = '';

    function openCategory(key: string) {
      // Pega label do dicionário i18n (category.{key}) — fallback pro PT do JSON
      const label = T(`category.${key}`) || RECIPES.catMeta[key] || key;
      catTitle.textContent = label;
      const count = RECIPES.counts[key] || 0;
      const unitKey = count === 1 ? 'search.results_count_one' : 'search.results_count_other';
      catCount.textContent = T(unitKey, { n: count });
      currentCategoryKey = key;
      // Reseta input ao abrir nova categoria (pra não filtrar com query antiga)
      if (drawerSearchInput) drawerSearchInput.value = '';
      renderRecipeList(key);
      catDrawer.classList.add('open');
      backdrop.classList.add('open');
      document.body.classList.add('drawer-open');
    }

    // Filtra a lista do drawer ao vivo conforme o user digita.
    drawerSearchInput?.addEventListener('input', () => {
      if (!currentCategoryKey) return;
      renderRecipeList(currentCategoryKey, drawerSearchInput.value);
    });

    function openRecado() {
      // Recado é modal centrado (não side drawer) — não encolhe a cozinha
      recadoModal.classList.add('open');
      backdrop.classList.add('open');
    }

    function openSobre() {
      sobreDrawer.classList.add('open');
      backdrop.classList.add('open');
      document.body.classList.add('drawer-open');
    }

    function closeAll() {
      catDrawer.classList.remove('open');
      recadoModal.classList.remove('open');
      sobreDrawer.classList.remove('open');
      backdrop.classList.remove('open');
      document.body.classList.remove('drawer-open');
    }

    // Tooltip flutuante
    const tooltip = document.getElementById('kitchen-tooltip')!;
    let tooltipPinTimer: number | undefined;
    function showTooltipAt(g: Element, text: string, pinMs = 0) {
      const rect = g.getBoundingClientRect();
      tooltip.textContent = text;
      tooltip.style.left = `${rect.left + rect.width / 2}px`;
      tooltip.style.top = `${rect.top}px`;
      tooltip.classList.add('show');
      window.clearTimeout(tooltipPinTimer);
      if (pinMs > 0) {
        tooltip.dataset.pinned = '1';
        tooltipPinTimer = window.setTimeout(() => {
          delete tooltip.dataset.pinned;
          // Em touch (hover: none), `:hover` pode dar match falso depois de
          // um tap — então sempre esconde. Em desktop hover real, se o user
          // ainda está em cima do hotspot, troca o texto pro label dele.
          const canHover = window.matchMedia('(hover: hover)').matches;
          if (canHover && g.matches(':hover')) {
            tooltip.textContent = (g as HTMLElement).dataset?.label ?? '';
          } else {
            tooltip.classList.remove('show');
          }
        }, pinMs);
      }
    }

    // Pega a chave i18n correta pra cada hotspot baseado em action/key.
    // Pro dark-mode, escolhe a mensagem conforme o estado atual (light/dark).
    function hotspotLabelKey(ds: DOMStringMap): string | null {
      const action = ds.action;
      if (action === 'cat' && ds.key) return `category.${ds.key}`;
      if (action === 'recado') return 'hotspot.recado';
      if (action === 'sobre') return 'hotspot.sobre';
      if (action === 'dark-mode') {
        return document.body.classList.contains('dark-mode')
          ? 'hotspot.dark_mode_on'   // tá escuro → "acender"
          : 'hotspot.dark_mode_off'; // tá claro → "apagar"
      }
      return null; // akim não tem hover label (só miau no click)
    }

    // Hotspots (elementos SVG <g>/<path> com class="hs" no inline SVG)
    document.querySelectorAll<Element>('.kitchen-canvas .hs').forEach((g) => {
      const ds = (g as HTMLElement | SVGElement).dataset;
      const fire = () => {
        // Feedback visual de tap: classe que dura ~280ms (mais confiável
        // que :active em touch, que pode ser brevíssimo demais pra ser visto).
        g.classList.add('hs-pressed');
        window.setTimeout(() => g.classList.remove('hs-pressed'), 280);

        const action = ds.action;
        const key = ds.key;
        if (action === 'cat' && key) openCategory(key);
        else if (action === 'recado') openRecado();
        else if (action === 'sobre') openSobre();
        else if (action === 'akim') {
          showTooltipAt(g, T('hotspot.akim_meow') || 'miau 🐱', 1400);
          document.body.classList.add('cat-awake');
          window.setTimeout(() => document.body.classList.remove('cat-awake'), 1400);
        }
        else if (action === 'dark-mode') {
          document.body.classList.toggle('dark-mode');
          try {
            localStorage.setItem('cozy-dark-mode',
              document.body.classList.contains('dark-mode') ? 'true' : 'false');
          } catch (err) {}
        }
      };
      g.addEventListener('click', fire);
      g.addEventListener('keydown', (e: Event) => {
        const k = (e as KeyboardEvent).key;
        if (k === 'Enter' || k === ' ') { e.preventDefault(); fire(); }
      });

      // Tooltip hover — resolve a chave i18n NA HORA do show pra respeitar:
      // - troca de idioma (PT/EN)
      // - estado dinâmico (ex.: dark_mode_off/on muda com a luz)
      if (hotspotLabelKey(ds) !== null) {
        const show = () => {
          if (!tooltip.dataset.pinned) {
            const key = hotspotLabelKey(ds);
            const text = (key && (window as any).__cozyT?.(key)) || ds.label || '';
            showTooltipAt(g, text);
          }
        };
        const hide = () => { if (!tooltip.dataset.pinned) tooltip.classList.remove('show'); };
        g.addEventListener('mouseenter', show);
        g.addEventListener('mouseleave', hide);
        g.addEventListener('focus', show);
        g.addEventListener('blur', hide);
      }
    });

    // Relógio analógico — gira os ponteiros pra hora atual do navegador.
    // Cada ponteiro tem data-baked (ângulo em graus que o path já carrega
    // desenhado) e data-cx/data-cy (centro de rotação). A rotação aplicada
    // é (alvo - baked) em torno de (cx, cy).
    // querySelectorAll pega todas as instâncias (desktop, tablet, mobile-2).
    const hourHands = document.querySelectorAll<SVGGElement>('[id="clock-hour"]');
    const minuteHands = document.querySelectorAll<SVGGElement>('[id="clock-minute"]');
    const secondHands = document.querySelectorAll<SVGGElement>('[id="clock-second"]');
    function rotateHand(el: SVGGElement, target: number) {
      const baked = Number(el.dataset.baked ?? 0);
      const cx = Number(el.dataset.cx ?? 0);
      const cy = Number(el.dataset.cy ?? 0);
      const delta = target - baked;
      el.setAttribute('transform', `rotate(${delta} ${cx} ${cy})`);
    }
    function tickClock() {
      if (!hourHands.length && !minuteHands.length && !secondHands.length) return;
      const now = new Date();
      const h = now.getHours() % 12;
      const m = now.getMinutes();
      const s = now.getSeconds();
      const hourTarget = h * 30 + m * 0.5;
      const minuteTarget = m * 6 + s * 0.1;
      const secondTarget = s * 6;
      hourHands.forEach(el => rotateHand(el, hourTarget));
      minuteHands.forEach(el => rotateHand(el, minuteTarget));
      secondHands.forEach(el => rotateHand(el, secondTarget));
    }
    tickClock();
    setInterval(tickClock, 1000);

    // Mobile: botão clicável que alterna entre as duas partes da cozinha
    const mobileScroll = document.getElementById('kitchen-mobile-scroll');
    const swipeHint = document.getElementById('mobile-swipe-hint');
    if (mobileScroll && swipeHint) {
      const SCROLL_KEY = 'cozy-mobile-scroll';

      function updateHintDirection() {
        // Se já passou da metade, a seta aponta pra esquerda (voltar pra parte 1)
        const half = mobileScroll.scrollWidth / 2;
        const isAtSecond = mobileScroll.scrollLeft > half * 0.5;
        swipeHint.classList.toggle('flipped', isAtSecond);
      }
      swipeHint.addEventListener('click', () => {
        const isAtFirst = mobileScroll.scrollLeft < mobileScroll.scrollWidth * 0.25;
        mobileScroll.scrollTo({
          left: isAtFirst ? mobileScroll.scrollWidth : 0,
          behavior: 'smooth',
        });
      });

      // Restaura tela em que o user estava (snap pra primeira ou segunda parte)
      // depois de um refresh. Usa sessionStorage pra durar só na sessão.
      try {
        const saved = sessionStorage.getItem(SCROLL_KEY);
        if (saved === 'second') {
          // Espera o layout estabilizar antes de pular pra segunda parte
          requestAnimationFrame(() => {
            mobileScroll.scrollLeft = mobileScroll.scrollWidth;
            updateHintDirection();
          });
        }
      } catch (e) {}

      // Atualiza direção da seta E salva qual parte tá ativa pro refresh
      mobileScroll.addEventListener('scroll', () => {
        updateHintDirection();
        try {
          const half = mobileScroll.scrollWidth / 2;
          const isAtSecond = mobileScroll.scrollLeft > half * 0.5;
          sessionStorage.setItem(SCROLL_KEY, isAtSecond ? 'second' : 'first');
        } catch (e) {}
      }, { passive: true });
    }

    backdrop.addEventListener('click', closeAll);
    document.querySelectorAll('[data-close]').forEach(el => el.addEventListener('click', closeAll));
    document.addEventListener('keydown', e => { if (e.key === 'Escape') closeAll(); });

    // Swipe-to-close em drawers (mobile). Os drawers entram da direita,
    // então swipe pra direita = fecha. Threshold: 80px de deslocamento
    // horizontal OU 25% da largura do drawer (o que for menor), e gesto
    // predominantemente horizontal (deltaX > deltaY).
    function attachSwipeClose(el: HTMLElement) {
      let startX = 0, startY = 0, tracking = false;
      el.addEventListener('touchstart', (e) => {
        if (e.touches.length !== 1) return;
        startX = e.touches[0].clientX;
        startY = e.touches[0].clientY;
        tracking = true;
      }, { passive: true });
      el.addEventListener('touchend', (e) => {
        if (!tracking) return;
        tracking = false;
        const t = e.changedTouches[0];
        const dx = t.clientX - startX;
        const dy = t.clientY - startY;
        const threshold = Math.min(80, el.offsetWidth * 0.25);
        // Só fecha se swipe foi pra direita, magnitude suficiente,
        // e mais horizontal que vertical (evita confundir com scroll).
        if (dx > threshold && Math.abs(dx) > Math.abs(dy)) closeAll();
      }, { passive: true });
    }
    attachSwipeClose(catDrawer);
    attachSwipeClose(sobreDrawer);

    // Recado → POST pra /recados (Cloudflare Function salva em KV).
    // Gigi consulta os recados em /admin-recados/.
    document.getElementById('r-send')?.addEventListener('click', async () => {
      const sendBtn = document.getElementById('r-send') as HTMLButtonElement;
      const sendLabel = document.getElementById('r-send-label')!;
      const status = document.getElementById('r-status')!;
      const nameInput = document.getElementById('r-name') as HTMLInputElement;
      const emailInput = document.getElementById('r-email') as HTMLInputElement;
      const msgInput = document.getElementById('r-msg') as HTMLTextAreaElement;
      const honeypot = (document.getElementById('r-website') as HTMLInputElement | null);

      const name = nameInput.value.trim();
      const email = emailInput.value.trim();
      const message = msgInput.value.trim();

      if (!email || !/^\S+@\S+\.\S+$/.test(email)) {
        status.textContent = (window as any).__cozyT?.('recado.email_invalid') || 'coloca um email válido pra eu poder responder :)';
        status.hidden = false;
        emailInput.focus();
        return;
      }
      if (!message) {
        status.textContent = (window as any).__cozyT?.('recado.empty') || 'escreve a mensagem antes de enviar :)';
        status.hidden = false;
        msgInput.focus();
        return;
      }

      const originalLabel = sendLabel.textContent;
      sendBtn.disabled = true;
      sendLabel.textContent = (window as any).__cozyT?.('recado.sending') || 'enviando...';
      status.hidden = true;

      try {
        const resp = await fetch('/recados', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name,
            email,
            message,
            website: honeypot?.value || '',
          }),
        });
        if (!resp.ok) {
          const err = await resp.json().catch(() => ({}));
          throw new Error(err.error || 'Erro ' + resp.status);
        }
        // Sucesso
        status.textContent = (window as any).__cozyT?.('recado.sent') || 'obrigada pelo recado! 💛';
        status.hidden = false;
        nameInput.value = '';
        emailInput.value = '';
        msgInput.value = '';
      } catch (e: any) {
        status.textContent = ((window as any).__cozyT?.('recado.error') || 'ops, algo deu errado') + ' (' + (e?.message || 'erro') + ')';
        status.hidden = false;
      } finally {
        sendBtn.disabled = false;
        sendLabel.textContent = originalLabel || 'enviar';
      }
    });
  </script>
</BaseLayout>
