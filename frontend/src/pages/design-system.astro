---
import BaseLayout from '../layouts/BaseLayout.astro';

const colors = [
  { name: 'intro-blue', hex: '#D7F5FF', role: 'Azul claro · sopro de manhã, assinatura' },
  { name: 'terracota',  hex: '#C56B4A', role: 'Acento warm · calor, paneladas' },
  { name: 'cover-dark', hex: '#1A2840', role: 'Cover da intro (azul escuro)' },
  { name: 'bg',         hex: '#FAF6EE', role: 'Background warm (creme)' },
  { name: 'surface',    hex: '#F4EFE2', role: 'Surface sutil sobre o bg' },
  { name: 'ink',        hex: '#1A1A1A', role: 'Texto principal' },
  { name: 'ink-soft',   hex: '#6B5F4F', role: 'Texto secundário (warm gray)' },
  { name: 'ink-mute',   hex: '#A89F8E', role: 'Texto sutil, metadata' },
  { name: 'line',       hex: '#E5DFD3', role: 'Border padrão' },
  { name: 'success',    hex: '#5C8A4D', role: 'Sucesso' },
  { name: 'warning',    hex: '#C9954C', role: 'Aviso' },
  { name: 'danger',     hex: '#B8503A', role: 'Erro' },
];

const types = [
  { name: 'display', size: '96px max · clamp', usage: 'Hero da homepage (logo)', sample: 'Cozy Corner', font: 'var(--font-display)', cls: 't-display' },
  { name: 'intro',   size: '32px max · clamp', usage: 'Frases typewriter da intro', sample: 'que bom te ver por aqui :)', font: 'var(--font-mono)', cls: 't-intro' },
  { name: 'h1',      size: '48px max · clamp', usage: 'Título de página (receita)', sample: 'Risoto de cogumelos', font: 'var(--font-display)', cls: 't-h1' },
  { name: 'h2',      size: '32px max · clamp', usage: 'Título de seção', sample: 'Ingredientes', font: 'var(--font-display)', cls: 't-h2' },
  { name: 'h3',      size: '18px',             usage: 'Subseção, label forte', sample: 'Materiais', font: 'var(--font-sans)', cls: 't-h3' },
  { name: 'body',    size: '16px',             usage: 'Texto corrido', sample: 'Aqueça o caldo de legumes e mantenha em fogo baixo. Refogue a cebola picada no azeite até ficar translúcida.', font: 'var(--font-sans)', cls: 't-body' },
  { name: 'small',   size: '14px',             usage: 'Auxiliares, hints', sample: 'recomendado: 1600×900, JPG ou WebP', font: 'var(--font-sans)', cls: 't-small' },
  { name: 'caption', size: '12px',             usage: 'Captions, footnotes', sample: 'foto: angela madeira', font: 'var(--font-sans)', cls: 't-caption' },
  { name: 'meta',    size: '13px mono',        usage: 'Tempo, porções, dimensões — tom typewriter', sample: '⏱ 40 min · 🍽 4 porções · 📊 médio', font: 'var(--font-mono)', cls: 't-meta' },
];
---

<BaseLayout title="Design System" description="Tokens, tipografia e componentes do Cozy Corner.">
  <div class="ds-shell">
    <header class="ds-header">
      <div>
        <p class="t-meta">/design-system</p>
        <h1 class="t-display ds-title">Design System</h1>
        <p class="t-body" style="color: var(--ink-soft); margin-top: 8px; max-width: 560px;">
          Tokens, tipografia e princípios do Cozy Corner. Toda decisão visual sai daqui.
        </p>
      </div>
      <button class="dark-toggle" id="dark-toggle" type="button" aria-label="alternar dark mode">💡</button>
    </header>

    <!-- ============ MOMENTOS DA MARCA ============ -->
    <section class="ds-section">
      <h2 class="ds-section-title">Momentos da marca</h2>

      <div class="moment moment-intro">
        <span class="moment-tag">intro cover</span>
        <p class="t-intro" style="color: white;">olá!</p>
        <p class="t-intro" style="color: white; margin-top: 12px;">que bom te ver por aqui :)<span class="caret">|</span></p>
      </div>

      <div class="moment moment-hero">
        <span class="moment-tag">hero pós-wipe</span>
        <div style="text-align: center;">
          <div class="t-display">Cozy Corner</div>
          <div class="t-meta" style="opacity: 0.6; margin-top: 4px;">recipes by Gigi</div>
        </div>
      </div>

      <div class="moment moment-recipe">
        <span class="moment-tag">página de receita</span>
        <h1 class="t-h1">Risoto de cogumelos</h1>
        <p class="t-meta" style="margin-top: 8px; color: var(--ink-soft);">⏱ 40 min · 🍽 4 porções · 📊 médio · 🌱 vegetariana</p>
        <p class="t-body" style="margin-top: 16px; color: var(--ink-soft); max-width: 540px;">
          Um clássico italiano cremoso, com cogumelos paris dourados e parmesão. Receita da minha avó.
        </p>
      </div>
    </section>

    <!-- ============ CORES ============ -->
    <section class="ds-section">
      <h2 class="ds-section-title">Cores</h2>
      <p class="t-small" style="color: var(--ink-soft); margin-bottom: 24px;">
        Light mode em uso. Acionando o interruptor (💡 acima), todas as cores semânticas adaptam.
      </p>
      <div class="swatch-grid">
        {colors.map(c => (
          <div class="swatch">
            <div class="swatch-color" style={`background: ${c.hex}; ${c.name === 'bg' || c.name === 'surface' || c.name === 'line' || c.name === 'intro-blue' ? 'border: 1px solid var(--line);' : ''}`}></div>
            <div class="swatch-info">
              <div class="t-h3">--{c.name}</div>
              <div class="t-meta" style="color: var(--ink-soft);">{c.hex}</div>
              <div class="t-small" style="color: var(--ink-soft); margin-top: 4px;">{c.role}</div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ============ TIPOGRAFIA ============ -->
    <section class="ds-section">
      <h2 class="ds-section-title">Tipografia</h2>
      <p class="t-small" style="color: var(--ink-soft); margin-bottom: 24px;">
        <strong>Cutive Mono</strong> aplicada em tudo — identidade unificada de "carta digitada".
        Hierarquia vem do <em>tamanho</em>, <em>letter-spacing</em> e <em>uppercase</em>, não do peso (Cutive Mono tem só 400).
      </p>
      <div class="type-list">
        {types.map(t => (
          <div class="type-row">
            <div class="type-meta">
              <div class="t-h3" style="font-family: var(--font-sans);">--fs-{t.name}</div>
              <div class="t-meta" style="color: var(--ink-soft); margin-top: 2px;">{t.size}</div>
              <div class="t-small" style="color: var(--ink-soft); margin-top: 4px;">{t.usage}</div>
            </div>
            <div class={`type-sample ${t.cls}`}>{t.sample}</div>
          </div>
        ))}
      </div>
    </section>

    <!-- ============ ESPAÇO / RADIUS ============ -->
    <section class="ds-section ds-section-half">
      <div>
        <h2 class="ds-section-title">Espaço</h2>
        <p class="t-small" style="color: var(--ink-soft); margin-bottom: 16px;">Escala base-4.</p>
        <div class="space-list">
          {[1,2,3,4,5,6,7,8,9].map(n => (
            <div class="space-row">
              <code class="t-meta">--s-{n}</code>
              <div class="space-bar" style={`width: var(--s-${n}); height: 12px; background: var(--terracota); border-radius: var(--r-sm);`}></div>
            </div>
          ))}
        </div>
      </div>

      <div>
        <h2 class="ds-section-title">Radius</h2>
        <p class="t-small" style="color: var(--ink-soft); margin-bottom: 16px;">4 valores fixos.</p>
        <div class="radius-list">
          <div class="radius-item"><div class="rbox" style="border-radius: var(--r-sm);"></div><code class="t-meta">--r-sm · 4px</code></div>
          <div class="radius-item"><div class="rbox" style="border-radius: var(--r-md);"></div><code class="t-meta">--r-md · 8px</code></div>
          <div class="radius-item"><div class="rbox" style="border-radius: var(--r-lg);"></div><code class="t-meta">--r-lg · 16px</code></div>
          <div class="radius-item"><div class="rbox" style="border-radius: var(--r-pill);"></div><code class="t-meta">--r-pill · 999</code></div>
        </div>
      </div>
    </section>

    <!-- ============ SOMBRAS ============ -->
    <section class="ds-section">
      <h2 class="ds-section-title">Sombras</h2>
      <div class="shadow-grid">
        <div class="shadow-box" style="box-shadow: var(--shadow-1);"><code class="t-meta">--shadow-1</code><div class="t-small" style="color: var(--ink-soft); margin-top: 4px;">card, sutil</div></div>
        <div class="shadow-box" style="box-shadow: var(--shadow-2);"><code class="t-meta">--shadow-2</code><div class="t-small" style="color: var(--ink-soft); margin-top: 4px;">drawer, dropdown</div></div>
        <div class="shadow-box" style="box-shadow: var(--shadow-3);"><code class="t-meta">--shadow-3</code><div class="t-small" style="color: var(--ink-soft); margin-top: 4px;">modal, popover central</div></div>
      </div>
    </section>

    <!-- ============ COMPONENTES ============ -->
    <section class="ds-section">
      <h2 class="ds-section-title">Botões (preview)</h2>
      <div class="btn-row">
        <button class="btn btn-primary">📱 Mandar pro WhatsApp</button>
        <button class="btn btn-secondary">Salvar rascunho</button>
        <button class="btn btn-ghost">Cancelar</button>
        <button class="btn btn-icon" aria-label="favoritar">⭐</button>
      </div>

      <h2 class="ds-section-title" style="margin-top: 48px;">Chips / filtros</h2>
      <div class="chip-row">
        <span class="chip chip-active">todas</span>
        <span class="chip">⏱ até 30 min</span>
        <span class="chip">🌱 vegetariana</span>
        <span class="chip">⭐ favoritas</span>
        <span class="chip">sem glúten</span>
      </div>
    </section>

    <footer class="ds-footer">
      <p class="t-meta" style="color: var(--ink-soft);">
        v0.1 · <strong>palette A</strong> + <strong>tipo B</strong> (Fraunces · Inter · Courier Prime) ·
        atualizado em {new Date().toLocaleDateString('pt-BR')}
      </p>
    </footer>
  </div>

  <style>
    /* ============ TYPE CLASSES ============ */
    .t-display { font-family: var(--font-display); font-size: var(--fs-display); font-weight: 500; letter-spacing: -0.03em; line-height: var(--lh-tight); }
    .t-h1      { font-family: var(--font-display); font-size: var(--fs-h1); font-weight: 500; letter-spacing: -0.02em; line-height: var(--lh-tight); }
    .t-h2      { font-family: var(--font-display); font-size: var(--fs-h2); font-weight: 500; letter-spacing: -0.01em; line-height: var(--lh-snug); }
    .t-h3      { font-family: var(--font-sans); font-size: var(--fs-h3); font-weight: 600; letter-spacing: -0.005em; line-height: var(--lh-snug); }
    .t-body    { font-family: var(--font-sans); font-size: var(--fs-body); line-height: var(--lh-base); }
    .t-small   { font-family: var(--font-sans); font-size: var(--fs-small); line-height: var(--lh-base); }
    .t-caption { font-family: var(--font-sans); font-size: var(--fs-caption); line-height: var(--lh-base); }
    .t-intro   { font-family: var(--font-mono); font-size: var(--fs-intro); font-weight: 400; line-height: var(--lh-snug); }
    .t-meta    { font-family: var(--font-mono); font-size: var(--fs-meta); line-height: var(--lh-base); }

    /* ============ SHELL ============ */
    .ds-shell { max-width: var(--max-content); margin: 0 auto; padding: var(--s-7) var(--s-6) var(--s-9); }

    .ds-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      gap: var(--s-5);
      margin-bottom: var(--s-9);
    }
    .ds-title { line-height: 1; }
    .dark-toggle {
      width: 44px; height: 44px;
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--r-pill);
      font-size: 20px;
      cursor: pointer;
      transition: transform var(--dur-fast) var(--ease-out);
    }
    .dark-toggle:hover { transform: scale(1.05); }

    .ds-section {
      padding: var(--s-7) 0;
      border-top: 1px solid var(--line);
    }
    .ds-section-half { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-7); }
    .ds-section-title {
      font-family: var(--font-display);
      font-size: 22px;
      font-weight: 500;
      letter-spacing: -0.01em;
      margin-bottom: var(--s-3);
    }

    /* ============ MOMENTOS ============ */
    .moment {
      position: relative;
      padding: var(--s-7);
      border-radius: var(--r-lg);
      margin-bottom: var(--s-4);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 200px;
      text-align: center;
    }
    .moment-tag {
      position: absolute;
      top: var(--s-3); left: var(--s-3);
      font-family: var(--font-mono);
      font-size: 11px;
      color: var(--ink-mute);
      text-transform: lowercase;
      letter-spacing: 0.05em;
    }
    .moment-intro {
      background: var(--cover-dark);
    }
    .moment-intro .moment-tag { color: rgba(255,255,255,0.4); }
    .moment-intro .caret {
      display: inline-block;
      margin-left: 4px;
      opacity: 0.7;
      animation: blink 0.9s steps(2) infinite;
    }
    @keyframes blink { 0%,50%{opacity:0.7;} 51%,100%{opacity:0;} }
    .moment-hero {
      background: var(--intro-blue);
      min-height: 240px;
    }
    .moment-recipe {
      background: var(--surface);
      text-align: left;
      align-items: flex-start;
    }

    /* ============ SWATCHES ============ */
    .swatch-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
      gap: var(--s-4);
    }
    .swatch {
      background: var(--surface);
      border-radius: var(--r-md);
      overflow: hidden;
    }
    .swatch-color {
      height: 80px;
      width: 100%;
    }
    .swatch-info { padding: var(--s-3); }

    /* ============ TIPOGRAFIA ============ */
    .type-list { display: flex; flex-direction: column; gap: var(--s-5); }
    .type-row {
      display: grid;
      grid-template-columns: 220px 1fr;
      gap: var(--s-5);
      align-items: baseline;
      padding-bottom: var(--s-4);
      border-bottom: 1px solid var(--line-soft);
    }
    .type-meta {}
    .type-sample { color: var(--ink); }
    @media (max-width: 768px) {
      .type-row { grid-template-columns: 1fr; gap: var(--s-2); }
    }

    /* ============ ESPAÇO / RADIUS ============ */
    .space-list, .radius-list { display: flex; flex-direction: column; gap: var(--s-3); }
    .space-row {
      display: flex;
      align-items: center;
      gap: var(--s-4);
    }
    .space-row code { min-width: 60px; color: var(--ink-soft); }
    .radius-item {
      display: flex;
      align-items: center;
      gap: var(--s-4);
    }
    .rbox {
      width: 48px; height: 48px;
      background: var(--terracota);
    }
    @media (max-width: 768px) { .ds-section-half { grid-template-columns: 1fr; } }

    /* ============ SOMBRAS ============ */
    .shadow-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: var(--s-5);
    }
    .shadow-box {
      background: var(--bg);
      padding: var(--s-5);
      border-radius: var(--r-md);
      min-height: 120px;
    }
    @media (max-width: 768px) { .shadow-grid { grid-template-columns: 1fr; } }

    /* ============ BOTÕES ============ */
    .btn-row, .chip-row {
      display: flex;
      flex-wrap: wrap;
      gap: var(--s-3);
      align-items: center;
    }
    .btn {
      padding: 10px 16px;
      border-radius: var(--r-sm);
      font: inherit;
      font-size: var(--fs-small);
      cursor: pointer;
      transition: opacity var(--dur-fast), transform var(--dur-fast), background var(--dur-base);
      border: 1px solid transparent;
    }
    .btn:hover { transform: translateY(-1px); }
    .btn-primary {
      background: var(--terracota);
      color: white;
      border-color: var(--terracota);
    }
    .btn-primary:hover { opacity: 0.92; }
    .btn-secondary {
      background: var(--ink);
      color: var(--bg);
      border-color: var(--ink);
    }
    .btn-ghost {
      background: transparent;
      color: var(--ink);
      border-color: var(--line);
    }
    .btn-ghost:hover { background: var(--surface); }
    .btn-icon {
      width: 40px; height: 40px;
      padding: 0;
      display: inline-flex;
      align-items: center; justify-content: center;
      background: var(--surface);
      border-color: var(--line);
      font-size: 18px;
    }

    /* ============ CHIPS ============ */
    .chip {
      padding: 6px 12px;
      border: 1px solid var(--line);
      border-radius: var(--r-pill);
      font-size: var(--fs-caption);
      cursor: pointer;
      background: var(--bg);
      color: var(--ink-soft);
      transition: all var(--dur-fast) var(--ease-out);
    }
    .chip:hover { border-color: var(--terracota); color: var(--ink); }
    .chip-active {
      background: var(--ink);
      color: var(--bg);
      border-color: var(--ink);
    }

    /* ============ FOOTER ============ */
    .ds-footer {
      padding-top: var(--s-7);
      border-top: 1px solid var(--line);
      margin-top: var(--s-7);
    }
  </style>

  <script>
    const toggle = document.getElementById('dark-toggle');
    toggle?.addEventListener('click', () => {
      document.body.classList.toggle('dark-mode');
      const isDark = document.body.classList.contains('dark-mode');
      toggle.textContent = isDark ? '🌙' : '💡';
    });
  </script>
</BaseLayout>
