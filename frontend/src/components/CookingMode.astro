---
import { Icon } from 'astro-icon/components';

interface Props {
  steps: string[];
  ingredients: string[];
  recipeTitle: string;
  triggerSelector?: string;
}

const { steps, ingredients, recipeTitle, triggerSelector = '#open-cooking-mode' } = Astro.props;
---

<div class="cm-overlay" id="cooking-mode" hidden role="dialog" aria-modal="true" aria-label={`Modo cozinha — ${recipeTitle}`}>
  <header class="cm-header">
    <button class="cm-icon-btn cm-ing-toggle-mobile" id="cm-ingredients-toggle" type="button" aria-label="mostrar ingredientes" aria-expanded="true">
      <Icon name="ph:list-bullets-thin" width={22} height={22} />
    </button>
    <div class="cm-progress">
      <span class="cm-step-num" id="cm-step-num">1</span>
      <span class="cm-of">de</span>
      <span class="cm-step-total">{steps.length}</span>
    </div>
    <button class="cm-icon-btn" id="cm-close" type="button" aria-label="sair do modo cozinha">
      <Icon name="ph:x-thin" width={22} height={22} />
    </button>
  </header>

  <div class="cm-progress-bar" aria-hidden="true">
    <div class="cm-progress-fill" id="cm-progress-fill"></div>
  </div>

  <div class="cm-body">
    <div class="cm-main">
      <main class="cm-stage">
        <p class="cm-step-text" id="cm-step-text"></p>
      </main>

      <div class="cm-end" id="cm-end" hidden>
        <Icon name="ph:fork-knife-thin" width={56} height={56} />
        <h2 class="cm-end-title">Pronto.</h2>
        <p class="cm-end-sub">Bom apetite, viu.</p>
        <button class="cm-restart" id="cm-restart" type="button">
          <svg class="cm-restart-icon" viewBox="0 0 256 256" width="16" height="16" aria-hidden="true">
            <path d="M220 128a92 92 0 0 1-90.77 92H128a91.47 91.47 0 0 1-63.13-25.1a4 4 0 1 1 5.5-5.82A84 84 0 1 0 68.6 68.57l-.13.12L34.3 100H72a4 4 0 0 1 0 8H24a4 4 0 0 1-4-4V56a4 4 0 0 1 8 0v38.89l35-32A92 92 0 0 1 220 128"/>
          </svg>
          <span class="cm-restart-text">revisar do início</span>
        </button>
      </div>

      <footer class="cm-nav">
        <button class="cm-nav-btn cm-prev" id="cm-prev" type="button">
          <Icon name="ph:caret-left-thin" width={18} height={18} />
          <span>anterior</span>
        </button>
        <button class="cm-nav-btn cm-next" id="cm-next" type="button">
          <span id="cm-next-label">próximo</span>
          <Icon name="ph:caret-right-thin" width={18} height={18} />
        </button>
      </footer>
    </div>

    <aside class="cm-ingredients" id="cm-ingredients">
      <header class="cm-ing-header">
        <h3>Ingredientes</h3>
      </header>
      <ul class="cm-ing-list">
        {ingredients.map((ing) => (
          <li>
            <label>
              <input type="checkbox" />
              <span>{ing}</span>
            </label>
          </li>
        ))}
      </ul>
    </aside>
  </div>
</div>

<script define:vars={{ steps, triggerSelector }}>
  const overlay = document.getElementById('cooking-mode');
  const trigger = document.querySelector(triggerSelector);
  const stepText = document.getElementById('cm-step-text');
  const stepNum = document.getElementById('cm-step-num');
  const progressFill = document.getElementById('cm-progress-fill');
  const prevBtn = document.getElementById('cm-prev');
  const nextBtn = document.getElementById('cm-next');
  const nextLabel = document.getElementById('cm-next-label');
  const closeBtn = document.getElementById('cm-close');
  const ingredientsBtn = document.getElementById('cm-ingredients-toggle');
  const ingredientsPanel = document.getElementById('cm-ingredients');
  const endScreen = document.getElementById('cm-end');
  const restartBtn = document.getElementById('cm-restart');
  const stage = document.querySelector('.cm-stage');
  const navEl = document.querySelector('.cm-nav');

  let current = 0;
  let wakeLock = null;

  async function requestWakeLock() {
    if (!('wakeLock' in navigator)) return;
    try {
      wakeLock = await navigator.wakeLock.request('screen');
      wakeLock.addEventListener('release', () => { wakeLock = null; });
    } catch (err) {
      // wakelock pode ser bloqueado pelo SO ou pela falta de visibilidade — silencioso por design
    }
  }

  async function releaseWakeLock() {
    if (wakeLock) {
      try { await wakeLock.release(); } catch (e) {}
      wakeLock = null;
    }
  }

  function render() {
    const total = steps.length;
    const atEnd = current >= total;

    if (atEnd) {
      stage.setAttribute('hidden', '');
      endScreen.removeAttribute('hidden');
      navEl?.setAttribute('hidden', '');
      stepNum.textContent = total;
      progressFill.style.width = '100%';
    } else {
      stage.removeAttribute('hidden');
      endScreen.setAttribute('hidden', '');
      navEl?.removeAttribute('hidden');
      stepText.textContent = steps[current];
      stepNum.textContent = current + 1;
      progressFill.style.width = ((current + 1) / total) * 100 + '%';
      nextLabel.textContent = current === total - 1 ? 'concluir' : 'próximo';
    }

    prevBtn.disabled = current === 0;
    nextBtn.disabled = false;
  }

  function open() {
    if (!overlay) return;
    current = 0;
    overlay.removeAttribute('hidden');
    document.body.style.overflow = 'hidden';
    requestWakeLock();
    render();
    // Re-request wakelock quando a aba volta a ficar visível
    document.addEventListener('visibilitychange', onVisibilityChange);
  }

  function close() {
    if (!overlay) return;
    overlay.setAttribute('hidden', '');
    document.body.style.overflow = '';
    releaseWakeLock();
    document.removeEventListener('visibilitychange', onVisibilityChange);
  }

  function onVisibilityChange() {
    if (document.visibilityState === 'visible' && !overlay.hasAttribute('hidden')) {
      requestWakeLock();
    }
  }

  function next() {
    if (current < steps.length) current++;
    render();
  }

  function prev() {
    if (current > 0) current--;
    if (current < steps.length) {
      stage.removeAttribute('hidden');
      endScreen.setAttribute('hidden', '');
    }
    render();
  }

  function restart() {
    current = 0;
    render();
  }

  trigger?.addEventListener('click', open);
  closeBtn?.addEventListener('click', close);
  prevBtn?.addEventListener('click', prev);
  nextBtn?.addEventListener('click', next);
  restartBtn?.addEventListener('click', restart);

  // Toggle ingredientes (só usado em mobile — em desktop fica sempre visível)
  ingredientsBtn?.addEventListener('click', () => {
    const collapsed = ingredientsPanel.classList.toggle('cm-ing-collapsed');
    ingredientsBtn.setAttribute('aria-expanded', collapsed ? 'false' : 'true');
  });

  // Keyboard
  document.addEventListener('keydown', (e) => {
    if (overlay.hasAttribute('hidden')) return;
    if (e.key === 'Escape') {
      close();
    } else if (e.key === 'ArrowRight' || e.key === ' ') {
      e.preventDefault();
      next();
    } else if (e.key === 'ArrowLeft') {
      e.preventDefault();
      prev();
    }
  });

  // Swipe em mobile
  let touchStartX = 0;
  stage?.addEventListener('touchstart', (e) => {
    touchStartX = e.touches[0].clientX;
  }, { passive: true });
  stage?.addEventListener('touchend', (e) => {
    const dx = e.changedTouches[0].clientX - touchStartX;
    if (Math.abs(dx) < 50) return;
    if (dx < 0) next();
    else prev();
  });
</script>

<style>
  .cm-overlay {
    position: fixed;
    inset: 0;
    z-index: 1000;
    background: var(--bg);
    display: grid;
    grid-template-rows: auto auto 1fr;
    overflow: hidden;
  }
  body.dark-mode .cm-overlay { background: var(--bg); }

  /* Body em 2 colunas: passo + nav à esquerda, ingredientes estáticos à direita. */
  .cm-body {
    display: grid;
    grid-template-columns: 1fr 340px;
    overflow: hidden;
    min-height: 0;
  }
  /* Coluna esquerda: stage (cresce) + nav (auto) embaixo */
  .cm-main {
    display: grid;
    grid-template-rows: 1fr auto;
    overflow: hidden;
    min-height: 0;
  }
  /* Botão de toggle só aparece em mobile (em desktop ingredientes é fixo) */
  .cm-ing-toggle-mobile { visibility: hidden; }

  /* ============ HEADER ============ */
  .cm-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--s-4) var(--s-5);
    border-bottom: 1px solid var(--line-soft);
  }
  .cm-icon-btn {
    width: 40px; height: 40px;
    background: transparent;
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--ink);
    transition: all var(--dur-fast);
  }
  .cm-icon-btn:hover { background: var(--surface); border-color: var(--ink); }
  .cm-icon-btn :global(svg) { fill: none; stroke: currentColor; }

  .cm-progress {
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    color: var(--ink-soft);
    display: inline-flex;
    align-items: baseline;
    gap: 4px;
  }
  .cm-step-num {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 28px;
    color: var(--terracota);
    line-height: 1;
  }
  .cm-of { opacity: 0.6; }
  .cm-step-total { font-weight: 500; }

  /* ============ PROGRESS BAR ============ */
  .cm-progress-bar {
    height: 3px;
    background: var(--line-soft);
    overflow: hidden;
  }
  .cm-progress-fill {
    height: 100%;
    width: 0;
    background: var(--terracota);
    transition: width var(--dur-base) ease;
  }

  /* ============ STAGE (step display) ============ */
  /* stage e end ocupam a mesma célula do grid (row 1); o nav vai pra row 2 */
  .cm-stage, .cm-end { grid-row: 1; }
  .cm-nav { grid-row: 2; }

  .cm-stage {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--s-8) var(--s-6);
    overflow-y: auto;
    user-select: none;
  }
  .cm-step-text {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(24px, 4vw, 40px);
    line-height: 1.4;
    color: var(--ink);
    max-width: 720px;
    text-align: center;
    letter-spacing: -0.01em;
  }

  /* ============ END SCREEN ============ */
  .cm-end {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: var(--s-8) var(--s-6);
    text-align: center;
    color: var(--ink);
  }
  /* '>' limita ao SVG filho direto (o fork-knife no topo), não o do botão restart */
  .cm-end > :global(svg) {
    color: var(--terracota);
    fill: none;
    stroke: currentColor;
    margin-bottom: var(--s-5);
  }
  .cm-end-title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(40px, 6vw, 56px);
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin-bottom: var(--s-3);
  }
  .cm-end-sub {
    font-family: var(--font-mono);
    font-size: var(--fs-body);
    color: var(--ink-soft);
    margin-bottom: var(--s-6);
  }
  .cm-restart {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 20px;
    margin: 0;
    background: transparent;
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    font-family: var(--font-mono);
    font-size: var(--fs-small);
    line-height: 1;
    color: var(--ink);
    cursor: pointer;
    transition: background var(--dur-fast), border-color var(--dur-fast), color var(--dur-fast);
  }
  .cm-restart:hover { background: var(--surface); border-color: var(--terracota); color: var(--terracota); }
  .cm-restart :global(.cm-restart-icon) {
    flex: none;
    width: 16px;
    height: 16px;
    margin: 0;
    fill: currentColor;
    color: var(--terracota);
  }
  .cm-restart:hover :global(.cm-restart-icon) { color: var(--terracota); }
  .cm-restart :global(.cm-restart-text) { line-height: 1; }

  /* ============ NAV ============ */
  .cm-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: var(--line-soft);
    border-top: 1px solid var(--line-soft);
  }
  .cm-nav-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--s-2);
    background: var(--bg);
    border: none;
    padding: var(--s-5) var(--s-4);
    font: inherit;
    font-family: var(--font-mono);
    font-size: var(--fs-body);
    color: var(--ink);
    cursor: pointer;
    transition: background var(--dur-fast);
  }
  .cm-nav-btn:hover:not(:disabled) { background: var(--surface); }
  .cm-nav-btn:disabled {
    color: var(--ink-mute);
    cursor: default;
  }
  .cm-next { color: var(--terracota); font-weight: 500; }
  .cm-nav-btn :global(svg) { fill: none; stroke: currentColor; }

  /* ============ INGREDIENTS PANEL ============ */
  .cm-ingredients {
    background: var(--surface);
    border-left: 1px solid var(--line-soft);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    min-height: 0;
  }
  .cm-ing-header {
    display: flex;
    align-items: center;
    padding: var(--s-5) var(--s-5);
    border-bottom: 1px solid var(--line-soft);
  }
  .cm-ing-header h3 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--fs-h3);
  }
  .cm-ing-list {
    list-style: none;
    padding: var(--s-4) 0;
    overflow-y: auto;
    flex: 1;
  }
  .cm-ing-list li { border-bottom: 1px solid var(--line-soft); }
  .cm-ing-list label {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    padding: var(--s-3) var(--s-5);
    font-family: var(--font-mono);
    font-size: var(--fs-small);
    color: var(--ink);
    cursor: pointer;
    transition: background var(--dur-fast);
  }
  .cm-ing-list label:hover { background: var(--bg); }
  .cm-ing-list input[type="checkbox"] {
    width: 18px; height: 18px;
    accent-color: var(--terracota);
    cursor: pointer;
  }
  .cm-ing-list input:checked + span {
    text-decoration: line-through;
    color: var(--ink-mute);
  }

  /* ============ MOBILE ============ */
  @media (max-width: 760px) {
    .cm-body {
      grid-template-columns: 1fr;
      grid-template-rows: auto 1fr;
    }
    .cm-ingredients {
      border-left: none;
      border-bottom: 1px solid var(--line-soft);
      max-height: 40vh;
      transition: max-height var(--dur-base) var(--ease-out, ease), opacity var(--dur-base);
    }
    .cm-ingredients.cm-ing-collapsed {
      max-height: 0;
      opacity: 0;
      border-bottom-width: 0;
      pointer-events: none;
    }
    .cm-ing-toggle-mobile { visibility: visible; }
    .cm-header { padding: var(--s-3) var(--s-4); }
    .cm-step-num { font-size: 22px; }
    .cm-stage { padding: var(--s-6) var(--s-4); }
    .cm-nav-btn { padding: var(--s-4) var(--s-3); font-size: var(--fs-small); }
  }
</style>
