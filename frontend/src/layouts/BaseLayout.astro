---
import '../styles/global.css';
import siteData from '../content/pages/site.json';

interface Props {
  title?: string;
  description?: string;
  lang?: string;
}

const { title, description, lang = 'pt-br' } = Astro.props;
const pageTitle = title ? `${title} · ${siteData.title}` : siteData.title;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cutive+Mono&family=Inter:wght@300;400;500&display=swap" rel="stylesheet" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
  </head>
  <body>
    <slot />
  </body>
</html>
