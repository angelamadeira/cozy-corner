---
import '../styles/global.css';
import siteData from '../content/pages/site.json';
import ptDict from '../i18n/pt.json';
import enDict from '../i18n/en.json';
// Conteúdo editável pelo Decap. Cada arquivo é { pt: {...}, en: {...} }
// e mergea pra dentro do dict do i18n no build, sob um namespace.
// Os valores aqui SOBRESCREVEM os de pt.json/en.json — i18n vira fallback.
import introContent from '../content/pages/intro.json';
import hotspotContent from '../content/pages/cozinha.json';
import categoryContent from '../content/pages/categorias.json';
import recadoContent from '../content/pages/recado.json';
import sobreContent from '../content/pages/sobre.json';

interface Props {
  title?: string;
  description?: string;
  lang?: string;
}

const { title, description, lang = 'pt-br' } = Astro.props;
const pageTitle = title ? `${title} · ${siteData.title}` : siteData.title;

// Merge per-section content em pt/en dicts sob seu namespace correspondente.
// Ex: intro.json.pt.hello → ptDict.intro.hello (sobrescreve se já existir).
type LangContent = { pt?: Record<string, string>; en?: Record<string, string> };
const sections: Record<string, LangContent> = {
  intro: introContent,
  hotspot: hotspotContent,
  category: categoryContent,
  recado: recadoContent,
  sobre: sobreContent,
};
function mergeContent(dict: any, code: 'pt' | 'en') {
  for (const [ns, data] of Object.entries(sections)) {
    const langData = data?.[code];
    if (!langData) continue;
    dict[ns] = { ...(dict[ns] || {}), ...langData };
  }
}
mergeContent(ptDict, 'pt');
mergeContent(enDict, 'en');

// Serializa dicionários pro client-side runtime
const dictsJson = JSON.stringify({ pt: ptDict, en: enDict });
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;600&family=Cutive+Mono&family=Inter:wght@300;400;500&display=swap" rel="stylesheet" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <!-- Cor da barra de navegação no iOS Safari + Chrome mobile.
         Default cream — script abaixo ajusta pra navy se dark mode tá on.
         color-scheme=light força iOS a não usar o tema do sistema,
         só nosso theme-color manda. -->
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" id="theme-color-meta" content="#FAF6EE" />
    <!-- Aplica dark mode ANTES do body renderizar pra evitar flash.
         Também marca html se a cozinha já foi alcançada — pra esconder
         o intro-cover antes do paint (senão iOS Safari samplea o navy
         do cover e pinta a barra de URL com essa cor). -->
    <script is:inline>
      try {
        var isDark = localStorage.getItem('cozy-dark-mode') === 'true';
        if (isDark) {
          document.documentElement.classList.add('pre-dark');
          var m = document.getElementById('theme-color-meta');
          if (m) m.setAttribute('content', '#0F1A2A');
        }
        if (localStorage.getItem('cozy-kitchen-reached') === 'true') {
          document.documentElement.classList.add('cozy-kitchen-locked');
        }
      } catch (e) {}
    </script>

    <!-- Transição entre páginas: se o link de saída setou o flag,
         começa com um overlay cobrindo a tela e some no load. -->
    <script is:inline>
      try {
        if (sessionStorage.getItem('cozy-fade-in') === '1') {
          document.documentElement.classList.add('cozy-fading-in');
          sessionStorage.removeItem('cozy-fade-in');
        }
      } catch (e) {}
    </script>

    <!-- Mede a viewport real e expõe como --vh-real.
         100vh / 100svh no iOS Safari nem sempre exclui a barra de URL,
         então usamos window.innerHeight que é confiável em qualquer
         navegador. Re-mede em resize/orientation change. -->
    <script is:inline>
      (function () {
        function setVH() {
          document.documentElement.style.setProperty('--vh-real', window.innerHeight + 'px');
        }
        setVH();
        window.addEventListener('resize', setVH);
        window.addEventListener('orientationchange', setVH);
      })();
    </script>

    <!-- Sincroniza theme-color quando o dark mode é alternado em runtime
         (observer na class do body). Mantém a barra do iOS sempre na
         mesma cor que o fundo da página.
         iOS Safari às vezes cacheia a primeira leitura do theme-color
         e não atualiza — então re-setamos várias vezes (load, 200ms,
         e em qualquer mudança de class no body). -->
    <script is:inline>
      (function () {
        function syncThemeColor() {
          var m = document.getElementById('theme-color-meta');
          if (!m) return;
          var isDark = document.body.classList.contains('dark-mode');
          var color = isDark ? '#0F1A2A' : '#FAF6EE';
          // Força reset: remove e re-cria a meta tag — iOS Safari trata
          // como tag nova e re-lê. Hack mas funciona pra cache teimoso.
          var parent = m.parentNode;
          parent.removeChild(m);
          m.setAttribute('content', color);
          parent.appendChild(m);
        }
        document.addEventListener('DOMContentLoaded', function () {
          syncThemeColor();
          // iOS Safari pode ignorar a primeira leitura — re-aplica depois
          // de uns ms pra garantir.
          setTimeout(syncThemeColor, 100);
          setTimeout(syncThemeColor, 500);
          var obs = new MutationObserver(syncThemeColor);
          obs.observe(document.body, { attributes: true, attributeFilter: ['class'] });
        });
        // Re-aplica quando a aba fica visível de novo (volta de outra aba/app)
        document.addEventListener('visibilitychange', function () {
          if (!document.hidden) syncThemeColor();
        });
      })();
    </script>

    <!-- i18n: detecta idioma, aplica traduções via data-t -->
    <script is:inline define:vars={{ dictsJson }}>
      window.__COZY_I18N = JSON.parse(dictsJson);
      window.__COZY_LANG = (function () {
        try {
          const saved = localStorage.getItem('cozy-lang');
          if (saved === 'pt' || saved === 'en') return saved;
          // Primeira visita: detecta navegador. Tudo que NÃO começa com 'pt' vira 'en'.
          const nav = (navigator.language || 'pt').toLowerCase();
          return nav.startsWith('pt') ? 'pt' : 'en';
        } catch (e) { return 'pt'; }
      })();
      document.documentElement.lang = window.__COZY_LANG === 'en' ? 'en' : 'pt-br';
      window.__cozyT = function (key, values) {
        const lang = window.__COZY_LANG;
        const dicts = window.__COZY_I18N;
        function get(dict, path) {
          const parts = path.split('.');
          let cur = dict;
          for (const p of parts) {
            if (cur && typeof cur === 'object' && p in cur) cur = cur[p];
            else return null;
          }
          return typeof cur === 'string' ? cur : null;
        }
        let value = get(dicts[lang], key) || get(dicts.pt, key) || key;
        if (values) {
          value = value.replace(/\{(\w+)\}/g, function (m, k) {
            return k in values ? values[k] : '{' + k + '}';
          });
        }
        return value;
      };
      // Aplica traduções em data-t / data-t-attr quando DOM carrega
      window.__cozyApplyI18n = function (root) {
        root = root || document;
        root.querySelectorAll('[data-t]').forEach(function (el) {
          const key = el.getAttribute('data-t');
          el.textContent = window.__cozyT(key);
        });
        // data-t-attr="alt:meta.no_recipes_yet,placeholder:search.placeholder"
        root.querySelectorAll('[data-t-attr]').forEach(function (el) {
          const spec = el.getAttribute('data-t-attr');
          spec.split(',').forEach(function (pair) {
            const idx = pair.indexOf(':');
            if (idx < 0) return;
            const attr = pair.slice(0, idx).trim();
            const key = pair.slice(idx + 1).trim();
            el.setAttribute(attr, window.__cozyT(key));
          });
        });
      };
      // Roda assim que body existe
      document.addEventListener('DOMContentLoaded', function () {
        window.__cozyApplyI18n();
      });
    </script>
    <style>
      /* pre-dark é aplicado no html pelo script inline acima.
         Quando o body é criado, JS migra pra body.dark-mode.
         Aqui só garantimos o bg correto enquanto isso acontece. */
      /* Cor de fundo explícita no html — garante que iOS Safari pegue
         a cor certa pra status bar/URL bar (sampling do topo do paint). */
      html { background: #FAF6EE; }
      html.pre-dark { background: #0F1A2A; }
      html.pre-dark body { background: #0F1A2A; color: #F5F0E5; }
      /* Em visitas recorrentes (cozinha já alcançada), esconde o
         intro-cover navy antes mesmo do paint — evita iOS samplear
         navy pra barra de URL. */
      html.cozy-kitchen-locked .intro-cover { display: none !important; }
    </style>

    <!-- Cloudflare Web Analytics — privacidade-first, sem cookies.
         Dashboard: https://dash.cloudflare.com → Web Analytics → cozy-corner.
         Coleta pageviews, top pages, países, dispositivos. `defer` garante
         que não bloqueia render. -->
    <script defer src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token": "aa58183c6ae147a5b02d3e2b7ae7dbab"}'></script>
  </head>
  <body>
    <script is:inline>
      // Migra a flag do html pro body
      if (document.documentElement.classList.contains('pre-dark')) {
        document.body.classList.add('dark-mode');
        document.documentElement.classList.remove('pre-dark');
      }
    </script>

    <!-- Overlay de transição entre páginas (cream warm, fade) -->
    <div class="cozy-fade" id="cozy-fade" aria-hidden="true"></div>

    <!-- Toggle de idioma — pequeno pill no canto superior direito -->
    <button class="lang-toggle" id="lang-toggle" type="button" aria-label="alternar idioma">
      <span class="lang-pt">PT</span>
      <span class="lang-sep">·</span>
      <span class="lang-en">EN</span>
    </button>

    <slot />

    <script is:inline>
      // Sistema de transição entre páginas. Uso:
      //   window.cozyNavigate('/url')  — fade-out e navega.
      // Receiving page: se sessionStorage tem 'cozy-fade-in', o overlay
      // já começa visível (script no <head>) e some no load.
      (function () {
        const overlay = document.getElementById('cozy-fade');
        if (!overlay) return;

        // Fade-in (chegando): o overlay começa visível pelo CSS, vamos
        // disparar a animação pra ele sumir.
        if (document.documentElement.classList.contains('cozy-fading-in')) {
          requestAnimationFrame(function () {
            requestAnimationFrame(function () {
              overlay.classList.add('is-leaving');
              setTimeout(function () {
                document.documentElement.classList.remove('cozy-fading-in');
                overlay.classList.remove('is-leaving');
              }, 600);
            });
          });
        }

        // bfcache fix: quando o user usa o botão "voltar" do navegador,
        // a página é restaurada do cache no estado em que estava (overlay
        // opaco, porque a gente acabou de clicar num link). Precisamos
        // resetar o overlay quando isso acontece.
        window.addEventListener('pageshow', function (e) {
          // `persisted` é true quando vem do bfcache. Mesmo se for false,
          // resetar é seguro — overlay nunca deve ficar visível "por si só".
          overlay.classList.remove('is-entering', 'is-leaving');
          document.documentElement.classList.remove('cozy-fading-in');
          // Também limpa o flag de sessionStorage pra não disparar fade-in
          // numa próxima navegação que não seja via cozyNavigate.
          try { sessionStorage.removeItem('cozy-fade-in'); } catch (err) {}
          // Re-sincroniza dark mode com localStorage. Em bfcache (Safari
          // back/forward), o body é restaurado no estado em que estava
          // quando a página foi unload-ada — se o user mudou o dark mode
          // em outra página, esse estado é stale. Sincroniza manualmente.
          try {
            var isDark = localStorage.getItem('cozy-dark-mode') === 'true';
            var hasDark = document.body.classList.contains('dark-mode');
            if (isDark !== hasDark) {
              document.body.classList.toggle('dark-mode', isDark);
            }
          } catch (err) {}
          // Mesmo problema com idioma: bfcache restaura __COZY_LANG e
          // html.lang antigos. Se user trocou idioma em outra página,
          // sincroniza aqui.
          try {
            var savedLang = localStorage.getItem('cozy-lang');
            if (savedLang === 'pt' || savedLang === 'en') {
              if (window.__COZY_LANG !== savedLang) {
                window.__COZY_LANG = savedLang;
                document.documentElement.lang = savedLang === 'en' ? 'en' : 'pt-br';
                // Aplica i18n nos elementos com data-t
                if (window.__cozyApplyI18n) window.__cozyApplyI18n();
                // Atualiza visual do toggle e notifica páginas dependentes
                var langBtn = document.getElementById('lang-toggle');
                if (langBtn) langBtn.classList.toggle('is-en', savedLang === 'en');
                document.dispatchEvent(new CustomEvent('cozy-lang-changed', { detail: { lang: savedLang } }));
              }
            }
          } catch (err) {}
        });

        // Fade-out (saindo): expõe helper global.
        window.cozyNavigate = function (url) {
          try { sessionStorage.setItem('cozy-fade-in', '1'); } catch (e) {}
          overlay.classList.add('is-entering');
          setTimeout(function () { window.location.href = url; }, 280);
        };

        // Intercepta TODOS os cliques em links internos por padrão.
        // Opt-out: data-no-fade no <a> (ex: âncoras, ações inline).
        document.addEventListener('click', function (e) {
          if (e.defaultPrevented) return;
          const target = e.target instanceof Element ? e.target : null;
          if (!target) return;
          const a = target.closest('a');
          if (!a) return;
          if (a.hasAttribute('data-no-fade')) return;
          if (a.target === '_blank' || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
          const href = a.getAttribute('href');
          if (!href) return;
          // Ignora âncoras, mailto, tel, javascript:, protocolos externos, downloads.
          if (href.startsWith('#') || href.startsWith('mailto:') || href.startsWith('tel:') || href.startsWith('javascript:')) return;
          if (a.hasAttribute('download')) return;
          // Só intercepta same-origin (links relativos ou do mesmo host).
          try {
            const url = new URL(href, window.location.href);
            if (url.origin !== window.location.origin) return;
            // Mesma URL exata (só hash mudou): deixa o browser tratar.
            if (url.pathname === window.location.pathname && url.search === window.location.search) return;
          } catch (_) { return; }
          e.preventDefault();
          window.cozyNavigate(href);
        });
      })();
    </script>

    <script is:inline>
      (function () {
        const btn = document.getElementById('lang-toggle');
        if (!btn) return;
        function syncBtn() {
          btn.classList.toggle('is-en', window.__COZY_LANG === 'en');
        }
        syncBtn();
        btn.addEventListener('click', function () {
          const next = window.__COZY_LANG === 'pt' ? 'en' : 'pt';
          window.__COZY_LANG = next;
          try { localStorage.setItem('cozy-lang', next); } catch (e) {}
          document.documentElement.lang = next === 'en' ? 'en' : 'pt-br';
          syncBtn();
          window.__cozyApplyI18n();
          // Notifica páginas que querem atualizar textos dinâmicos
          document.dispatchEvent(new CustomEvent('cozy-lang-changed', { detail: { lang: next } }));
        });
      })();
    </script>

    <style is:global>
      /* ============ TRANSIÇÃO ENTRE PÁGINAS ============
         Overlay cream que faz fade-in/out entre navegações opt-in.
         - Página de saída: .is-entering → fade IN (cobre tudo)
         - Página de chegada: html.cozy-fading-in → começa cobrindo,
           depois .is-leaving → fade OUT (revela conteúdo) */
      .cozy-fade {
        position: fixed;
        inset: 0;
        background: var(--bg);
        z-index: 9999;
        opacity: 0;
        pointer-events: none;
        transition: opacity 280ms ease-out;
      }
      .cozy-fade.is-entering {
        opacity: 1;
        pointer-events: auto;
      }
      /* Chegada: overlay já visível pelo class no html (set pelo inline script).
         Sem transição inicial — ele já tá em cima da tela quando o paint começa. */
      html.cozy-fading-in .cozy-fade {
        opacity: 1;
        pointer-events: auto;
        transition: none;
      }
      html.cozy-fading-in .cozy-fade.is-leaving {
        opacity: 0;
        transition: opacity 450ms ease-out;
      }

      .lang-toggle {
        position: fixed;
        top: 10px;          /* alinhado com dark-toggle: (header-h 56 - btn 36) / 2 */
        right: 16px;        /* default — home, sem header dark-toggle */
        z-index: 220;
        height: 36px;       /* mesmo height do dark-toggle */
        box-sizing: border-box;
        display: inline-flex;
        align-items: center;
        gap: 2px;
        padding: 0 4px;     /* tighter — as pílulas internas têm padding próprio */
        background: transparent;
        border: 1px solid var(--line);
        border-radius: 999px;
        font-family: var(--font-mono);
        font-size: 13px;
        letter-spacing: 0.04em;
        color: var(--ink-mute);
        cursor: pointer;
        opacity: 1;
        pointer-events: auto;
        /* Default = aparecendo: espera o drawer fechar (500ms) antes de fade-in */
        transition: opacity 200ms ease-out 500ms,
                    border-color 150ms,
                    color 150ms;
      }
      .lang-toggle:hover { border-color: var(--ink-soft); }
      /* Cada idioma vira uma pílula interna; a ativa preenche com --ink
         e texto em --bg (cream). Padrão de "switch segmentado" — não
         deixa dúvida sobre qual está selecionado. */
      .lang-toggle .lang-pt,
      .lang-toggle .lang-en {
        display: inline-flex;
        align-items: center;
        height: 26px;
        padding: 0 10px;
        border-radius: 999px;
        font-weight: 500;
        background: transparent;
        color: var(--ink-mute);
        transition: color 150ms, background 150ms;
      }
      /* Default (sem .is-en): PT é o ativo */
      .lang-toggle .lang-pt {
        background: var(--ink);
        color: var(--bg);
      }
      /* Com .is-en: troca a pílula preenchida pro EN */
      .lang-toggle.is-en .lang-pt {
        background: transparent;
        color: var(--ink-mute);
      }
      .lang-toggle.is-en .lang-en {
        background: var(--ink);
        color: var(--bg);
      }
      /* Separador deixou de fazer sentido — as pílulas dão a separação */
      .lang-toggle .lang-sep { display: none; }
      /* Quando a página tem dark-toggle no header (receita, categoria, busca),
         desloca o lang-toggle pra esquerda pra não sobrepor.
         Dark-toggle: right edge a 24px (header padding s-6), width 36 →
         left edge a 60px. Lang-toggle right edge = 60 + 24 (gap) = 84px. */
      body:has(.dark-toggle) .lang-toggle {
        right: 84px;
      }
      /* Em mobile e no intro/loading, esconde */
      @media (max-width: 600px) {
        .lang-toggle { right: 12px; padding: 0 12px; font-size: 14px; }
        /* Mantém 36px de height (alinhado com .dark-toggle) e top 10px
           (centrado no header de 56px).
           Em mobile o header tem padding reduzido pra var(--s-4)=16px
           (override nos arquivos das páginas com .dark-toggle). */
        body:has(.dark-toggle) .lang-toggle {
          right: calc(var(--s-4) + 36px + 12px);  /* header padding (16) + dark-toggle (36) + gap (12) = 64px */
        }
      }
      /* Esconde durante intro, drawer aberto, cooking mode e print.
         Transition rápida e SEM delay quando esconde (sai instantâneo).
         Volta a aparecer só depois que o drawer fecha (delay 500ms no default). */
      body.intro-active .lang-toggle,
      body.drawer-open .lang-toggle,
      body.cm-open .lang-toggle {
        opacity: 0;
        pointer-events: none;
        transition: opacity 120ms ease-in;
      }
      @media print {
        .lang-toggle { display: none; }
      }
    </style>
  </body>
</html>
